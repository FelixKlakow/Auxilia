<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Label="Packaging">
        <PackageId>Auxilia.Core.Client</PackageId>
        <Version>0.2.0</Version>
        <Authors>Felix Klakow</Authors>
        <Description>Typed HTTP client for the entire Auxilia Core API: dispatch and observe runs (SSE), manage configurations and connectors, consume artifacts (query, download, filtered event stream), administer identity — the supported way for any application to drive the Core.</Description>
        <RepositoryUrl>https://github.com/FelixKlakow/Auxilia</RepositoryUrl>
        <PackageProjectUrl>https://github.com/FelixKlakow/Auxilia</PackageProjectUrl>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>auxilia;workflow;client;sse</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Auxilia.Core.Contracts\Auxilia.Core.Contracts.csproj" />
    </ItemGroup>

</Project>
