<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Label="Packaging">
        <PackageId>Auxilia.Messaging</PackageId>
        <Version>0.4.0</Version>
        <Authors>Felix Klakow</Authors>
        <Description>The Auxilia message-bus abstraction (IMessageBusClient) with its RabbitMQ implementation and an injectable fake for tests — the single path every Auxilia component uses to talk to the broker. Referenced by the workflow SDK; not needed by pure Core clients.</Description>
        <RepositoryUrl>https://github.com/FelixKlakow/Auxilia</RepositoryUrl>
        <PackageProjectUrl>https://github.com/FelixKlakow/Auxilia</PackageProjectUrl>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>auxilia;messaging;rabbitmq</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Auxilia.Messaging.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
        <PackageReference Include="OpenTelemetry.Api" Version="1.17.0" />
        <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    </ItemGroup>

</Project>
