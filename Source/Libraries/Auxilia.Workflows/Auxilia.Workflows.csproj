<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <PackageId>Auxilia.Workflows</PackageId>
    <Version>0.2.0</Version>
    <Authors>Felix Klakow</Authors>
    <Description>The Auxilia workflow SDK — author signed, stateful workflow programs that run in isolated containers: the WorkflowBuilder (declared inputs, outputs, views, companions, pod control, repositories, network endpoints), the typed run-input accessor, the runner handshake, and the bus-side messaging contracts. Everything a workflow binary needs; clients use Auxilia.Workflows.Client instead.</Description>
    <RepositoryUrl>https://github.com/FelixKlakow/Auxilia</RepositoryUrl>
    <PackageProjectUrl>https://github.com/FelixKlakow/Auxilia</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>auxilia;workflow;sdk;agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auxilia.AI\Auxilia.AI.csproj" />
    <ProjectReference Include="..\Auxilia.Messaging\Auxilia.Messaging.csproj" />
    <ProjectReference Include="..\Auxilia.Steering.Codec\Auxilia.Steering.Codec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Auxilia.Workflows.Tests" />
    <InternalsVisibleTo Include="Auxilia.Workflows.SlotPackages.Tests" />
  </ItemGroup>

</Project>
