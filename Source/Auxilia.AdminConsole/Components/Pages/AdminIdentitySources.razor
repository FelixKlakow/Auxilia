@page "/admin/identity-sources"
@attribute [Authorize]
@inject ICoreClient Core

<PageTitle>Identity sources — Auxilia</PageTitle>

<PageHeader Title="Identity sources"
            Subtitle="Import users from existing systems — an LDAP / Active Directory server or a CSV export — instead of creating principals by hand. Imported users sign in once an administrator sets credentials."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    @if (_notice is not null)
    {
        <div class="panel success">@_notice</div>
    }

    <section class="card">
        <div class="card-header">
            <h2>Configured sources</h2>
            <p class="card-subtitle">
                Imports are idempotent: re-running updates existing users in place; users missing
                from the source are at most disabled — never deleted.
            </p>
        </div>
        @if (_sources.Count == 0)
        {
            <div class="card-body"><p class="muted view-empty">No identity sources configured yet — create one below.</p></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Connector</th>
                    <th>Last import</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var source in _sources)
                {
                    <tr>
                        <td class="cell-strong">@source.Name</td>
                        <td>@ConnectorNameOf(source.ConnectorType)</td>
                        <td>
                            @if (source.LastImport is null)
                            {
                                <span class="muted">never run</span>
                            }
                            else
                            {
                                <span>@Summarize(source.LastImport)</span>
                                @if (source.LastImportUtc is { } when)
                                {
                                    <span class="muted"> · @TimeText.Relative(when)</span>
                                }
                            }
                        </td>
                        <td>
                            <div class="cell-actions">
                                <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                        @onclick="() => TestConnectionAsync(source)">Test connection</button>
                                <button class="btn btn-primary btn-sm" disabled="@_busy"
                                        @onclick="() => ImportNowAsync(source)">Import now</button>
                                <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                        @onclick="() => BeginEditAsync(source)">Edit</button>
                                @if (_confirmDeleteId == source.Id)
                                {
                                    <button class="btn btn-danger btn-sm" disabled="@_busy"
                                            @onclick="() => DeleteAsync(source)">Really delete?</button>
                                    <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                            @onclick="() => _confirmDeleteId = null">Keep</button>
                                }
                                else
                                {
                                    <button class="btn btn-danger btn-sm" disabled="@_busy"
                                            @onclick="() => _confirmDeleteId = source.Id">Delete</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="card">
        <div class="card-header">
            <h2>@(_draft.ExistingName is null ? "Add identity source" : $"Edit \"{_draft.ExistingName}\"")</h2>
            <p class="card-subtitle">
                Pick where the users live, then fill in the connection settings. Secret values are
                write-only — they are encrypted at rest and never displayed back.
            </p>
        </div>
        <div class="card-body">
            <div class="form-grid">
                <label>
                    Name
                    <input @bind="_draft.Name" disabled="@(_draft.ExistingName is not null)"
                           placeholder="e.g. Corporate Active Directory"/>
                    <span class="field-hint">Shown in the source list and in audit entries.</span>
                </label>
            </div>

            <div class="provider-grid">
                @foreach (var connector in _connectors)
                {
                    <label class="provider-card @(_draft.ConnectorType == connector.ConnectorType ? "selected" : null)">
                        <input type="radio" name="identity-connector"
                               checked="@(_draft.ConnectorType == connector.ConnectorType)"
                               @onchange="() => SelectConnector(connector)"/>
                        <span class="provider-name">@connector.DisplayName</span>
                        <span class="provider-category">@connector.Description</span>
                    </label>
                }
            </div>

            @if (SelectedConnector is { } selected)
            {
                <div class="form-grid setting-grid">
                    @foreach (var descriptor in selected.Settings)
                    {
                        <label>
                            @descriptor.Label@(descriptor.Required ? " *" : "")
                            @switch (descriptor.Kind)
                            {
                                case "Secret":
                                    <input type="password" autocomplete="new-password"
                                           @bind="_draft.Settings[descriptor.Key]"
                                           placeholder="@(_storedSecretKeys.Contains(descriptor.Key) ? "set — leave empty to keep unchanged" : "")"/>
                                    break;
                                case "Number":
                                    <input type="number" @bind="_draft.Settings[descriptor.Key]"/>
                                    break;
                                case "Boolean":
                                    <select @bind="_draft.Settings[descriptor.Key]">
                                        <option value="false">No</option>
                                        <option value="true">Yes</option>
                                    </select>
                                    break;
                                default:
                                    @if (descriptor.Multiline)
                                    {
                                        <textarea rows="8" @bind="_draft.Settings[descriptor.Key]"
                                                  placeholder="externalId,username,displayName,enabled,groups"></textarea>
                                    }
                                    else
                                    {
                                        <input @bind="_draft.Settings[descriptor.Key]"/>
                                    }
                                    break;
                            }
                            @if (descriptor.HelpText is { Length: > 0 } help)
                            {
                                <span class="field-hint">@help</span>
                            }
                        </label>
                    }
                </div>

                <h3 class="table-caption">Roles for imported users</h3>
                <div class="form-grid setting-grid">
                    <label>
                        Default role
                        <select @bind="_draft.DefaultRole">
                            <option value="">(none)</option>
                            @foreach (var role in BuiltInRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span class="field-hint">Assigned to every imported user. Imports only add roles — manually assigned roles are never removed.</span>
                    </label>
                    <label class="check-label">
                        <input type="checkbox" @bind="_draft.DisableMissing"/>
                        Disable users that disappear from the source
                        <span class="field-hint">Imports never delete principals; without this flag missing users keep their status.</span>
                    </label>
                </div>

                @foreach (var mapping in _mappingRows)
                {
                    <div class="cell-actions">
                        <input class="input-inline" placeholder="external group, e.g. Domain Admins"
                               @bind="mapping.Group"/>
                        <span class="muted">→</span>
                        <select class="select-inline" @bind="mapping.Role">
                            @foreach (var role in BuiltInRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <button class="btn btn-danger btn-sm" @onclick="() => _mappingRows.Remove(mapping)">✕</button>
                    </div>
                }
                <div class="button-row">
                    <button class="btn btn-secondary btn-sm" @onclick="AddMappingRow">+ Map a group to a role</button>
                </div>
            }

            <div class="button-row">
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
                    @(_draft.ExistingName is null ? "Create source" : "Save changes")
                </button>
                @if (_draft.ExistingName is not null)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="ResetDraft">Cancel</button>
                }
            </div>
        </div>
    </section>
}

@code {

    private static readonly string[] BuiltInRoles = ["Administrator", "Operator", "User", "Auditor"];

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private string? _error;
    private string? _notice;
    private Guid? _confirmDeleteId;

    private IReadOnlyList<IdentityConnectorDescriptorDto> _connectors = [];
    private IReadOnlyList<IdentitySourceDto> _sources = [];
    private Draft _draft = new();
    private HashSet<string> _storedSecretKeys = new(StringComparer.Ordinal);
    private readonly List<MappingRow> _mappingRows = [];

    private sealed class Draft
    {
        public string? ExistingName { get; set; }
        public string Name { get; set; } = "";
        public string ConnectorType { get; set; } = "";
        public Dictionary<string, string> Settings { get; } = new(StringComparer.Ordinal);
        public string DefaultRole { get; set; } = "";
        public bool DisableMissing { get; set; }
    }

    private sealed class MappingRow
    {
        public string Group { get; set; } = "";
        public string Role { get; set; } = "User";
    }

    private IdentityConnectorDescriptorDto? SelectedConnector
        => _connectors.FirstOrDefault(c => c.ConnectorType == _draft.ConnectorType);

    private string ConnectorNameOf(string connectorType)
        => _connectors.FirstOrDefault(c => c.ConnectorType == connectorType)?.DisplayName ?? connectorType;

    private static string Summarize(IdentityImportSummaryDto s)
        => $"{s.Created} created, {s.Updated} updated, {s.Disabled} disabled, {s.Skipped} skipped";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _connectors = await Core.ListIdentityConnectorsAsync();
            await LoadAsync();
            _denied = false;
            _error = null;
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    private async Task LoadAsync() => _sources = await Core.ListIdentitySourcesAsync();

    private void SelectConnector(IdentityConnectorDescriptorDto connector)
    {
        _draft.ConnectorType = connector.ConnectorType;
        EnsureSettingKeys(connector);
    }

    private void EnsureSettingKeys(IdentityConnectorDescriptorDto connector)
    {
        foreach (var descriptor in connector.Settings)
        {
            if (!_draft.Settings.ContainsKey(descriptor.Key))
                _draft.Settings[descriptor.Key] = descriptor.Kind == "Secret" ? "" : descriptor.DefaultValue ?? "";
        }
    }

    private async Task BeginEditAsync(IdentitySourceDto source)
    {
        var full = await Core.GetIdentitySourceAsync(source.Id) ?? source;
        _draft = new Draft
        {
            ExistingName = full.Name,
            Name = full.Name,
            ConnectorType = full.ConnectorType,
            DefaultRole = full.DefaultRole,
            DisableMissing = full.DisableMissing
        };
        foreach (var (key, value) in full.Settings)
            _draft.Settings[key] = value;
        _storedSecretKeys = full.StoredSecretKeys.ToHashSet(StringComparer.Ordinal);
        _mappingRows.Clear();
        foreach (var (group, role) in full.GroupRoleMappings)
            _mappingRows.Add(new MappingRow { Group = group, Role = role });
        if (SelectedConnector is { } connector)
            EnsureSettingKeys(connector);
        _notice = _error = null;
    }

    private void ResetDraft()
    {
        _draft = new Draft();
        _storedSecretKeys = new HashSet<string>(StringComparer.Ordinal);
        _mappingRows.Clear();
        _confirmDeleteId = null;
    }

    private void AddMappingRow() => _mappingRows.Add(new MappingRow());

    private Task SaveAsync()
        => MutateAsync(async () =>
        {
            var mappings = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var row in _mappingRows.Where(r => r.Group.Trim().Length > 0))
                mappings[row.Group.Trim()] = row.Role;

            var request = new SaveIdentitySourceRequest(
                Name: _draft.Name.Trim(),
                ConnectorType: _draft.ConnectorType,
                Settings: new Dictionary<string, string>(_draft.Settings, StringComparer.Ordinal),
                DefaultRole: _draft.DefaultRole,
                GroupRoleMappings: mappings,
                DisableMissing: _draft.DisableMissing,
                ExistingName: _draft.ExistingName);

            var saved = await Core.SaveIdentitySourceAsync(request);
            _notice = $"Identity source \"{saved.Name}\" saved.";
            ResetDraft();
        });

    private Task TestConnectionAsync(IdentitySourceDto source)
        => MutateAsync(async () =>
        {
            var result = await Core.TestIdentitySourceAsync(source.Id);
            if (result.Success)
                _notice = $"\"{source.Name}\": {result.Message}";
            else
                _error = $"\"{source.Name}\": {result.Message}";
        });

    private Task ImportNowAsync(IdentitySourceDto source)
        => MutateAsync(async () =>
        {
            var summary = await Core.ImportIdentitySourceAsync(source.Id);
            _notice = $"Import of \"{source.Name}\" finished: {Summarize(summary)}" +
                      (summary.Warnings.Count > 0 ? $" — {summary.Warnings.Count} warning(s)" : "");
        });

    private Task DeleteAsync(IdentitySourceDto source)
        => MutateAsync(async () =>
        {
            await Core.DeleteIdentitySourceAsync(source.Id);
            _notice = $"Identity source \"{source.Name}\" deleted. Previously imported users stay untouched.";
            _confirmDeleteId = null;
        });

    private async Task MutateAsync(Func<Task> action)
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (CoreApiException ex)
        {
            _error = (ex.ErrorDetail ?? ex.Message).Replace('\n', ' ');
        }
        finally
        {
            _busy = false;
        }
    }

}
