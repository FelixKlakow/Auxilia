@page "/connectors"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core

<PageTitle>Connectors — Auxilia</PageTitle>

<PageHeader Title="Connectors"
            Subtitle="Credential-bearing provider accounts Auxilia can act as. Secrets are encrypted at rest in the Core and never shown back."/>

<div class="panel">
    Guided OAuth sign-in flows are a follow-up. For now, paste or enter the token/secret directly —
    it is written once, encrypted, and only its setting keys are ever read back.
</div>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    @if (_notice is not null)
    {
        <div class="panel success">@_notice</div>
    }

    <div class="toolbar">
        <label>
            Provider type
            <input @bind="_providerFilter" placeholder="e.g. azure-devops" @bind:after="ApplyAsync"/>
        </label>
        <button class="btn btn-secondary" @onclick="RefreshAsync">Refresh</button>
        <button class="btn btn-primary" @onclick="StartCreate">New connector</button>
    </div>

    @if (_connectors.Count == 0)
    {
        <EmptyState Title="No connectors"
                    Description="Create a connector to give a workflow a provider credential to act as."/>
    }
    else
    {
        <div class="card">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Provider</th>
                    <th>Scope</th>
                    <th>Stored settings</th>
                    <th>Updated</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var connector in _connectors)
                {
                    <tr>
                        <td class="cell-strong">@connector.Name</td>
                        <td>@connector.ProviderType</td>
                        <td><span class="badge badge-state">@connector.Scope</span></td>
                        <td class="cell-mono">@(connector.SettingKeys.Count == 0 ? "—" : string.Join(", ", connector.SettingKeys))</td>
                        <td>@TimeText.Relative(connector.UpdatedUtc)</td>
                        <td>
                            <button class="btn btn-secondary btn-sm" @onclick="() => ShowDetailAsync(connector.Id)">Details</button>
                            @if (connector.Scope == ConnectorScope.Personal)
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => StartGrants(connector)">Grants</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (_skip + _connectors.Count < _total)
            {
                <div class="card-body table-more">
                    <button class="btn btn-secondary" @onclick="ShowMoreAsync">
                        Show more (@(_skip + _connectors.Count) of @_total)
                    </button>
                </div>
            }
        </div>
    }

    @if (_detail is { } detail)
    {
        <section class="card">
            <div class="card-header">
                <h2>@detail.Name</h2>
                <div class="card-actions">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _detail = null">Close</button>
                </div>
            </div>
            <dl class="card-body meta-grid">
                <div><dt>Provider</dt><dd>@detail.ProviderType</dd></div>
                <div><dt>Scope</dt><dd>@detail.Scope</dd></div>
                <div>
                    <dt>Stored setting keys</dt>
                    <dd class="cell-mono">@(detail.SettingKeys.Count == 0 ? "— (no settings)" : string.Join(", ", detail.SettingKeys))</dd>
                </div>
                @if (detail.Grants is { Count: > 0 } grants)
                {
                    <div>
                        <dt>Grants</dt>
                        <dd>@string.Join(", ", grants.Select(g => $"{g.Kind}:{g.Id}"))</dd>
                    </div>
                }
            </dl>
        </section>
    }

    @if (_draft is { } draft)
    {
        <section class="card">
            <div class="card-header">
                <h2>New connector</h2>
                <p class="card-subtitle">The credential is encrypted at rest and never returned by any read.</p>
            </div>
            <div class="card-body">
                <div class="form-grid">
                    <label>
                        Name
                        <input @bind="draft.Name" placeholder="e.g. Team Azure DevOps"/>
                    </label>
                    <label>
                        Provider type
                        <input @bind="draft.ProviderType" list="provider-types" placeholder="e.g. azure-devops"
                               @bind:after="SeedFromCatalog"/>
                        <datalist id="provider-types">
                            @foreach (var provider in _catalog)
                            {
                                <option value="@provider.ProviderType"></option>
                            }
                        </datalist>
                    </label>
                    <label>
                        Scope
                        <select @bind="draft.Scope">
                            <option value="@ConnectorScope.Company">Company — any authenticated principal</option>
                            <option value="@ConnectorScope.Personal">Personal — you and granted principals</option>
                        </select>
                    </label>
                </div>

                <div class="setting-grid form-grid">
                    @foreach (var field in draft.Fields)
                    {
                        <label>
                            @(field.Label is { Length: > 0 } ? field.Label : field.Key)
                            @if (field.Secret)
                            {
                                <span class="badge badge-secret">secret</span>
                            }
                            @if (field.Secret)
                            {
                                <input type="password" @bind="field.Value" placeholder="@(field.Required ? "required" : "")"/>
                            }
                            else
                            {
                                <input @bind="field.Value" placeholder="@(field.Required ? "required" : "")"/>
                            }
                            @if (field.Help is { Length: > 0 })
                            {
                                <span class="field-hint">@field.Help</span>
                            }
                        </label>
                    }
                </div>

                <div class="button-row editor-actions">
                    <button class="btn btn-secondary btn-sm" @onclick="AddField">Add setting</button>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync">Create connector</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _draft = null">Cancel</button>
                </div>
            </div>
        </section>
    }

    @if (_grants is { } panel)
    {
        <section class="card">
            <div class="card-header">
                <h2>Grants — @panel.ConnectorName</h2>
                <p class="card-subtitle">Admit principals or directory groups to this personal connector.</p>
            </div>
            <div class="card-body">
                @foreach (var grant in panel.Grants)
                {
                    <div class="card-row">
                        <select @bind="grant.Kind">
                            <option value="@ConnectorGrantKind.Principal">Principal</option>
                            <option value="@ConnectorGrantKind.DirectoryGroup">Directory group</option>
                        </select>
                        <input @bind="grant.Id" placeholder="principal id / group object id"/>
                        <button class="btn btn-danger btn-sm" @onclick="() => panel.Grants.Remove(grant)">Remove</button>
                    </div>
                }
                <div class="button-row editor-actions">
                    <button class="btn btn-secondary btn-sm" @onclick="() => panel.Grants.Add(new GrantRow())">Add grant</button>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SaveGrantsAsync">Save grants</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _grants = null">Cancel</button>
                </div>
            </div>
        </section>
    }
}

@code {

    private const int PageSize = 50;

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private string _providerFilter = "";

    private int _skip;
    private int _total;
    private List<Connector> _connectors = [];
    private List<ProviderCatalogEntry> _catalog = [];

    private Connector? _detail;
    private ConnectorDraft? _draft;
    private GrantsDraft? _grants;

    private readonly CancellationTokenSource _cts = new();

    private sealed class ConnectorDraft
    {
        public string Name = "";
        public string ProviderType = "";
        public string Scope = ConnectorScope.Company;
        public List<SettingField> Fields = [];
    }

    private sealed class SettingField
    {
        public string Key = "";
        public string Label = "";
        public bool Secret;
        public bool Required;
        public string? Help;
        public string Value = "";
    }

    private sealed class GrantsDraft
    {
        public Guid ConnectorId;
        public string ConnectorName = "";
        public List<GrantRow> Grants = [];
    }

    private sealed class GrantRow
    {
        public string Kind { get; set; } = ConnectorGrantKind.Principal;
        public string Id { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync();
        await LoadAsync(reset: true);
    }

    private Task ApplyAsync() => LoadAsync(reset: true);
    private Task RefreshAsync() => LoadAsync(reset: true);
    private Task ShowMoreAsync() => LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        if (reset)
        {
            _skip = 0;
            _connectors = [];
        }

        var query = new ConnectorQuery(
            ProviderType: string.IsNullOrWhiteSpace(_providerFilter) ? null : _providerFilter.Trim(),
            Skip: _skip,
            Take: PageSize);

        try
        {
            var page = await Core.QueryConnectorsAsync(query, _cts.Token);
            _denied = false;
            _error = null;
            _total = page.Total;
            _connectors.AddRange(page.Items);
            _skip += page.Items.Count;
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    /// <summary>Best-effort: the create form is descriptor-driven when the catalog is readable.</summary>
    private async Task LoadCatalogAsync()
    {
        try
        {
            var page = await Core.QueryProviderCatalogAsync(new ProviderCatalogQuery(Take: 200), _cts.Token);
            _catalog = page.Items.ToList();
        }
        catch (CoreApiException)
        {
            _catalog = [];
        }
    }

    private async Task ShowDetailAsync(Guid id)
    {
        _error = null;
        try
        {
            _detail = await Core.GetConnectorAsync(id, _cts.Token);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
    }

    private void StartCreate()
    {
        _error = _notice = null;
        _detail = null;
        _grants = null;
        _draft = new ConnectorDraft();
    }

    /// <summary>Prefill the settings from the catalog descriptor when the typed provider is known.</summary>
    private void SeedFromCatalog()
    {
        if (_draft is null)
            return;
        var entry = _catalog.FirstOrDefault(p =>
            string.Equals(p.ProviderType, _draft.ProviderType, StringComparison.OrdinalIgnoreCase));
        if (entry is null)
            return;
        _draft.Fields = entry.Descriptors
            .Where(d => !d.Disabled)
            .Select(d => new SettingField
            {
                Key = d.Key,
                Label = d.Label,
                Secret = string.Equals(d.Kind, "Secret", StringComparison.OrdinalIgnoreCase),
                Required = d.Required,
                Help = d.HelpText,
                Value = d.DefaultValue ?? ""
            })
            .ToList();
    }

    private void AddField() => _draft?.Fields.Add(new SettingField { Secret = true });

    private async Task CreateAsync()
    {
        if (_draft is null)
            return;
        _error = _notice = null;
        _busy = true;
        try
        {
            var settings = _draft.Fields
                .Where(f => f.Key.Length > 0)
                .ToDictionary(f => f.Key, f => f.Value, StringComparer.Ordinal);
            var created = await Core.CreateConnectorAsync(
                new CreateConnector(_draft.Name, _draft.ProviderType, settings, _draft.Scope), _cts.Token);
            _notice = $"Connector \"{created.Name}\" created.";
            _draft = null;
            await LoadAsync(reset: true);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartGrants(Connector connector)
    {
        _error = _notice = null;
        _detail = null;
        _draft = null;
        _grants = new GrantsDraft
        {
            ConnectorId = connector.Id,
            ConnectorName = connector.Name,
            Grants = (connector.Grants ?? [])
                .Select(g => new GrantRow { Kind = g.Kind, Id = g.Id })
                .ToList()
        };
    }

    private async Task SaveGrantsAsync()
    {
        if (_grants is null)
            return;
        _error = _notice = null;
        _busy = true;
        try
        {
            var grants = _grants.Grants
                .Where(g => g.Id.Length > 0)
                .Select(g => new ConnectorGrant(g.Kind, g.Id))
                .ToList();
            await Core.SetConnectorGrantsAsync(_grants.ConnectorId, new SetConnectorGrants(grants), _cts.Token);
            _notice = $"Grants for \"{_grants.ConnectorName}\" saved.";
            _grants = null;
            await LoadAsync(reset: true);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}
