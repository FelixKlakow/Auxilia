<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.1.0</Version>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <InformationalVersion>0.1.0</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BlazorAgentView" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pure Core.Client consumer: talks ONLY to Core.Api. No platform-data / governance /
             messaging references, no hosted services. -->
        <ProjectReference Include="..\..\Auxilia.Core.Client\Auxilia.Core.Client.csproj" />
        <ProjectReference Include="..\..\Auxilia.Core.Contracts\Auxilia.Core.Contracts.csproj" />
        <ProjectReference Include="..\..\Auxilia.Workflows\Auxilia.Workflows.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Auxilia.AdminConsole.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
