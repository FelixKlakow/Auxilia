<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Auxilia.Slots.GitHubCopilot.slothandler</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- GHCP001: the SDK marks its Rpc result types experimental; we accept the contract risk. -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
    <!-- Plugins ship their NuGet closure into the container (manifest BundleDependencies). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="*.slothandler.manifest.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Auxilia.Workflows\Auxilia.Workflows.csproj" />
    <ProjectReference Include="..\..\Libraries\Auxilia.Workflows.AiAgent\Auxilia.Workflows.AiAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Auxilia.Slots.GitHubCopilot.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
