@page "/runs"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core
@inject NavigationManager Navigation
@inject ILogger<Runs> Logger

<PageTitle>Runs — Auxilia</PageTitle>

<PageHeader Title="Runs" Subtitle="Every workflow execution on this platform, newest first."
            Freshness="_poller?.LastSuccessUtc"/>

<ConnectionBanner Connected="@(_poller?.IsHealthy ?? true)"
                  Detail="@_poller?.LastError"
                  LastUpdatedUtc="_poller?.LastSuccessUtc"/>

@if (!_loaded)
{
    <LoadingState Rows="8"/>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    <NoticePanel Message="@_notice" OnDismiss="() => _notice = null"/>

    <div class="chip-bar" role="group" aria-label="Filter runs by state">
        @foreach (var state in StateOptions())
        {
            <button class="chip @(_stateFilter == state ? "active" : null)"
                    aria-pressed="@(_stateFilter == state ? "true" : "false")"
                    @onclick="() => ApplyStateAsync(state)">
                @state
                @if (CountOf(state) is { } count)
                {
                    <span class="chip-count">@count</span>
                }
            </button>
        }
        <input class="chip-search" placeholder="Workflow type (exact) …" aria-label="Filter by workflow type"
               @bind="_workflowType" @bind:after="ApplyAsync"/>
        @if (HasFilters)
        {
            <button class="btn btn-secondary btn-sm" @onclick="ClearFiltersAsync">Clear filters</button>
        }
        <button class="btn btn-secondary btn-sm" @onclick="RefreshAsync">Refresh</button>
    </div>

    @* Auto-refresh resets to page 1, which would silently throw away everything the reader paged
       in. Past the first page the poll pauses and offers the refresh explicitly instead. *@
    @if (_paused)
    {
        <div class="panel info">
            <span class="panel-head">
                Auto-refresh paused while you browse older runs.
                <button class="btn btn-secondary btn-sm panel-dismiss" @onclick="ResumeAsync">Resume &amp; refresh</button>
            </span>
        </div>
    }

    @if (_runs.Count == 0)
    {
        @if (HasFilters)
        {
            <EmptyState Title="No runs match these filters"
                        Description="No workflow execution matches the selected state or workflow type.">
                <div class="empty-actions">
                    <button class="btn btn-secondary" @onclick="ClearFiltersAsync">Clear filters</button>
                </div>
            </EmptyState>
        }
        else
        {
            <EmptyState Title="No workflow runs"
                        Description="Runs appear here as soon as a task source, schedule, or trigger dispatches a workflow."/>
        }
    }
    else
    {
        <div class="card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>State</th>
                        <th>Workflow</th>
                        <th>Configuration</th>
                        <th>Started</th>
                        <th>Error</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in _runs)
                    {
                        <tr>
                            <td><span class="badge badge-state @StateBadge.ClassFor(run.State)">@run.State</span></td>
                            <td>
                                <a href="runs/@run.RunId" class="cell-strong">@run.WorkflowType</a>
                                <span class="cell-sub mono">@ShortId(run.RunId)</span>
                            </td>
                            <td>@ConfigurationLabel(run)</td>
                            <td>
                                @TimeText.Relative(run.CreatedUtc)
                                <span class="cell-sub">@run.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                            </td>
                            <td class="error-cell">@run.Error</td>
                            <td>
                                @if (LiveNow.IsActive(run.State))
                                {
                                    <ConfirmButton Label="Cancel" Question="Cancel this run?" ConfirmLabel="Cancel run"
                                                   CancelLabel="Keep running" Busy="_busy"
                                                   OnConfirm="() => CancelAsync(run.RunId)"/>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (_runs.Count < _total)
            {
                <div class="card-body table-more">
                    <button class="btn btn-secondary" disabled="@_loadingMore" @onclick="ShowMoreAsync">
                        @(_loadingMore ? "Loading…" : $"Show more ({_runs.Count} of {_total})")
                    </button>
                </div>
            }
        </div>
    }
}

@code {

    // Seed vocabulary; the live chip list is the union of these and whatever states the Core
    // actually reports (run states are runtime-extensible — never a compiled enum).
    private static readonly string[] SeedStates =
        ["Running", "Queued", "Success", "Failed", "Cancelled"];

    private const string AllStates = "All";

    private const int PageSize = 50;

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private bool _loadingMore;
    private string? _error;
    private string? _notice;

    private string _stateFilter = AllStates;
    private string _workflowType = "";

    private int _total;
    private RunStats? _stats;
    private List<RunStatus> _runs = [];
    private readonly Dictionary<Guid, string> _configurationNames = new();

    /// <summary>True once the reader pages past the first page — see the poller guard below.</summary>
    private bool _paused;

    private readonly CancellationTokenSource _cts = new();
    private PagePoller? _poller;

    private bool HasFilters => _stateFilter != AllStates || _workflowType.Length > 0;

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    /// <summary>Chip vocabulary: the Core's own state histogram, unioned with the common seeds.</summary>
    private IEnumerable<string> StateOptions()
        => new[] { AllStates }
            .Concat(SeedStates.Concat(_stats?.ByState.Keys ?? []).Distinct(StringComparer.Ordinal).OrderBy(s => s, StringComparer.Ordinal))
            .Append(_stateFilter)
            .Distinct(StringComparer.Ordinal);

    private int? CountOf(string state)
        => state == AllStates ? _stats?.Total : _stats?.ByState.GetValueOrDefault(state);

    private string ConfigurationLabel(RunStatus run)
    {
        if (run.ConfigurationName is { Length: > 0 } name)
            return name;
        if (run.ConfigurationId is { } id)
            return _configurationNames.TryGetValue(id, out var resolved) ? resolved : ShortId(id);
        return "—";
    }

    protected override async Task OnInitializedAsync()
    {
        _stateFilter = PageFilters.Read(Navigation, "state") is { Length: > 0 } state ? state : AllStates;
        _workflowType = PageFilters.Read(Navigation, "workflowType");
        try
        {
            await LoadAsync(reset: true);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Core unreachable during prerender — the poller keeps retrying and the banner shows.
            _error = ex.Message;
            _loaded = true;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _poller is not null || _denied)
            return;
        // A PagePoller instead of a raw timer loop: a transport exception (Core restart) must
        // never kill the polling permanently — it flips the banner and keeps retrying.
        _poller = new PagePoller(TimeSpan.FromSeconds(5), PollAsync, Logger);
        _poller.StateChanged += () => _ = InvokeAsync(StateHasChanged);
        _poller.Start();
    }

    /// <summary>
    /// The poll tick. A reset-refresh would discard every page the reader loaded with "Show more",
    /// so while paged in it does nothing but keep the transport health current.
    /// </summary>
    private async Task PollAsync(CancellationToken ct)
    {
        if (_paused)
        {
            await Core.GetRunStatsAsync(ct);
            return;
        }
        await LoadAsync(reset: true);
    }

    private Task ApplyStateAsync(string state)
    {
        _stateFilter = state;
        return ApplyAsync();
    }

    private Task ApplyAsync()
    {
        PageFilters.Apply(Navigation, new Dictionary<string, string?>
        {
            ["state"] = _stateFilter == AllStates ? null : _stateFilter,
            ["workflowType"] = _workflowType
        });
        _paused = false;
        return LoadAsync(reset: true);
    }

    private Task ClearFiltersAsync()
    {
        _stateFilter = AllStates;
        _workflowType = "";
        return ApplyAsync();
    }

    private Task RefreshAsync()
    {
        _paused = false;
        return LoadAsync(reset: true);
    }

    private Task ResumeAsync() => RefreshAsync();

    private async Task ShowMoreAsync()
    {
        _loadingMore = true;
        try
        {
            // Paging and a 5-second reset-poll cannot coexist: pause until the reader says otherwise.
            _paused = true;
            await LoadAsync(reset: false);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task LoadAsync(bool reset)
    {
        var skip = reset ? 0 : _runs.Count;
        var query = new RunQuery(
            State: _stateFilter == AllStates ? null : _stateFilter,
            WorkflowType: string.IsNullOrWhiteSpace(_workflowType) ? null : _workflowType.Trim(),
            Skip: skip,
            Take: PageSize);

        try
        {
            // Query FIRST, mutate on success — a failing refresh keeps the stale table rendered
            // (behind the connection banner) instead of blanking the page.
            var page = await Core.QueryRunsAsync(query, _cts.Token);
            _denied = false;
            _error = null;
            _total = page.Total;
            if (reset)
                _runs = page.Items.ToList();
            else
                _runs.AddRange(page.Items);
            _stats = await Core.GetRunStatsAsync(_cts.Token);
            await ResolveConfigurationNamesAsync();
        }
        catch (CoreApiException ex)
        {
            // Page semantics stay here; raw transport exceptions bubble to the PagePoller.
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    /// <summary>Fill in names for runs that carry only a configuration id (cheap, cached, best-effort).</summary>
    private async Task ResolveConfigurationNamesAsync()
    {
        var pending = _runs
            .Where(r => r.ConfigurationName is null or "")
            .Select(r => r.ConfigurationId)
            .OfType<Guid>()
            .Distinct()
            .Where(id => !_configurationNames.ContainsKey(id))
            .ToList();

        foreach (var id in pending)
        {
            try
            {
                if (await Core.GetConfigurationAsync(id, _cts.Token) is { } configuration)
                    _configurationNames[id] = configuration.Name;
            }
            catch (CoreApiException)
            {
                // Not readable (deleted / not permitted): fall back to showing the id.
            }
        }
    }

    private async Task CancelAsync(Guid runId)
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            await Core.CancelRunAsync(runId, _cts.Token);
            _notice = $"Cancellation of {ShortId(runId)} requested — the state flips once the workflow acknowledges.";
            await LoadAsync(reset: true);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _poller?.Dispose();
    }

}
