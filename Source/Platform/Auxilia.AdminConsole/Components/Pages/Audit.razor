@page "/audit"
@attribute [Authorize]
@inject ICoreClient Core
@inject NavigationManager Navigation

<PageTitle>Audit — Auxilia</PageTitle>

<PageHeader Title="Audit log"
            Subtitle="Every policy decision and administrative change, newest first. Entries are immutable."/>

@if (!_loaded)
{
    <LoadingState Rows="8"/>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else if (_error is { Length: > 0 })
{
    <div class="panel denied">Could not load the audit log: @_error</div>
}
else
{
    @* A real form: Enter in any field applies, and the whole filter set lives in the URL so an
       audit view can be pasted to someone else. *@
    <form class="toolbar audit-toolbar" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
        <label>
            Actor
            <input @bind="_actor" @bind:event="oninput" placeholder="principal id / service"/>
        </label>
        <label>
            Action
            <input @bind="_action" @bind:event="oninput" placeholder="e.g. policy.allowed"/>
        </label>
        <label>
            Subject
            <input @bind="_subject" @bind:event="oninput" placeholder="resource"/>
        </label>
        <label>
            From
            <input type="date" @bind="_from"/>
        </label>
        <label>
            To
            <input type="date" @bind="_to"/>
        </label>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-primary">Apply</button>
            @if (HasFilters)
            {
                <button type="button" class="btn btn-secondary" @onclick="ClearFiltersAsync">Clear filters</button>
            }
        </div>
    </form>

    @if (_entries.Count == 0)
    {
        @if (HasFilters)
        {
            <EmptyState Title="No audit entries match these filters"
                        Description="No policy decision or administrative change matches the current actor, action, subject, or date range.">
                <div class="empty-actions">
                    <button class="btn btn-secondary" @onclick="ClearFiltersAsync">Clear filters</button>
                </div>
            </EmptyState>
        }
        else
        {
            <EmptyState Title="No audit entries"
                        Description="Policy decisions and administrative changes appear here as they happen."/>
        }
    }
    else
    {
        <div class="card">
            <div class="table-scroll">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Subject</th>
                    <th>Outcome</th>
                    <th>Details</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td>
                            @TimeText.Relative(entry.TimestampUtc)
                            <span class="cell-sub">@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                        </td>
                        <td><span class="cell-truncate" title="@entry.Actor">@DisplayActor(entry.Actor)</span></td>
                        <td class="cell-strong">@entry.Action</td>
                        <td><span class="cell-mono cell-truncate" title="@entry.Subject">@entry.Subject</span></td>
                        <td>@entry.Outcome</td>
                        <td><span class="cell-mono cell-truncate" title="@entry.DetailJson">@entry.DetailJson</span></td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            @if (_skip + _entries.Count < _total)
            {
                <div class="card-body table-more">
                    <button class="btn btn-secondary" disabled="@_loadingMore" @onclick="ShowMoreAsync">
                        @(_loadingMore ? "Loading…" : $"Show more ({_skip + _entries.Count} of {_total})")
                    </button>
                </div>
            }
        </div>
    }
}

@code {

    private const int PageSize = 100;

    private bool _loaded;
    private bool _denied;
    private bool _loadingMore;
    private string? _error;

    private string _actor = "";
    private string _action = "";
    private string _subject = "";
    private DateTime? _from;
    private DateTime? _to;

    private int _skip;
    private int _total;
    private List<AuditEntry> _entries = [];

    private bool HasFilters
        => _actor.Length > 0 || _action.Length > 0 || _subject.Length > 0 || _from is not null || _to is not null;

    protected override Task OnInitializedAsync()
    {
        _actor = PageFilters.Read(Navigation, "actor");
        _action = PageFilters.Read(Navigation, "action");
        _subject = PageFilters.Read(Navigation, "subject");
        _from = PageFilters.ReadDate(Navigation, "from");
        _to = PageFilters.ReadDate(Navigation, "to");
        return LoadAsync(reset: true);
    }

    private Task ApplyAsync()
    {
        PageFilters.Apply(Navigation, new Dictionary<string, string?>
        {
            ["actor"] = _actor,
            ["action"] = _action,
            ["subject"] = _subject,
            ["from"] = _from?.ToString("yyyy-MM-dd"),
            ["to"] = _to?.ToString("yyyy-MM-dd")
        });
        return LoadAsync(reset: true);
    }

    private Task ClearFiltersAsync()
    {
        _actor = _action = _subject = "";
        _from = _to = null;
        return ApplyAsync();
    }

    private async Task ShowMoreAsync()
    {
        _loadingMore = true;
        try
        {
            await LoadAsync(reset: false);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task LoadAsync(bool reset)
    {
        if (reset)
        {
            _skip = 0;
            _entries = [];
        }

        var query = new AuditQuery(
            Actor: Empty(_actor),
            Action: Empty(_action),
            Subject: Empty(_subject),
            FromUtc: _from is { } f ? new DateTimeOffset(f, TimeSpan.Zero) : null,
            ToUtc: _to is { } t ? new DateTimeOffset(t.AddDays(1), TimeSpan.Zero) : null,
            Skip: _skip,
            Take: PageSize);

        try
        {
            var page = await Core.QueryAuditAsync(query);
            _denied = false;
            _error = null;
            _total = page.Total;
            _entries.AddRange(page.Items);
            _skip += page.Items.Count;
            await ResolveActorNamesAsync(page.Items);
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    private static string? Empty(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    // Actor → resolved display name; null marks a lookup that found nothing (raw id stays shown).
    private readonly Dictionary<string, string?> _actorNames = new(StringComparer.OrdinalIgnoreCase);

    private string DisplayActor(string actor) => _actorNames.GetValueOrDefault(actor) ?? actor;

    /// <summary>
    /// Resolves GUID actors to principal display names, one lookup per distinct actor. A failed or
    /// unauthorized lookup is cached as unresolved so the raw id renders without retry storms.
    /// </summary>
    private async Task ResolveActorNamesAsync(IReadOnlyList<AuditEntry> entries)
    {
        foreach (var actor in entries.Select(e => e.Actor).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            if (_actorNames.ContainsKey(actor) || !Guid.TryParse(actor, out var id))
                continue;
            try
            {
                _actorNames[actor] = (await Core.GetPrincipalAsync(id))?.DisplayName;
            }
            catch (CoreApiException)
            {
                _actorNames[actor] = null;
            }
        }
    }

}
