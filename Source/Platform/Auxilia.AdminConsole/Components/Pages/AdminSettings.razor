@page "/admin/settings"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core
@inject StepUpFlow StepUp

<PageTitle>Platform settings — Auxilia</PageTitle>

<PageHeader Title="Platform settings"
            Subtitle="Runtime security knobs — changes apply immediately, no redeployment. Writes demand a fresh step-up elevation."/>

@if (!_loaded)
{
    <LoadingState Rows="3"/>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    <NoticePanel Message="@_notice" OnDismiss="() => _notice = null"/>

    <StepUpPrompt Flow="StepUp" Busy="_busy" OnConfirm="ConfirmStepUpAsync"
                  Reason="Platform settings shape the security posture — re-enter YOUR credential (password or API key)."/>

    <section class="card">
        <div class="card-header">
            <h2>Default resource access</h2>
            <p class="card-subtitle">
                Who may use a grantable resource — a workflow type, environment layer, or slot
                provider — that carries no explicit grants. Explicit grants override either way;
                administrators always pass.
            </p>
        </div>
        <div class="card-body">
            <div class="form-grid">
                <label class="radio-row">
                    <input type="radio" name="default-access" value="@DefaultResourceAccessModes.Restricted"
                           checked="@(_defaultAccess == DefaultResourceAccessModes.Restricted)"
                           @onchange="() => _defaultAccess = DefaultResourceAccessModes.Restricted"/>
                    <span>
                        <strong>Restricted</strong> (the default) — an ungranted resource is usable by
                        administrators only until access is granted.
                    </span>
                </label>
                <label class="radio-row">
                    <input type="radio" name="default-access" value="@DefaultResourceAccessModes.Open"
                           checked="@(_defaultAccess == DefaultResourceAccessModes.Open)"
                           @onchange="() => _defaultAccess = DefaultResourceAccessModes.Open"/>
                    <span>
                        <strong>Open</strong> — an ungranted resource is usable by every principal whose
                        roles permit the action.
                    </span>
                </label>
            </div>
            <div class="button-row">
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveDefaultAccessAsync">
                    Save default access
                </button>
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Sign-in</h2>
            <p class="card-subtitle">How long a password sign-in's bearer token lives.</p>
        </div>
        <div class="card-body">
            <form class="toolbar" @onsubmit="SaveLoginLifetimeAsync" @onsubmit:preventDefault>
                <label>
                    Login token lifetime (minutes)
                    <input class="input-inline" type="number" min="1" @bind="_loginLifetimeMinutes"
                           placeholder="e.g. 480"/>
                </label>
                <div class="toolbar-actions">
                    <button type="submit" class="btn btn-primary"
                            disabled="@(_busy || _loginLifetimeMinutes is null or < 1)">Save lifetime</button>
                </div>
            </form>
            <p class="field-hint">
                Unset falls back to the deployment configuration. Stored value:
                @(_storedLoginLifetime is { Length: > 0 } stored ? $"{stored} minutes" : "none (deployment default)").
            </p>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Run checkpoints</h2>
            <p class="card-subtitle">
                How long what a workflow saves of itself while it runs — a session handed back to its
                user — is kept after its latest save. A run's request beats the workflow's declaration,
                which beats the general lifetime, as far as you let them; the maximum caps them all.
            </p>
        </div>
        <div class="card-body">
            <form class="toolbar" @onsubmit="SaveCheckpointLifetimesAsync" @onsubmit:preventDefault>
                <label>
                    General lifetime (hours)
                    <input class="input-inline" type="number" min="0" step="any" @bind="_checkpointHours"
                           placeholder="deployment default"/>
                </label>
                <label>
                    Maximum (hours)
                    <input class="input-inline" type="number" min="0" step="any" @bind="_checkpointMaxHours"
                           placeholder="deployment maximum"/>
                </label>
                <div class="toolbar-actions">
                    <button type="submit" class="btn btn-primary"
                            disabled="@(_busy || _checkpointHours is <= 0 || _checkpointMaxHours is <= 0)">
                        Save lifetimes
                    </button>
                </div>
            </form>
            <p class="field-hint">
                Empty clears a value back to the deployment configuration (unless changed there: a week,
                and at most thirty days).
            </p>
            <h3 class="body-caption">Who may set a lifetime other than the general one</h3>
            <div class="form-grid">
                <label class="radio-row">
                    <input type="radio" name="checkpoint-overrides" value="@CheckpointLifetimeOverrideModes.Run"
                           checked="@(_checkpointOverrides == CheckpointLifetimeOverrideModes.Run)"
                           @onchange="() => _checkpointOverrides = CheckpointLifetimeOverrideModes.Run"/>
                    <span>
                        <strong>Runs and workflows</strong> (the default) — a run request may set its
                        checkpoints' lifetime; otherwise the workflow's declared one applies.
                    </span>
                </label>
                <label class="radio-row">
                    <input type="radio" name="checkpoint-overrides" value="@CheckpointLifetimeOverrideModes.Workflow"
                           checked="@(_checkpointOverrides == CheckpointLifetimeOverrideModes.Workflow)"
                           @onchange="() => _checkpointOverrides = CheckpointLifetimeOverrideModes.Workflow"/>
                    <span>
                        <strong>Workflows only</strong> — a workflow's declared lifetime applies; a run
                        request that sets one is refused.
                    </span>
                </label>
                <label class="radio-row">
                    <input type="radio" name="checkpoint-overrides" value="@CheckpointLifetimeOverrideModes.None"
                           checked="@(_checkpointOverrides == CheckpointLifetimeOverrideModes.None)"
                           @onchange="() => _checkpointOverrides = CheckpointLifetimeOverrideModes.None"/>
                    <span>
                        <strong>Nobody</strong> — the general lifetime applies to every checkpoint.
                    </span>
                </label>
            </div>
            <div class="button-row">
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveCheckpointOverridesAsync">
                    Save who may override
                </button>
            </div>
        </div>
    </section>
}

@code {

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private string _defaultAccess = DefaultResourceAccessModes.Restricted;
    private int? _loginLifetimeMinutes;
    private string? _storedLoginLifetime;
    private double? _checkpointHours;
    private double? _checkpointMaxHours;
    private string _checkpointOverrides = CheckpointLifetimeOverrideModes.Run;

    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var settings = await Core.ListPlatformSettingsAsync(_cts.Token);
            var access = settings.FirstOrDefault(s => s.Key == PlatformSettingKeys.DefaultResourceAccess)?.Value;
            _defaultAccess = string.Equals(access, DefaultResourceAccessModes.Open, StringComparison.OrdinalIgnoreCase)
                ? DefaultResourceAccessModes.Open
                : DefaultResourceAccessModes.Restricted;
            _storedLoginLifetime = settings.FirstOrDefault(
                s => s.Key == PlatformSettingKeys.LoginTokenLifetimeMinutes)?.Value;
            _loginLifetimeMinutes = int.TryParse(_storedLoginLifetime, out var minutes) ? minutes : null;
            _checkpointHours = HoursOf(settings, PlatformSettingKeys.CheckpointLifetimeHours);
            _checkpointMaxHours = HoursOf(settings, PlatformSettingKeys.CheckpointLifetimeMaxHours);
            _checkpointOverrides = settings.FirstOrDefault(
                    s => s.Key == PlatformSettingKeys.CheckpointLifetimeOverrides)?.Value?.ToLowerInvariant() switch
            {
                CheckpointLifetimeOverrideModes.Workflow => CheckpointLifetimeOverrideModes.Workflow,
                CheckpointLifetimeOverrideModes.None => CheckpointLifetimeOverrideModes.None,
                _ => CheckpointLifetimeOverrideModes.Run,
            };
            _denied = false;
            _error = null;
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    private Task SaveDefaultAccessAsync()
        => MutateAsync(async () =>
        {
            await Core.SetPlatformSettingAsync(
                PlatformSettingKeys.DefaultResourceAccess, new SetPlatformSetting(_defaultAccess), _cts.Token);
            _notice = _defaultAccess == DefaultResourceAccessModes.Restricted
                ? "Default resource access is RESTRICTED — ungranted resources are administrators-only."
                : "Default resource access is OPEN — ungranted resources follow role permissions.";
        });

    private Task SaveLoginLifetimeAsync()
        => MutateAsync(async () =>
        {
            if (_loginLifetimeMinutes is not { } minutes || minutes < 1)
                return;
            await Core.SetPlatformSettingAsync(
                PlatformSettingKeys.LoginTokenLifetimeMinutes,
                new SetPlatformSetting(minutes.ToString()), _cts.Token);
            _notice = $"Login token lifetime set to {minutes} minutes.";
        });

    private Task SaveCheckpointLifetimesAsync()
        => MutateAsync(async () =>
        {
            await Core.SetPlatformSettingAsync(PlatformSettingKeys.CheckpointLifetimeHours,
                new SetPlatformSetting(Invariant(_checkpointHours)), _cts.Token);
            await Core.SetPlatformSettingAsync(PlatformSettingKeys.CheckpointLifetimeMaxHours,
                new SetPlatformSetting(Invariant(_checkpointMaxHours)), _cts.Token);
            _notice = "Checkpoint lifetimes saved — they apply from the next save on.";
        });

    private Task SaveCheckpointOverridesAsync()
        => MutateAsync(async () =>
        {
            await Core.SetPlatformSettingAsync(PlatformSettingKeys.CheckpointLifetimeOverrides,
                new SetPlatformSetting(_checkpointOverrides), _cts.Token);
            _notice = _checkpointOverrides switch
            {
                CheckpointLifetimeOverrideModes.Workflow => "Only workflows may set a checkpoint lifetime now.",
                CheckpointLifetimeOverrideModes.None => "Every checkpoint keeps the general lifetime now.",
                _ => "Runs and workflows may set a checkpoint lifetime.",
            };
        });

    private static double? HoursOf(IEnumerable<PlatformSettingDto> settings, string key)
        => double.TryParse(settings.FirstOrDefault(s => s.Key == key)?.Value,
            System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var hours)
            ? hours
            : null;

    private static string Invariant(double? hours)
        => hours?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    private async Task ConfirmStepUpAsync()
    {
        _busy = true;
        try
        {
            if (await StepUp.ConfirmAsync())
                await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MutateAsync(Func<Task> action)
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            if (await StepUp.RunAsync(action))
                await LoadAsync();
        }
        catch (CoreApiException ex)
        {
            _error = (ex.ErrorDetail ?? ex.Message).Replace('\n', ' ');
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}
