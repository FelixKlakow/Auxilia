@page "/admin/environments"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core
@inject StepUpFlow StepUp

<PageTitle>Environments — Auxilia</PageTitle>

<PageHeader Title="Environments"
            Subtitle="The capability catalog a run's container is composed from: a base environment plus the layers a workflow asks for. Layers build on the fly from their setup script and are cached by content."/>

@if (!_loaded)
{
    <LoadingState Rows="6"/>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    <NoticePanel Message="@_notice" OnDismiss="() => _notice = null"/>

    <StepUpPrompt Flow="StepUp" Busy="_busy" OnConfirm="ConfirmStepUpAsync"
                  Reason="Changing what runs can be built from is privileged — re-enter YOUR credential (password or API key)."/>

    <section class="card">
        <div class="card-header">
            <h2>Environment layers <span class="count-chip">@_layers.Count</span></h2>
            <p class="card-subtitle">
                A layer is offered to workflow editors only while it is available, and — when it carries
                sharing subjects — only to those subjects.
            </p>
            <div class="card-actions">
                <button class="btn btn-primary" @onclick="StartCreateLayer">New layer</button>
            </div>
        </div>
        @if (_layers.Count == 0)
        {
            <div class="card-body">
                <EmptyState Title="No environment layers"
                            Description="A layer names a capability a workflow can request — “dotnet-10”, “blender” — and the script that installs it.">
                    <div class="empty-actions">
                        <button class="btn btn-primary" @onclick="StartCreateLayer">Create your first layer</button>
                    </div>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Capability</th>
                        <th>Base</th>
                        <th>Version</th>
                        <th>Availability</th>
                        <th>Access</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var layer in _layers)
                    {
                        <tr>
                            <td>
                                <span class="cell-strong">@layer.ProviderType</span>
                                @if (layer.Description is { Length: > 0 } description)
                                {
                                    <span class="cell-sub">@description</span>
                                }
                            </td>
                            <td>
                                @foreach (var variant in layer.Variants)
                                {
                                    <div class="variant-row">
                                        <span class="type-chip">@variant.BaseEnvironment</span>
                                        @if (variant.BaseVersion is { Length: > 0 } baseVersion)
                                        {
                                            <span class="cell-sub">pinned to @baseVersion</span>
                                        }
                                        else
                                        {
                                            <span class="cell-sub">any version</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>@(layer.Version is { Length: > 0 } version ? version : "—")</td>
                            <td>
                                @if (IsAvailable(layer.ProviderType))
                                {
                                    <span class="badge badge-valid">available</span>
                                }
                                else
                                {
                                    <span class="badge">hidden</span>
                                }
                            </td>
                            <td>
                                @if (layer.Grants.Count > 0)
                                {
                                    <span class="badge badge-role" title="@SubjectSummary(layer.Grants)">
                                        @layer.Grants.Count subject@(layer.Grants.Count == 1 ? "" : "s")
                                    </span>
                                }
                                else if (_restrictedDefault is false)
                                {
                                    <span class="muted">everyone (default open)</span>
                                }
                                else
                                {
                                    <span class="badge"
                                          title="No grants — under the restricted platform default only administrators may bind this layer. Add sharing subjects to open it up.">
                                        admin-only (default)
                                    </span>
                                }
                            </td>
                            <td>@TimeText.Relative(layer.UpdatedUtc)</td>
                            <td>
                                <div class="cell-actions">
                                    <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                            @onclick="() => StartEditLayer(layer)">Edit</button>
                                    <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                            @onclick="() => StartLayerSharing(layer)">Sharing</button>
                                    <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                            @onclick="() => ToggleAvailabilityAsync(layer)">
                                        @(IsAvailable(layer.ProviderType) ? "Make unavailable" : "Make available")
                                    </button>
                                    <ConfirmButton Label="Delete" Question="Delete this layer?"
                                                   ConfirmLabel="Yes, delete" Busy="_busy"
                                                   OnConfirm="() => DeleteLayerAsync(layer)"/>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Environment bases <span class="count-chip">@_bases.Count</span></h2>
            <p class="card-subtitle">
                The (name, version) pairs layers may pin to — e.g. linux / ubuntu-24.04. A layer with no
                pin composes with any version of its base.
            </p>
        </div>
        @if (_bases.Count == 0)
        {
            <div class="card-body">
                <EmptyState Title="No base versions registered"
                            Description="Layers compose with any version of their base until versions are registered. Start from a suggested base — you stay the curator — or add your own below.">
                    <div class="empty-actions">
                        @foreach (var suggestion in SuggestedBases())
                        {
                            <button class="btn btn-secondary" disabled="@_busy"
                                    @onclick="() => AddSuggestedBaseAsync(suggestion)">
                                + @suggestion.Name / @suggestion.Version
                            </button>
                        }
                    </div>
                    @if (_runnerPlatforms.Count > 0)
                    {
                        <p class="field-hint">
                            Suggestions are filtered to what the connected runner fleet advertises
                            (@string.Join(", ", _runnerPlatforms)).
                        </p>
                    }
                </EmptyState>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Base</th>
                        <th>Version</th>
                        <th>Description</th>
                        <th>Used by</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var environmentBase in _bases)
                    {
                        var pinned = _layers.Count(l => l.Variants.Any(v =>
                            v.BaseVersion == environmentBase.Version && v.BaseEnvironment == environmentBase.Name));
                        <tr>
                            <td><span class="type-chip">@environmentBase.Name</span></td>
                            <td class="cell-strong">@environmentBase.Version</td>
                            <td>@(environmentBase.Description is { Length: > 0 } d ? d : "—")</td>
                            <td>
                                @if (pinned == 0)
                                {
                                    <span class="muted">no layers pinned</span>
                                }
                                else
                                {
                                    <span>@pinned layer@(pinned == 1 ? "" : "s")</span>
                                }
                            </td>
                            <td>@TimeText.Relative(environmentBase.UpdatedUtc)</td>
                            <td>
                                <ConfirmButton Label="Delete" Question="Delete this base version?"
                                               ConfirmLabel="Yes, delete" Busy="_busy"
                                               Title="@(pinned > 0 ? $"{pinned} layer(s) pin this version" : null)"
                                               OnConfirm="() => DeleteBaseAsync(environmentBase)"/>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="card-body">
            <h3 class="table-caption base-caption">Add a base version</h3>
            <form class="toolbar" @onsubmit="AddBaseAsync" @onsubmit:preventDefault>
                <label>
                    Base name
                    <input class="input-inline" list="environment-base-names" @bind="_baseName" placeholder="e.g. linux"/>
                    <datalist id="environment-base-names">
                        @foreach (var name in BaseNameSuggestions())
                        {
                            <option value="@name"></option>
                        }
                    </datalist>
                </label>
                <label>
                    Version
                    <input class="input-inline" @bind="_baseVersion" placeholder="e.g. ubuntu-24.04"/>
                </label>
                <label>
                    Description
                    <input @bind="_baseDescription" placeholder="optional"/>
                </label>
                <div class="toolbar-actions">
                    <button type="submit" class="btn btn-primary"
                            disabled="@(_busy || _baseName.Length == 0 || _baseVersion.Length == 0)">Add base version</button>
                </div>
            </form>
        </div>
    </section>

    <Drawer Open="_layerDraft is not null"
            Title="@(_layerDraft?.IsNew == true ? "New environment layer" : $"Edit {_layerDraft?.ProviderType}")"
            Subtitle="The setup script runs when the layer is built; the runner caches the result by content."
            OnClose="() => _layerDraft = null">
        <ChildContent>
            @if (_layerDraft is { } draft)
            {
                <div class="form-grid drawer-form">
                    <label>
                        Capability name
                        <input @bind="draft.ProviderType" disabled="@(!draft.IsNew)" placeholder="e.g. dotnet-10"/>
                        <span class="field-hint">
                            What a workflow asks for by name. Immutable once created — create a new layer to rename.
                        </span>
                    </label>
                    <label>
                        Description
                        <input @bind="draft.Description" placeholder="What this layer adds to the image"/>
                    </label>
                    <label>
                        Base environment
                        <select value="@draft.BaseEnvironment"
                                @onchange="e => SwitchDraftBase(e.Value?.ToString() ?? string.Empty)">
                            @foreach (var name in BaseNameSuggestions())
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                        <span class="field-hint">
                            Each base carries its OWN setup script — switching the base edits (or starts)
                            that base's variant; the other variants stay untouched.
                        </span>
                    </label>
                    <label>
                        Pinned base version
                        <select @bind="draft.BaseVersion">
                            <option value="">Any version of @draft.BaseEnvironment</option>
                            @foreach (var candidate in _bases.Where(b => b.Name == draft.BaseEnvironment))
                            {
                                <option value="@candidate.Version">@candidate.Version</option>
                            }
                        </select>
                        <span class="field-hint">A pin must name a version registered in the base catalog above.</span>
                    </label>
                    <label>
                        Software version
                        <input @bind="draft.Version" placeholder="optional, e.g. 10.0.100"/>
                        <span class="field-hint">Records what the script installs; free-form.</span>
                    </label>
                    <label>
                        Setup script
                        <textarea rows="12" class="script-input" spellcheck="false"
                                  @bind="draft.SetupScript"
                                  placeholder="#!/bin/sh&#10;apt-get update &amp;&amp; apt-get install -y …"></textarea>
                        <span class="field-hint">Runs during the layer build. Keep it idempotent — it is cached by content.</span>
                    </label>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-primary" disabled="@(_busy || !CanSaveLayer)" @onclick="SaveLayerAsync">
                @(_layerDraft?.IsNew == true ? "Create layer" : "Save variant")
            </button>
            @if (_layerDraft is { IsNew: false } editDraft && DraftVariantExists(editDraft))
            {
                <ConfirmButton Label="Remove variant"
                               Question="@($"Remove the {editDraft.BaseEnvironment} variant? Removing the last variant deletes the layer.")"
                               ConfirmLabel="Yes, remove" Busy="_busy"
                               OnConfirm="RemoveDraftVariantAsync"/>
            }
            <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _layerDraft = null">Cancel</button>
        </Footer>
    </Drawer>

    <Drawer Open="_sharingLayer is not null" Title="@($"Sharing — {_sharingLayer}")"
            Subtitle="Who may bind this environment layer into a run."
            OnClose="() => _sharingLayer = null">
        <ChildContent>
            <SharingEditor Rows="_sharingRows"
                           Hint="Leave empty to fall back to the platform default (restricted: administrators only; open: everyone). Adding a subject grants exactly those principals or groups — administrators always pass."
                           OpenLabel="No grants — the platform default access applies."/>
        </ChildContent>
        <Footer>
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveLayerSharingAsync">Save sharing</button>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _sharingLayer = null">Cancel</button>
        </Footer>
    </Drawer>
}

@code {

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private List<EnvironmentLayerDto> _layers = [];
    private List<EnvironmentBaseDto> _bases = [];
    // Availability lives on the catalog entry, not the layer record — the two are joined by name.
    private Dictionary<string, bool> _availability = new(StringComparer.Ordinal);

    private string _baseName = EnvironmentBases.Linux;
    private string _baseVersion = "";
    private string _baseDescription = "";

    // Best-effort context: null = the posture is unreadable for this operator (shown as the
    // restricted default, which is what an unset setting means).
    private bool? _restrictedDefault;
    private IReadOnlyList<string> _runnerPlatforms = [];

    private sealed record SuggestedBase(string Name, string Version, string Description);

    /// <summary>Curated seed bases offered when the catalog is empty; the admin stays the curator.</summary>
    private static readonly SuggestedBase[] CuratedBases =
    [
        new(EnvironmentBases.Linux, "ubuntu-24.04", "Ubuntu 24.04 LTS"),
        new(EnvironmentBases.Linux, "ubuntu-22.04", "Ubuntu 22.04 LTS"),
        new(EnvironmentBases.Linux, "debian-12", "Debian 12 (bookworm)"),
        new(EnvironmentBases.Windows, "server-2025", "Windows Server 2025"),
        new(EnvironmentBases.Windows, "server-2022", "Windows Server 2022"),
    ];

    private IEnumerable<SuggestedBase> SuggestedBases()
        => _runnerPlatforms.Count == 0
            ? CuratedBases
            : CuratedBases.Where(b => _runnerPlatforms.Contains(b.Name, StringComparer.OrdinalIgnoreCase));

    private LayerDraft? _layerDraft;
    private string? _sharingLayer;
    private List<GrantRow> _sharingRows = [];

    private readonly CancellationTokenSource _cts = new();

    private sealed class LayerDraft
    {
        public bool IsNew;
        public string ProviderType = "";
        public string Description = "";
        public string BaseEnvironment = EnvironmentBases.Linux;
        public string BaseVersion = "";
        public string Version = "";
        public string SetupScript = "";
        // The layer being edited — the drawer swaps script and pin when the base changes so
        // each base variant is edited in place, without touching its siblings.
        public EnvironmentLayerDto? Source;
    }

    private bool DraftVariantExists(LayerDraft draft)
        => draft.Source?.Variants.Any(v =>
            string.Equals(v.BaseEnvironment, draft.BaseEnvironment, StringComparison.OrdinalIgnoreCase)) == true;

    private void SwitchDraftBase(string baseEnvironment)
    {
        if (_layerDraft is not { } draft || baseEnvironment.Length == 0)
            return;
        draft.BaseEnvironment = baseEnvironment;
        var variant = draft.Source?.Variants.FirstOrDefault(v =>
            string.Equals(v.BaseEnvironment, baseEnvironment, StringComparison.OrdinalIgnoreCase));
        draft.SetupScript = variant?.SetupScript ?? "";
        draft.BaseVersion = variant?.BaseVersion ?? "";
    }

    private Task RemoveDraftVariantAsync()
    {
        if (_layerDraft is not { } draft)
            return Task.CompletedTask;
        return MutateAsync(async () =>
        {
            await Core.DeleteEnvironmentLayerVariantAsync(
                draft.ProviderType, draft.BaseEnvironment, _cts.Token);
            _notice = $"Variant \"{draft.BaseEnvironment}\" of \"{draft.ProviderType}\" removed.";
            _layerDraft = null;
        });
    }

    private bool CanSaveLayer
        => _layerDraft is { } draft && draft.ProviderType.Trim().Length > 0;

    private bool IsAvailable(string providerType)
        => _availability.GetValueOrDefault(providerType, true);

    private string SubjectSummary(IReadOnlyList<AccessGrant> grants)
        => string.Join(", ", grants.Select(g => $"{SharingDirectory.KindLabel(g.Kind)}: {g.Id}"));

    /// <summary>Base names the platform knows plus every name already in use — an open vocabulary.</summary>
    private IEnumerable<string> BaseNameSuggestions()
        => new[] { EnvironmentBases.Linux, EnvironmentBases.Windows }
            .Concat(_bases.Select(b => b.Name))
            .Concat(_layers.SelectMany(l => l.Variants).Select(v => v.BaseEnvironment))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(n => n, StringComparer.Ordinal);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _layers = (await Core.ListEnvironmentLayersAsync(ct: _cts.Token))
                .OrderBy(l => l.ProviderType, StringComparer.Ordinal).ToList();
            _bases = (await Core.ListEnvironmentBasesAsync(ct: _cts.Token))
                .OrderBy(b => b.Name, StringComparer.Ordinal)
                .ThenBy(b => b.Version, StringComparer.Ordinal).ToList();
            await LoadAvailabilityAsync();
            await LoadFleetAndPostureAsync();
            _denied = false;
            _error = null;
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    /// <summary>Best-effort: a layer whose catalog entry is unreadable simply shows as available.</summary>
    private async Task LoadAvailabilityAsync()
    {
        try
        {
            var page = await Core.QueryProviderCatalogAsync(new ProviderCatalogQuery(Take: 200), _cts.Token);
            _availability = page.Items
                .Where(e => e.ComposesEnvironment)
                .ToDictionary(e => e.ProviderType, e => e.Available, StringComparer.Ordinal);
        }
        catch (CoreApiException)
        {
            _availability = new Dictionary<string, bool>(StringComparer.Ordinal);
        }
    }

    private void StartCreateLayer()
    {
        _error = _notice = null;
        _sharingLayer = null;
        _layerDraft = new LayerDraft { IsNew = true };
    }

    private void StartEditLayer(EnvironmentLayerDto layer)
    {
        _error = _notice = null;
        _sharingLayer = null;
        var first = layer.Variants.FirstOrDefault();
        _layerDraft = new LayerDraft
        {
            IsNew = false,
            ProviderType = layer.ProviderType,
            Description = layer.Description ?? "",
            BaseEnvironment = first?.BaseEnvironment ?? EnvironmentBases.Linux,
            BaseVersion = first?.BaseVersion ?? "",
            Version = layer.Version ?? "",
            SetupScript = first?.SetupScript ?? "",
            Source = layer
        };
    }

    private Task SaveLayerAsync()
    {
        if (_layerDraft is not { } draft)
            return Task.CompletedTask;
        return MutateAsync(async () =>
        {
            await Core.UpsertEnvironmentLayerAsync(new UpsertEnvironmentLayer(
                ProviderType: draft.ProviderType.Trim(),
                Description: Empty(draft.Description),
                SetupScript: draft.SetupScript,
                BaseEnvironment: draft.BaseEnvironment,
                Version: Empty(draft.Version),
                BaseVersion: Empty(draft.BaseVersion)), _cts.Token);
            _notice = $"Environment layer \"{draft.ProviderType.Trim()}\" saved.";
            _layerDraft = null;
        });
    }

    private Task DeleteLayerAsync(EnvironmentLayerDto layer)
        => MutateAsync(async () =>
        {
            await Core.DeleteEnvironmentLayerAsync(layer.ProviderType, _cts.Token);
            _notice = $"Environment layer \"{layer.ProviderType}\" deleted.";
        });

    private Task ToggleAvailabilityAsync(EnvironmentLayerDto layer)
        => MutateAsync(async () =>
        {
            var available = !IsAvailable(layer.ProviderType);
            await Core.SetProviderAvailabilityAsync(layer.ProviderType, available, _cts.Token);
            _notice = available
                ? $"\"{layer.ProviderType}\" is now offered in workflow editors."
                : $"\"{layer.ProviderType}\" is hidden — existing configurations keep it, editors no longer offer it.";
        });

    private void StartLayerSharing(EnvironmentLayerDto layer)
    {
        _error = _notice = null;
        _layerDraft = null;
        _sharingLayer = layer.ProviderType;
        _sharingRows = GrantRows.From(layer.Grants);
    }

    private Task SaveLayerSharingAsync()
    {
        if (_sharingLayer is not { } providerType)
            return Task.CompletedTask;
        return MutateAsync(async () =>
        {
            var grants = GrantRows.ToGrants(_sharingRows);
            await Core.SetEnvironmentLayerGrantsAsync(
                providerType, new SetEnvironmentLayerGrants(grants), _cts.Token);
            _notice = grants.Count == 0
                ? $"\"{providerType}\" follows the platform default access again."
                : $"\"{providerType}\" is now restricted to {grants.Count} subject(s).";
            _sharingLayer = null;
        });
    }

    /// <summary>
    /// Best-effort context: the fleet's advertised platforms (filters base suggestions) and the
    /// default-access posture (labels ungranted layers). Either read may be forbidden for this
    /// operator — the page then falls back to showing the restricted default.
    /// </summary>
    private async Task LoadFleetAndPostureAsync()
    {
        try
        {
            _runnerPlatforms = (await Core.ListRunnersAsync(_cts.Token))
                .Where(r => r.Alive)
                .Select(r => r.HostPlatform)
                .OfType<string>()
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (CoreApiException)
        {
            _runnerPlatforms = [];
        }
        try
        {
            var settings = await Core.ListPlatformSettingsAsync(_cts.Token);
            _restrictedDefault = !string.Equals(
                settings.FirstOrDefault(s => s.Key == PlatformSettingKeys.DefaultResourceAccess)?.Value,
                DefaultResourceAccessModes.Open, StringComparison.OrdinalIgnoreCase);
        }
        catch (CoreApiException)
        {
            _restrictedDefault = null;
        }
    }

    private Task AddSuggestedBaseAsync(SuggestedBase suggestion)
        => MutateAsync(async () =>
        {
            await Core.UpsertEnvironmentBaseAsync(new UpsertEnvironmentBase(
                suggestion.Name, suggestion.Version, suggestion.Description), _cts.Token);
            _notice = $"Base version \"{suggestion.Name} / {suggestion.Version}\" registered.";
        });

    private Task AddBaseAsync()
        => MutateAsync(async () =>
        {
            await Core.UpsertEnvironmentBaseAsync(new UpsertEnvironmentBase(
                _baseName.Trim(), _baseVersion.Trim(), Empty(_baseDescription)), _cts.Token);
            _notice = $"Base version \"{_baseName.Trim()} / {_baseVersion.Trim()}\" registered.";
            _baseVersion = _baseDescription = "";
        });

    private Task DeleteBaseAsync(EnvironmentBaseDto environmentBase)
        => MutateAsync(async () =>
        {
            await Core.DeleteEnvironmentBaseAsync(environmentBase.Name, environmentBase.Version, _cts.Token);
            _notice = $"Base version \"{environmentBase.Name} / {environmentBase.Version}\" deleted.";
        });

    private async Task ConfirmStepUpAsync()
    {
        _busy = true;
        try
        {
            if (await StepUp.ConfirmAsync())
                await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MutateAsync(Func<Task> action)
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            if (await StepUp.RunAsync(action))
                await LoadAsync();
        }
        catch (CoreApiException ex)
        {
            _error = (ex.ErrorDetail ?? ex.Message).Replace('\n', ' ');
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? Empty(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}
