@page "/admin/provider-catalog"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core
@inject StepUpFlow StepUp

<PageTitle>Provider catalog — Auxilia</PageTitle>

<PageHeader Title="Provider catalog"
            Subtitle="Which slot providers may be configured for workflows on this platform. Provider availability is deny-by-default."/>

@if (!_loaded)
{
    <LoadingState Rows="6"/>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    <NoticePanel Message="@_notice" OnDismiss="() => _notice = null"/>

    <StepUpPrompt Flow="StepUp" Busy="_busy" OnConfirm="ConfirmStepUpAsync"
                  Reason="Changing what workflows may be built from is privileged — re-enter YOUR credential (password or API key)."/>

    <section class="card">
        <div class="card-header">
            <h2>Registered providers</h2>
            <p class="card-subtitle">
                A provider is offered in the editors only after it is made available here.
                Workflow availability lives under <a href="admin/workflow-types">Workflow registry</a>,
                and environment layers have their own tab under <a href="admin/environments">Environments</a>@(_environmentCount > 0 ? $" ({_environmentCount} registered)" : "").
            </p>
        </div>
        @if (_providers.Count == 0)
        {
            <div class="card-body"><p class="muted view-empty">No slot-handler plugins registered.</p></div>
        }
        else
        {
            <div class="table-scroll">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Provider type</th>
                    <th>Category</th>
                    <th>Contracts</th>
                    <th>Availability</th>
                    <th>Access</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in _providers)
                {
                    <tr>
                        <td>
                            <span class="cell-strong">@entry.ProviderType</span>
                            @if (entry.Description is { Length: > 0 })
                            {
                                <span class="cell-sub">@entry.Description</span>
                            }
                        </td>
                        <td>
                            @if (entry.Category.Length == 0)
                            {
                                <span class="muted">(uncategorized)</span>
                            }
                            else
                            {
                                <span class="type-chip">@entry.Category</span>
                            }
                        </td>
                        <td>
                            @if (entry.Contracts.Count == 0)
                            {
                                <span class="muted">none</span>
                            }
                            @foreach (var contract in entry.Contracts)
                            {
                                <span class="type-chip">@contract</span>
                            }
                        </td>
                        <td>
                            @if (entry.Available)
                            {
                                <span class="badge badge-valid">available</span>
                            }
                            else
                            {
                                <span class="badge">hidden</span>
                            }
                        </td>
                        <td>
                            @if (entry.Grants is { Count: > 0 } grants)
                            {
                                <span class="badge badge-role" title="@SubjectSummary(grants)">
                                    @grants.Count subject@(grants.Count == 1 ? "" : "s")
                                </span>
                            }
                            else
                            {
                                <span class="badge"
                                      title="No grants — under the restricted platform default only administrators may bind this provider. Add sharing subjects to open it up.">
                                    platform default
                                </span>
                            }
                        </td>
                        <td>
                            <div class="cell-actions">
                                <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                        @onclick="() => ToggleAvailabilityAsync(entry)">
                                    @(entry.Available ? "Make unavailable" : "Make available")
                                </button>
                                <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                        @onclick="() => StartSharing(entry)">Sharing</button>
                                @if (entry.Descriptors.Count > 0)
                                {
                                    <button class="btn btn-secondary btn-sm"
                                            aria-expanded="@(_curatedProvider == entry.ProviderType ? "true" : "false")"
                                            @onclick="() => _curatedProvider = _curatedProvider == entry.ProviderType ? null : entry.ProviderType">
                                        @(_curatedProvider == entry.ProviderType ? "Close settings" : "Curate settings")
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (_curatedProvider == entry.ProviderType)
                    {
                        <tr>
                            <td colspan="6">
                                <p class="field-hint">
                                    A disabled setting disappears from every editor and is no longer required —
                                    e.g. disable an external API key to only allow preassigned credentials.
                                    Stored values are kept.
                                </p>
                                <div class="cell-actions">
                                    @foreach (var descriptor in entry.Descriptors)
                                    {
                                        <span class="badge badge-secret" title="@descriptor.HelpText">
                                            @descriptor.Label (@descriptor.Kind)@(descriptor.Required ? " *" : "")
                                            @if (descriptor.Disabled)
                                            {
                                                <em> — disabled</em>
                                            }
                                        </span>
                                        <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                                @onclick="() => ToggleSettingAsync(entry, descriptor.Key, !descriptor.Disabled)">
                                            @(descriptor.Disabled ? "Enable" : "Disable")
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
            </div>
        }
    </section>

    <Drawer Open="_sharingProvider is not null" Title="@($"Sharing — {_sharingProvider}")"
            Subtitle="Who may bind this provider into a run."
            OnClose="() => _sharingProvider = null">
        <ChildContent>
            <SharingEditor Rows="_sharingRows"
                           Hint="Leave empty to fall back to the platform default (restricted: administrators only; open: everyone). Adding a subject grants exactly those principals or groups — administrators always pass."
                           OpenLabel="No grants — the platform default access applies."/>
        </ChildContent>
        <Footer>
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveSharingAsync">Save sharing</button>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _sharingProvider = null">Cancel</button>
        </Footer>
    </Drawer>
}

@code {

    private const int PageSize = 200;

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private string? _error;
    private string? _notice;
    private string? _curatedProvider;
    private List<ProviderCatalogEntry> _providers = [];
    private int _environmentCount;

    private string? _sharingProvider;
    private List<GrantRow> _sharingRows = [];

    private readonly CancellationTokenSource _cts = new();

    private static string SubjectSummary(IReadOnlyList<AccessGrant> grants)
        => string.Join(", ", grants.Select(g => $"{SharingDirectory.KindLabel(g.Kind)}: {g.Id}"));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var page = await Core.QueryProviderCatalogAsync(new ProviderCatalogQuery(Skip: 0, Take: PageSize), _cts.Token);
            var ordered = page.Items.OrderBy(e => e.ProviderType, StringComparer.Ordinal).ToList();
            // Environment layers are catalog records too, but they are a different concept with
            // their own admin tab — this page is slot providers only.
            _providers = ordered.Where(e => !e.ComposesEnvironment).ToList();
            _environmentCount = ordered.Count - _providers.Count;
            _denied = false;
            _error = null;
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    private Task ToggleAvailabilityAsync(ProviderCatalogEntry entry)
        => MutateAsync(() => Core.SetProviderAvailabilityAsync(entry.ProviderType, !entry.Available, _cts.Token));

    private Task ToggleSettingAsync(ProviderCatalogEntry entry, string key, bool disabled)
        => MutateAsync(() => Core.SetProviderSettingDisabledAsync(entry.ProviderType, key, disabled, _cts.Token));

    private void StartSharing(ProviderCatalogEntry entry)
    {
        _error = _notice = null;
        _curatedProvider = null;
        _sharingProvider = entry.ProviderType;
        _sharingRows = GrantRows.From(entry.Grants);
    }

    private Task SaveSharingAsync()
    {
        if (_sharingProvider is not { } providerType)
            return Task.CompletedTask;
        return MutateAsync(async () =>
        {
            var grants = GrantRows.ToGrants(_sharingRows);
            await Core.SetProviderGrantsAsync(providerType, new SetProviderGrants(grants), _cts.Token);
            _notice = grants.Count == 0
                ? $"\"{providerType}\" follows the platform default access again."
                : $"\"{providerType}\" is now restricted to {grants.Count} subject(s).";
            _sharingProvider = null;
        });
    }

    private async Task ConfirmStepUpAsync()
    {
        _busy = true;
        try
        {
            if (await StepUp.ConfirmAsync())
                await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MutateAsync(Func<Task> action)
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            if (await StepUp.RunAsync(action))
                await LoadAsync();
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}
