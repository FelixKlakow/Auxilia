@page "/workflows"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core

<PageTitle>Workflows — Auxilia</PageTitle>

<PageHeader Title="Workflows"
            Subtitle="Stored run configurations: a workflow type with its slots bound to connectors. Run one, or edit its bindings."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    @if (_notice is not null)
    {
        <div class="panel success">@_notice</div>
    }

    <div class="toolbar">
        <label>
            Workflow type
            <input @bind="_workflowType" placeholder="e.g. code-review" @bind:after="ApplyAsync"/>
        </label>
        <button class="btn btn-secondary" @onclick="RefreshAsync">Refresh</button>
        <a class="btn btn-primary" href="workflows/new">New configuration</a>
    </div>

    @if (_configurations.Count == 0)
    {
        <EmptyState Title="No workflow configurations"
                    Description="A configuration binds a workflow type's capability slots to connectors so it can be run.">
            <a class="btn btn-primary" href="workflows/new">Configure your first workflow</a>
        </EmptyState>
    }
    else
    {
        <div class="card">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Workflow type</th>
                    <th>Slots</th>
                    <th>Scope</th>
                    <th>State</th>
                    <th>Updated</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var configuration in _configurations)
                {
                    <tr>
                        <td class="cell-strong">@configuration.Name</td>
                        <td>@configuration.WorkflowType</td>
                        <td>@configuration.SlotBindings.Count</td>
                        <td><span class="badge badge-state">@configuration.Scope</span></td>
                        <td>
                            <span class="badge badge-state @(configuration.Enabled ? "badge-success" : "badge-cancelled")">
                                @(configuration.Enabled ? "Enabled" : "Disabled")
                            </span>
                        </td>
                        <td>@TimeText.Relative(configuration.UpdatedUtc)</td>
                        <td>
                            <button class="btn btn-primary btn-sm" disabled="@(_busy || !configuration.Enabled)"
                                    title="@(configuration.Enabled ? "Run this configuration as yourself" : "Enable the configuration first")"
                                    @onclick="() => RunAsync(configuration)">Run</button>
                            <a class="btn btn-secondary btn-sm" href="workflows/@configuration.Id/edit">Edit</a>
                            @if (configuration.Scope == ResourceScope.Personal)
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => StartGrants(configuration)">Sharing</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (_skip + _configurations.Count < _total)
            {
                <div class="card-body table-more">
                    <button class="btn btn-secondary" @onclick="ShowMoreAsync">
                        Show more (@(_skip + _configurations.Count) of @_total)
                    </button>
                </div>
            }
        </div>
    }

    @if (_grants is { } panel)
    {
        <section class="card">
            <div class="card-header">
                <h2>Sharing — @panel.ConfigurationName</h2>
                <p class="card-subtitle">Who besides the owner may see and run this personal configuration.</p>
            </div>
            <div class="card-body">
                @foreach (var grant in panel.Grants)
                {
                    <div class="form-grid grant-row">
                        <select @bind="grant.Kind">
                            <option value="@AccessGrantKind.Principal">Principal</option>
                            <option value="@AccessGrantKind.Group">Group</option>
                            <option value="@AccessGrantKind.DirectoryGroup">Directory group</option>
                        </select>
                        @if (grant.Kind == AccessGrantKind.Principal && _subjects is { Principals.Count: > 0 } sp)
                        {
                            <select @bind="grant.Id">
                                <option value="">Pick a principal…</option>
                                @foreach (var principal in sp.Principals)
                                {
                                    <option value="@principal.Id">@principal.DisplayName (@principal.Kind)</option>
                                }
                            </select>
                        }
                        else if (grant.Kind == AccessGrantKind.Group && _subjects is { Groups.Count: > 0 } sg)
                        {
                            <select @bind="grant.Id">
                                <option value="">Pick a group…</option>
                                @foreach (var group in sg.Groups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input @bind="grant.Id" placeholder="subject id (AD group object id / GUID)"/>
                        }
                        <button class="btn btn-danger btn-sm" @onclick="() => panel.Grants.Remove(grant)">Remove</button>
                    </div>
                }
                <div class="button-row editor-actions">
                    <button class="btn btn-secondary btn-sm" @onclick="() => panel.Grants.Add(new GrantRow())">Add grant</button>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SaveGrantsAsync">Save sharing</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _grants = null">Cancel</button>
                </div>
            </div>
        </section>
    }
}

@code {

    private const int PageSize = 50;

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private string? _error;
    private string? _notice;

    private string _workflowType = "";

    private int _skip;
    private int _total;
    private List<RunConfiguration> _configurations = [];

    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync() => LoadAsync(reset: true);

    private Task ApplyAsync() => LoadAsync(reset: true);
    private Task RefreshAsync() => LoadAsync(reset: true);
    private Task ShowMoreAsync() => LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        if (reset)
        {
            _skip = 0;
            _configurations = [];
        }

        var query = new ConfigurationQuery(
            WorkflowType: string.IsNullOrWhiteSpace(_workflowType) ? null : _workflowType.Trim(),
            Skip: _skip,
            Take: PageSize);

        try
        {
            var page = await Core.QueryConfigurationsAsync(query, _cts.Token);
            _denied = false;
            _error = null;
            _total = page.Total;
            _configurations.AddRange(page.Items);
            _skip += page.Items.Count;
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    /// <summary>Dispatches the configuration as the signed-in user — no on-behalf-of delegation.</summary>
    private async Task RunAsync(RunConfiguration configuration)
    {
        _error = _notice = null;
        _busy = true;
        try
        {
            var accepted = await Core.RunConfigurationAsync(configuration.Id, ct: _cts.Token);
            _notice = $"Run of \"{configuration.Name}\" dispatched ({accepted.RunId.ToString("N")[..8]}) — see it under Runs.";
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private GrantsDraft? _grants;

    private sealed class GrantsDraft
    {
        public Guid ConfigurationId;
        public string ConfigurationName = "";
        public List<GrantRow> Grants = [];
    }

    private sealed class GrantRow
    {
        public string Kind { get; set; } = AccessGrantKind.Principal;
        public string Id { get; set; } = "";
    }

    private SharingSubjects? _subjects;

    private async Task EnsureSubjectsAsync()
    {
        if (_subjects is not null)
            return;
        try
        {
            _subjects = await Core.GetSharingSubjectsAsync(_cts.Token);
        }
        catch (CoreApiException)
        {
            // Picker degrades to the raw-id input; the save path still works.
        }
        await InvokeAsync(StateHasChanged);
    }

    private void StartGrants(RunConfiguration configuration)
    {
        _ = EnsureSubjectsAsync();
        _error = _notice = null;
        _grants = new GrantsDraft
        {
            ConfigurationId = configuration.Id,
            ConfigurationName = configuration.Name,
            Grants = (configuration.Grants ?? [])
                .Select(g => new GrantRow { Kind = g.Kind, Id = g.Id })
                .ToList()
        };
    }

    private async Task SaveGrantsAsync()
    {
        if (_grants is null)
            return;
        _busy = true;
        try
        {
            var grants = _grants.Grants
                .Where(g => !string.IsNullOrWhiteSpace(g.Id))
                .Select(g => new AccessGrant(g.Kind, g.Id.Trim()))
                .ToList();
            var updated = await Core.SetConfigurationGrantsAsync(
                _grants.ConfigurationId, new SetConfigurationGrants(grants), _cts.Token);
            var index = _configurations.FindIndex(c => c.Id == updated.Id);
            if (index >= 0)
                _configurations[index] = updated;
            _notice = $"Sharing for \"{_grants.ConfigurationName}\" saved.";
            _grants = null;
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}
