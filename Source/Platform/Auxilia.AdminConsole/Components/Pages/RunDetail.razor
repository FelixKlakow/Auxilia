@page "/runs/{Id:guid}"
@attribute [Authorize]
@using System.Text.Json
@using Auxilia.Workflows.Messaging.Messages
@using Microsoft.JSInterop
@implements IDisposable
@inject ICoreClient Core
@inject ILogger<RunDetail> Logger
@inject IJSRuntime JS
@inject CoreClientOptions CoreOptions

<PageTitle>@(_run is null ? "Run" : $"{_run.WorkflowType} · run {ShortId}") — Auxilia</PageTitle>

<div class="page-back"><a href="runs">← All runs</a></div>

@if (!_loaded)
{
    <PageHeader Title="Run"/>
    <LoadingState Rows="5"/>
}
else if (_denied)
{
    <PageHeader Title="Run"/>
    <div class="panel denied">Access denied: @_error</div>
}
else if (_run is null)
{
    <PageHeader Title="Run"/>
    <div class="panel denied">Run not found.</div>
}
else
{
    <header class="page-header">
        <h1>
            @_run.WorkflowType · run @ShortId
            @if (LiveNow.IsActive(_state))
            {
                <span class="badge badge-state badge-running live-badge"><span class="live-dot"></span> Live</span>
            }
        </h1>
        <p class="page-subtitle run-id-line" title="Full run ID — select to copy">@Id</p>
    </header>

    <ConnectionBanner Connected="_connected" Detail="@_connectionDetail" LastUpdatedUtc="_lastEventUtc"/>

    @if (!IsTerminal)
    {
        <div class="button-row rerun-row">
            @if (_run.HasTerminal)
            {
                <button class="btn btn-secondary" disabled="@_busy" @onclick="OpenTerminalAsync">
                    Open terminal
                </button>
            }
            <ConfirmButton Label="Cancel this run" Question="Cancel this run?" ConfirmLabel="Cancel run"
                           CancelLabel="Keep running" Busy="_busy" OnConfirm="CancelAsync"/>
        </div>
    }

    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    @if (_cancelNotice is not null)
    {
        <div class="panel success">@_cancelNotice</div>
    }

    <div class="card">
        <dl class="card-body meta-grid">
            <div>
                <dt>State</dt>
                <dd><span class="badge badge-state @StateBadge.ClassFor(_state)">@_state</span></dd>
            </div>
            <div>
                <dt>Started</dt>
                <dd>
                    @TimeText.Relative(_run.CreatedUtc)
                    <span class="cell-sub">@_run.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                </dd>
            </div>
            <div>
                <dt>Configuration</dt>
                <dd>@(_run.ConfigurationName ?? "—")</dd>
            </div>
        </dl>
    </div>

    var views = ViewsSnapshot();
    @if (views.Count == 0)
    {
        <EmptyState Title="No view items yet"
                    Description="Views appear here the moment the workflow publishes progress, results, or an agent conversation."/>
    }
    @foreach (var (viewName, buffer) in views)
    {
        var items = buffer.Items;
        var descriptor = ViewDescriptorHeuristics.DescriptorFor(viewName, items);
        <section class="card view-card">
            <div class="card-header">
                <h2 class="view-title">
                    @viewName
                    <span class="type-chip">@descriptor.Rendering.ToString().ToLowerInvariant()</span>
                </h2>
                <button class="btn btn-secondary btn-pin" title="Keep this view on your dashboard"
                        disabled="@_busy" @onclick="() => PinAsync(viewName)">
                    @(_pinned.Contains(viewName) ? "Pinned ✓" : "Pin to dashboard")
                </button>
            </div>
            <div class="card-body">
                <ViewRenderer Descriptor="descriptor" Items="items" IsLive="!IsTerminal"/>
            </div>
        </section>
    }

    @* The event log is the run's narrative, not its output — it sits BELOW the views and is
       collapsed by default, and the section is rendered as soon as the lookup finishes (even when
       empty) so the late-arriving terminal run.* event cannot shove the views around. *@
    @if (_eventsLoaded)
    {
        <section class="card">
            <div class="card-header">
                <h2 class="view-title">
                    Event log <span class="count-chip">@_events.Count</span>
                </h2>
                <div class="card-actions">
                    <a class="btn btn-secondary btn-sm" href="events?sourceRun=@Id">View all →</a>
                </div>
            </div>
            @if (_events.Count == 0)
            {
                <div class="card-body"><p class="muted view-empty">This run has published no events.</p></div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                        <tr>
                            <th>When (UTC)</th>
                            <th>Event type</th>
                            <th>Work item</th>
                            <th>Payload</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var evt in _events)
                        {
                            <tr>
                                <td class="cell-mono">@evt.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="cell-strong">@evt.EventType</td>
                                <td class="cell-mono">@(evt.WorkItemId is { Length: > 0 } wi ? wi : "—")</td>
                                <td>
                                    @{
                                        var summary = PayloadSummary.Fields(evt.PayloadJson);
                                    }
                                    @if (summary.Count == 0)
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="field-summary">
                                            @foreach (var field in summary)
                                            {
                                                <span class="log-field">
                                                    @if (field.Key.Length > 0)
                                                    {
                                                        <span class="log-label">@field.Key</span>
                                                    }
                                                    <span class="log-value">@field.Value</span>
                                                </span>
                                            }
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private readonly CancellationTokenSource _cts = new();
    // One ordered item list per view name, keyed by the view's monotonic sequence.
    private readonly Dictionary<string, ViewItemBuffer> _buffers = new(StringComparer.Ordinal);

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private bool _streamStarted;
    private bool _connected = true;
    private string? _connectionDetail;
    private DateTimeOffset? _lastEventUtc;
    private string? _error;
    private string? _cancelNotice;
    private RunStatus? _run;
    private string _state = "";
    private List<EventDto> _events = [];
    // Distinguishes "no events" from "not looked up yet" — and from "not permitted to look".
    private bool _eventsLoaded;

    private string ShortId => Id.ToString("N")[..8];

    private bool IsTerminal => !LiveNow.IsActive(_state);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _run = await Core.GetRunAsync(Id, _cts.Token);
            _state = _run?.State ?? "";
            _error = _run?.Error;
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Live path: consume the Core's SSE run stream for the whole circuit. Started once, after
        // the first render so prerender never blocks on the open stream.
        if (!firstRender || _streamStarted || _denied || _run is null)
            return;
        _streamStarted = true;
        _ = ConsumeStreamAsync();
        _ = LoadPersistedViewsAsync();
        _ = LoadEventsAsync();
    }

    /// <summary>
    /// Events this run published (and its terminal run.* lifecycle event). Loaded best-effort:
    /// a principal without event.consume simply sees no events section.
    /// </summary>
    private async Task LoadEventsAsync()
    {
        try
        {
            var page = await Core.QueryEventsAsync(new EventQuery(SourceRunId: Id, Take: 100), _cts.Token);
            _events = page.Items.ToList();
            _eventsLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Circuit disposed.
        }
        catch (Exception ex)
        {
            // A principal without event.consume simply gets no section — an empty log would be a
            // claim we cannot make.
            Logger.LogDebug(ex, "Event lookup skipped for run {RunId}.", Id);
        }
    }

    /// <summary>
    /// Backfills history from the persisted view store (paged). Runs concurrently with the live
    /// stream — the sequence-keyed buffers merge both sources without duplicates.
    /// </summary>
    private async Task LoadPersistedViewsAsync()
    {
        try
        {
            const int pageSize = 200;
            var skip = 0;
            while (true)
            {
                var page = await Core.GetRunViewsAsync(Id, skip: skip, take: pageSize, ct: _cts.Token);
                var changed = false;
                foreach (var group in page.Items.GroupBy(i => i.ViewName, StringComparer.Ordinal))
                    changed |= BufferOf(group.Key).Merge(group.Select(ToRecord));
                if (changed)
                    await InvokeAsync(StateHasChanged);
                skip += page.Items.Count;
                if (page.Items.Count == 0 || skip >= page.Total)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // Circuit disposed — the backfill ends with it.
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // A transient transport failure mid-backfill: the reconnect path re-runs the backfill.
            Logger.LogWarning(ex, "Persisted-view backfill failed for run {RunId}.", Id);
        }
    }

    private ViewDataRecord ToRecord(RunViewItem item) => new()
    {
        Id = Guid.NewGuid(),
        WorkflowInstanceId = Id,
        ViewName = item.ViewName,
        Sequence = item.Sequence,
        PayloadJson = item.PayloadJson,
        TimestampUtc = item.TimestampUtc
    };

    /// <summary>
    /// Consumes the resilient client stream. The client reconnects internally and re-delivers the
    /// current state as a snapshot frame, so normal completion of the enumeration reliably means
    /// the run reached a terminal state. Reconnecting/Connected frames drive the banner; a
    /// reconnect refetches the run and re-runs the persisted-view backfill (the sequence-keyed
    /// buffers merge without duplicates).
    /// </summary>
    private async Task ConsumeStreamAsync()
    {
        try
        {
            await foreach (var frame in Core.StreamRunAsync(Id, _cts.Token))
            {
                switch (frame)
                {
                    case StreamEventFrame<RunStreamEvent> evt:
                        Apply(evt.Event);
                        _lastEventUtc = evt.Event.TimestampUtc;
                        break;

                    case StreamConnectionFrame<RunStreamEvent> { State: StreamConnectionState.Reconnecting } down:
                        _connected = false;
                        _connectionDetail = down.Cause?.Message;
                        break;

                    case StreamConnectionFrame<RunStreamEvent> { State: StreamConnectionState.Connected } up:
                        _connected = true;
                        _connectionDetail = null;
                        if (up.Attempt > 1)
                            await RefreshAfterReconnectAsync();
                        break;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Circuit disposed — the stream ends with it.
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // Defensive: the client wraps transport errors, so anything landing here is a bug —
            // surface it instead of leaving an unobserved faulted task and a frozen page.
            Logger.LogError(ex, "Run stream consumer failed for run {RunId}.", Id);
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>State may have jumped while disconnected — refetch the run and backfill views.</summary>
    private async Task RefreshAfterReconnectAsync()
    {
        try
        {
            if (await Core.GetRunAsync(Id, _cts.Token) is { } run)
            {
                _run = run;
                _state = run.State;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Post-reconnect refetch failed for run {RunId}.", Id);
        }
        _ = LoadPersistedViewsAsync();
    }

    /// <summary>Decode one SSE frame: a status transition updates run state; a view frame buffers an item.</summary>
    private void Apply(RunStreamEvent evt)
    {
        switch (evt.Kind)
        {
            case RunStreamEvent.StatusKind:
                if (Decode<WorkflowStatusEvent>(evt.PayloadJson) is { } status)
                {
                    _state = status.State;
                    if (status.ErrorMessage is { Length: > 0 } message)
                        _error = message;
                    if (IsTerminal)
                        _ = RefreshEventsAfterTerminalAsync();
                }
                break;

            case RunStreamEvent.ViewKind:
                if (Decode<ViewDataMessage>(evt.PayloadJson) is { } view)
                {
                    var record = new ViewDataRecord
                    {
                        Id = Guid.NewGuid(),
                        WorkflowInstanceId = view.WorkflowInstanceId,
                        ViewName = view.ViewName,
                        Sequence = evt.Sequence,
                        PayloadJson = view.PayloadJson,
                        TimestampUtc = evt.TimestampUtc
                    };
                    BufferOf(view.ViewName).Add(record);
                }
                break;
        }
    }

    /// <summary>The run.* lifecycle event lands moments after the terminal status — refetch once.</summary>
    private async Task RefreshEventsAfterTerminalAsync()
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2), _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await LoadEventsAsync();
    }

    private ViewItemBuffer BufferOf(string viewName)
    {
        lock (_buffers)
        {
            if (!_buffers.TryGetValue(viewName, out var buffer))
                _buffers[viewName] = buffer = new ViewItemBuffer();
            return buffer;
        }
    }

    private List<KeyValuePair<string, ViewItemBuffer>> ViewsSnapshot()
    {
        lock (_buffers)
            return _buffers.ToList();
    }

    private static T? Decode<T>(string json)
    {
        try
        {
            // The Core serializes frame payloads with the Web defaults (camelCase) — decoding
            // with the case-sensitive defaults would silently null every field.
            return JsonSerializer.Deserialize<T>(json, JsonSerializerOptions.Web);
        }
        catch (JsonException)
        {
            return default;
        }
    }

    private readonly HashSet<string> _pinned = new(StringComparer.Ordinal);

    private async Task PinAsync(string viewName)
    {
        try
        {
            await Core.PinDashboardViewAsync(new CreateDashboardPin(Id, viewName), _cts.Token);
            _pinned.Add(viewName);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
    }

    /// <summary>
    /// Mints a short-lived terminal ticket and opens the Core's ticketed proxy in a new tab —
    /// the browser talks to the Core only; the container itself is never reachable.
    /// </summary>
    private async Task OpenTerminalAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var ticket = await Core.OpenTerminalAsync(Id, _cts.Token);
            var url = CoreOptions.BaseAddress.TrimEnd('/') + ticket.Url;
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync()
    {
        _error = _cancelNotice = null;
        _busy = true;
        try
        {
            await Core.CancelRunAsync(Id, _cts.Token);
            _cancelNotice = "Cancellation requested — the state flips once the workflow acknowledges.";
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}
