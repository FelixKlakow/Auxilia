@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core

<PageTitle>Dashboard — Auxilia</PageTitle>

<PageHeader Title="Dashboard" Subtitle="What is running now, and what ran recently."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }

    <div class="stat-grid">
        <div class="stat-tile">
            <span class="stat-value">@(_stats?.Active ?? _active.Count)</span>
            <span class="stat-label">Active now</span>
        </div>
        <div class="stat-tile">
            <span class="stat-value">@StatOf("Success")</span>
            <span class="stat-label">Succeeded</span>
        </div>
        <div class="stat-tile @(StatOf("Failed") > 0 ? "stat-bad" : null)">
            <span class="stat-value">@StatOf("Failed")</span>
            <span class="stat-label">Failed</span>
        </div>
        <div class="stat-tile">
            <span class="stat-value">@(_stats?.Total ?? _total)</span>
            <span class="stat-label">Runs total</span>
        </div>
    </div>

    @if (_pins.Count > 0)
    {
        <section class="pinned-views-section">
            <h2 class="section-title">Pinned views</h2>
            @foreach (var pin in _pins)
            {
                var items = _pinnedItems.GetValueOrDefault(pin.Id) ?? [];
                <section class="card view-card">
                    <div class="card-header">
                        <h2 class="view-title">
                            <a href="runs/@pin.RunId">@pin.WorkflowType</a> · @pin.ViewName
                        </h2>
                        <button class="btn btn-secondary" title="Remove from the dashboard"
                                @onclick="() => UnpinAsync(pin.Id)">Unpin</button>
                    </div>
                    <div class="card-body">
                        @if (items.Count == 0)
                        {
                            <p class="muted">No persisted items for this view.</p>
                        }
                        else
                        {
                            <ViewRenderer Descriptor="ViewDescriptorHeuristics.DescriptorFor(pin.ViewName, items)"
                                          Items="items" IsLive="false"/>
                        }
                    </div>
                </section>
            }
        </section>
    }

    <section class="live-now-section">
        <h2 class="section-title">Live now</h2>
        @if (_active.Count == 0)
        {
            <EmptyState Title="Nothing running"
                        Description="Active runs appear here as soon as a trigger dispatches a workflow."/>
        }
        else
        {
            <div class="card">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>State</th>
                        <th>Workflow</th>
                        <th>Started</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in _active)
                    {
                        <tr>
                            <td><span class="badge badge-state badge-@run.State.ToLowerInvariant()">@run.State</span></td>
                            <td><a href="runs/@run.RunId" class="cell-strong">@run.WorkflowType</a></td>
                            <td>@TimeText.Relative(run.CreatedUtc)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="recent-runs-section">
        <h2 class="section-title">Recent runs</h2>
        @if (_recent.Count == 0)
        {
            <EmptyState Title="No runs yet"
                        Description="Runs appear here as soon as a task source, schedule, or trigger dispatches a workflow."/>
        }
        else
        {
            <div class="card">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>State</th>
                        <th>Workflow</th>
                        <th>Started</th>
                        <th>Error</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in _recent)
                    {
                        <tr>
                            <td><span class="badge badge-state badge-@run.State.ToLowerInvariant()">@run.State</span></td>
                            <td><a href="runs/@run.RunId" class="cell-strong">@run.WorkflowType</a></td>
                            <td>@TimeText.Relative(run.CreatedUtc)</td>
                            <td class="error-cell">@run.Error</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {

    private const int Window = 50;

    private bool _loaded;
    private bool _denied;
    private string? _error;

    private int _total;
    private List<RunStatus> _all = [];
    private IReadOnlyList<RunStatus> _active = [];
    private List<RunStatus> _recent = [];
    private RunStats? _stats;
    private IReadOnlyList<DashboardPin> _pins = [];
    private readonly Dictionary<Guid, IReadOnlyList<ViewDataRecord>> _pinnedItems = new();

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;

    private int StatOf(string state) => _stats?.ByState.GetValueOrDefault(state) ?? _all.Count(r => r.State == state);

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _timer is not null || _denied)
            return;
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed — polling ends.
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            // Tiles come from the server-side stats endpoint; the recent-window query still
            // drives the live/recent tables.
            _stats = await Core.GetRunStatsAsync(_cts.Token);
            var page = await Core.QueryRunsAsync(new RunQuery(Skip: 0, Take: Window), _cts.Token);
            _denied = false;
            _error = null;
            _total = page.Total;
            _all = page.Items.ToList();
            _active = LiveNow.ActiveOf(_all);
            _recent = _all.Where(r => !LiveNow.IsActive(r.State)).Take(10).ToList();
            await LoadPinsAsync();
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    /// <summary>Loads the caller's pins and each pin's persisted view items (newest-first cards).</summary>
    private async Task LoadPinsAsync()
    {
        _pins = await Core.ListDashboardPinsAsync(_cts.Token);
        foreach (var pin in _pins)
        {
            var page = await Core.GetRunViewsAsync(pin.RunId, pin.ViewName, ct: _cts.Token);
            _pinnedItems[pin.Id] = page.Items
                .Select(i => new ViewDataRecord
                {
                    Id = Guid.NewGuid(),
                    WorkflowInstanceId = pin.RunId,
                    ViewName = i.ViewName,
                    Sequence = i.Sequence,
                    PayloadJson = i.PayloadJson,
                    TimestampUtc = i.TimestampUtc
                })
                .ToList();
        }
    }

    private async Task UnpinAsync(Guid pinId)
    {
        try
        {
            await Core.UnpinDashboardViewAsync(pinId, _cts.Token);
            _pins = _pins.Where(p => p.Id != pinId).ToList();
            _pinnedItems.Remove(pinId);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }

}
