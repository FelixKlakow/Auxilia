@page "/admin"
@attribute [Authorize]
@inject ICoreClient Core
@inject StepUpFlow StepUp
@inject NavigationManager Navigation

<PageTitle>Principals — Auxilia</PageTitle>

<PageHeader Title="Principals"
            Subtitle="Everyone — and everything — that can act on this platform: people, services, and AI agents."/>

@if (!_loaded)
{
    <LoadingState Rows="8"/>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    <StepUpPrompt Flow="StepUp" Busy="_busy" OnConfirm="ConfirmStepUpAsync"
                  Reason="This change affects administrator rights or disables a principal — re-enter YOUR credential (password or API key); the elevation then holds for a few minutes of work."/>
    @if (_createdApiKey is not null)
    {
        <div class="panel success">
            API key for the new principal — shown once, copy it now:
            <code class="api-key">@_createdApiKey</code>
        </div>
    }

    <form class="toolbar" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
        <label>
            Kind
            <select @bind="_kind">
                <option value="">any</option>
                <option value="Human">Human</option>
                <option value="AiAgent">AiAgent</option>
                <option value="Service">Service</option>
            </select>
        </label>
        <label>
            Status
            <select @bind="_enabled">
                <option value="">any</option>
                <option value="true">enabled</option>
                <option value="false">disabled</option>
            </select>
        </label>
        <label>
            Search
            <input @bind="_search" @bind:event="oninput" placeholder="name / subject"/>
        </label>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-primary">Apply</button>
            @if (HasFilters)
            {
                <button type="button" class="btn btn-secondary" @onclick="ClearFiltersAsync">Clear filters</button>
            }
        </div>
    </form>

    <section class="card">
        <div class="card-header">
            <h2>Principals</h2>
        </div>
        @if (_principals.Count == 0)
        {
            <div class="card-body">
                <p class="muted view-empty">No principals match the current filter.</p>
                @if (HasFilters)
                {
                    <div class="button-row detail-actions">
                        <button class="btn btn-secondary btn-sm" @onclick="ClearFiltersAsync">Clear filters</button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-scroll">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Kind</th>
                    <th>Status</th>
                    <th>Roles</th>
                    <th>Tags</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var principal in _principals)
                {
                    var directRoles = principal.Roles.Where(r => r.Source == "Direct").Select(r => r.RoleName).ToList();
                    var held = principal.Roles.Select(r => r.RoleName).ToHashSet(StringComparer.Ordinal);
                    var assignable = BuiltInRoles.Except(held).ToList();
                    <tr>
                        <td>
                            <span class="cell-strong">@principal.DisplayName</span>
                            @if (principal.ExternalSubject is { Length: > 0 } subject)
                            {
                                <span class="cell-sub">@subject</span>
                            }
                        </td>
                        <td>@principal.Kind</td>
                        <td>
                            <span class="badge badge-state @(IsActive(principal) ? "badge-success" : "badge-cancelled")">
                                @principal.Status
                            </span>
                        </td>
                        <td>
                            @foreach (var role in principal.Roles.OrderBy(r => r.RoleName))
                            {
                                <span class="badge badge-role" title="@role.Source">
                                    @role.RoleName
                                    @if (role.Source == "Direct")
                                    {
                                        @if (_confirmRevoke == (principal.Id, role.RoleName))
                                        {
                                            <button class="chip-x" title="Confirm revoking this role"
                                                    @onclick="() => RevokeRoleAsync(principal.Id, role.RoleName)">revoke?</button>
                                        }
                                        else
                                        {
                                            <button class="chip-x" title="Revoke role"
                                                    @onclick="() => Arm(principal.Id, role.RoleName)">✕</button>
                                        }
                                    }
                                </span>
                            }
                        </td>
                        <td>
                            @foreach (var tag in principal.Tags.OrderBy(t => t, StringComparer.OrdinalIgnoreCase))
                            {
                                <span class="badge badge-tag">
                                    @tag
                                    <button class="chip-x" title="Remove tag"
                                            @onclick="() => RemoveTagAsync(principal, tag)">✕</button>
                                </span>
                            }
                            <span class="tag-add">
                                <input class="input-inline" placeholder="add tag"
                                       @bind="_tagInputs[principal.Id]" @bind:event="oninput"/>
                                <button class="btn btn-secondary btn-sm" @onclick="() => AddTagAsync(principal)"
                                        disabled="@(_busy || string.IsNullOrWhiteSpace(TagInputOf(principal.Id)))">Add</button>
                            </span>
                        </td>
                        <td>
                            <div class="cell-actions">
                                @if (assignable.Count > 0)
                                {
                                    <select class="select-inline" @bind="_roleSelections[principal.Id]">
                                        @foreach (var role in assignable)
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    </select>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => AssignRoleAsync(principal.Id)" disabled="@_busy">Assign</button>
                                }
                                else
                                {
                                    <span class="muted">All roles assigned</span>
                                }
                                @if (IsActive(principal))
                                {
                                    <ConfirmButton Label="Disable" Question="Disable this principal?"
                                                   ConfirmLabel="Yes, disable" Busy="_busy"
                                                   OnConfirm="() => SetEnabledAsync(principal.Id, false)"/>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" @onclick="() => SetEnabledAsync(principal.Id, true)" disabled="@_busy">Enable</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            @if (_skip + _principals.Count < _total)
            {
                <div class="card-body table-more">
                    <button class="btn btn-secondary" @onclick="ShowMoreAsync">
                        Show more (@(_skip + _principals.Count) of @_total)
                    </button>
                </div>
            }
        }
    </section>

    <div class="card-row">
        <section class="card">
            <div class="card-header">
                <h2>Create human principal</h2>
                <p class="card-subtitle">A person who signs in with a username and password.</p>
            </div>
            <div class="card-body form-grid">
                <label>Display name <input @bind="_humanDisplayName"/></label>
                <label>Username <input @bind="_humanUsername"/></label>
                <label>Password <input type="password" @bind="_humanPassword"/></label>
                <div class="button-row">
                    <button class="btn btn-primary" @onclick="CreateHumanAsync" disabled="@_busy">Create human</button>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                <h2>Create service principal</h2>
                <p class="card-subtitle">
                    A service (or AI agent — classify with tags) that authenticates with an API key;
                    the key is shown once after creation.
                </p>
            </div>
            <div class="card-body form-grid">
                <label>Display name <input @bind="_aiDisplayName" placeholder="e.g. ci-bot"/></label>
                <div class="button-row">
                    <button class="btn btn-primary" @onclick="CreateAiAsync" disabled="@_busy">Create principal</button>
                </div>
            </div>
        </section>
    </div>
}

@code {

    // The four built-in RBAC roles. The Core exposes no "list roles" endpoint (these are fixed platform
    // roles), so they are enumerated here for the assign dropdown.
    // Served by the Core (GET /api/roles) — no client-side role knowledge.
    private string[] BuiltInRoles = [];

    private const int PageSize = 50;

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private string? _error;
    private string? _createdApiKey;

    private string _kind = "";
    private string _enabled = "";
    private string _search = "";

    private int _skip;
    private int _total;
    private List<PrincipalDto> _principals = [];
    private readonly Dictionary<Guid, string> _roleSelections = new();

    private string _humanDisplayName = "";
    private string _humanUsername = "";
    private string _humanPassword = "";
    private string _aiDisplayName = "";

    private static bool IsActive(PrincipalDto p) => p.Status == "Active";

    private bool HasFilters => _kind.Length > 0 || _enabled.Length > 0 || _search.Length > 0;

    /// <summary>Armed role revocation — a role chip's ✕ asks once before it takes the role away.</summary>
    private (Guid Principal, string Role)? _confirmRevoke;

    private void Arm(Guid principalId, string role) => _confirmRevoke = (principalId, role);

    protected override async Task OnInitializedAsync()
    {
        _kind = PageFilters.Read(Navigation, "kind");
        _enabled = PageFilters.Read(Navigation, "status");
        _search = PageFilters.Read(Navigation, "q");
        try
        {
            BuiltInRoles = (await Core.ListRolesAsync()).Select(r => r.Name).ToArray();
        }
        catch (CoreApiException)
        {
            // The page's own load reports errors; an empty role list only hides the assign menu.
        }
        await LoadAsync(reset: true);
    }

    private Task ApplyAsync()
    {
        PageFilters.Apply(Navigation, new Dictionary<string, string?>
        {
            ["kind"] = _kind,
            ["status"] = _enabled,
            ["q"] = _search
        });
        return LoadAsync(reset: true);
    }

    private Task ClearFiltersAsync()
    {
        _kind = _enabled = _search = "";
        return ApplyAsync();
    }

    private Task ShowMoreAsync() => LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        if (reset)
        {
            _skip = 0;
            _principals = [];
        }

        var query = new PrincipalQuery(
            Kind: Empty(_kind),
            Enabled: _enabled switch { "true" => true, "false" => false, _ => null },
            Search: Empty(_search),
            Skip: _skip,
            Take: PageSize);

        try
        {
            var page = await Core.QueryPrincipalsAsync(query);
            _denied = false;
            _error = null;
            _total = page.Total;
            _principals.AddRange(page.Items);
            _skip += page.Items.Count;
            SyncRoleSelections();
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    private void SyncRoleSelections()
    {
        foreach (var principal in _principals)
        {
            _tagInputs.TryAdd(principal.Id, "");
            var held = principal.Roles.Select(r => r.RoleName).ToHashSet(StringComparer.Ordinal);
            var assignable = BuiltInRoles.Except(held).ToList();
            if (!_roleSelections.TryGetValue(principal.Id, out var selected) || !assignable.Contains(selected))
                _roleSelections[principal.Id] = assignable.FirstOrDefault() ?? "";
        }
    }

    private async Task CreateHumanAsync()
    {
        if (string.IsNullOrWhiteSpace(_humanDisplayName) ||
            string.IsNullOrWhiteSpace(_humanUsername) ||
            string.IsNullOrWhiteSpace(_humanPassword))
        {
            _error = "Display name, username, and password are required.";
            return;
        }

        await MutateAsync(async () =>
        {
            await Core.CreateHumanPrincipalAsync(
                new CreateHumanPrincipalRequest(_humanDisplayName.Trim(), _humanUsername.Trim(), _humanPassword));
            _humanDisplayName = _humanUsername = _humanPassword = "";
        });
    }

    private async Task CreateAiAsync()
    {
        if (string.IsNullOrWhiteSpace(_aiDisplayName))
        {
            _error = "Display name is required.";
            return;
        }

        await MutateAsync(async () =>
        {
            var created = await Core.CreateApiKeyPrincipalAsync(
                new CreateApiKeyPrincipalRequest(_aiDisplayName.Trim()));
            _createdApiKey = created.ApiKey;
            _aiDisplayName = "";
        });
    }

    private Task AssignRoleAsync(Guid id)
        => MutateAsync(async () =>
        {
            if (_roleSelections.TryGetValue(id, out var role) && !string.IsNullOrEmpty(role))
                await Core.AssignPrincipalRoleAsync(id, new AssignRoleRequest(role));
        });

    private Task RevokeRoleAsync(Guid id, string role)
        => MutateAsync(() => Core.RevokePrincipalRoleAsync(id, role));

    private Task SetEnabledAsync(Guid id, bool enabled)
        => MutateAsync(() => Core.SetPrincipalEnabledAsync(id, new SetPrincipalEnabledRequest(enabled)));

    // --- Tags: the admin-managed classification axis (e.g. "ai-agent", a team, an environment).
    private readonly Dictionary<Guid, string> _tagInputs = new();

    private string TagInputOf(Guid id) => _tagInputs.TryGetValue(id, out var value) ? value : "";

    private Task AddTagAsync(PrincipalDto principal)
    {
        var tag = TagInputOf(principal.Id).Trim();
        if (tag.Length == 0 || principal.Tags.Contains(tag, StringComparer.OrdinalIgnoreCase))
        {
            _tagInputs[principal.Id] = "";
            return Task.CompletedTask;
        }
        return MutateAsync(async () =>
        {
            await Core.SetPrincipalTagsAsync(principal.Id,
                new SetPrincipalTagsRequest([.. principal.Tags, tag]));
            _tagInputs[principal.Id] = "";
        });
    }

    private Task RemoveTagAsync(PrincipalDto principal, string tag)
        => MutateAsync(() => Core.SetPrincipalTagsAsync(principal.Id,
            new SetPrincipalTagsRequest(principal.Tags.Where(t => t != tag).ToList())));

    // Step-up re-authentication lives in the shared StepUpFlow: the Core rejects admin-role
    // grant/revoke and principal disable with 'elevation-required' until the operator re-proves
    // their OWN credential, and the flow retries the exact rejected action once elevated.
    private async Task ConfirmStepUpAsync()
    {
        _busy = true;
        try
        {
            if (await StepUp.ConfirmAsync())
                await LoadAsync(reset: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MutateAsync(Func<Task> action)
    {
        _error = null;
        _busy = true;
        _confirmRevoke = null;
        try
        {
            if (await StepUp.RunAsync(action))
                await LoadAsync(reset: true);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? Empty(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

}
