@page "/workflows/new"
@page "/workflows/{ConfigurationId:guid}/edit"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Edit workflow" : "New workflow") — Auxilia</PageTitle>

<div class="page-back"><a href="workflows">← All workflows</a></div>

<PageHeader Title="@(IsEdit ? "Edit workflow configuration" : "New workflow configuration")"
            Subtitle="@(IsEdit
                          ? "Change the bindings and inputs of this configuration. Saving updates it in place."
                          : "Pick a workflow type, bind its capability slots, fill any inputs, then save.")"/>

@if (!_loaded)
{
    <LoadingState Rows="6"/>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else if (_notFound)
{
    <div class="panel denied">Workflow configuration not found.</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }

    @* ---- Step 1: pick the workflow type ---- *@
    <section class="card">
        <div class="card-header">
            <h2><span class="step-number">1</span> Basics</h2>
            <p class="card-subtitle">Name the configuration and choose which workflow type it runs.</p>
        </div>
        <div class="card-body form-grid">
            <label>
                Name
                <input @bind="_name" placeholder="e.g. Nightly code review"/>
            </label>
            <label>
                Workflow type
                <select @bind="SelectedType" disabled="@IsEdit">
                    <option value="">Pick a workflow type…</option>
                    @foreach (var type in _types)
                    {
                        <option value="@type.WorkflowType">
                            @type.WorkflowType@(type.Version.Length > 0 ? $" · v{type.Version}" : "")
                        </option>
                    }
                </select>
                @if (IsEdit)
                {
                    <span class="field-hint">A configuration's workflow type is fixed — create a new configuration to run a different type.</span>
                }
                else if (_types.Count == 0)
                {
                    <span class="field-hint">No workflow types are registered on this platform yet.</span>
                }
            </label>
            <label>
                Scope
                <select @bind="_scope" disabled="@_scopeLocked">
                    <option value="@ResourceScope.Personal">Personal — you and principals/groups you grant</option>
                    @if (_canShareCompanyWide)
                    {
                        <option value="@ResourceScope.Company">Company — every authenticated principal</option>
                    }
                </select>
            </label>
            <label class="check-label">
                <input type="checkbox" @bind="_enabled"/> Enabled
                <span class="field-hint">When disabled, every dispatch of this configuration is rejected.</span>
            </label>
        </div>
    </section>

    @if (string.IsNullOrWhiteSpace(_selectedType))
    {
        <section class="card">
            <div class="card-body">
                <p class="muted">Pick a workflow type above — its capability slots and inputs appear here.</p>
            </div>
        </section>
    }
    else if (_schema is null)
    {
        <section class="card">
            <div class="card-body">
                <p class="field-hint">
                    The platform has no registered schema for <span class="cell-strong">@_selectedType</span> —
                    slots and inputs cannot be shown. Save records the type and package only.
                </p>
            </div>
        </section>
    }
    else
    {
        @* ---- Step 2: bind the capability slots ---- *@
        <section class="card">
            <div class="card-header">
                <h2><span class="step-number">2</span> Slots</h2>
                <p class="card-subtitle">
                    Bind each capability slot: pick a provider, then a connector and/or its settings.
                    Optional slots may be left unbound.
                </p>
            </div>
            <div class="card-body">
                @if (_schema.Slots.Count == 0)
                {
                    <p class="muted">This workflow declares no capability slots.</p>
                }
                @foreach (var slot in _schema.Slots)
                {
                    var edit = EditOf(slot.SlotName);
                    var providers = EligibleProviders(slot);
                    <div class="slot-binding">
                        <div class="slot-binding-header">
                            <div>
                                <span class="cell-strong">@slot.SlotName</span>
                                <span class="type-chip">@(slot.Optional ? "optional" : "required")</span>
                                @if (slot.Contract is { Length: > 0 })
                                {
                                    <span class="type-chip">@slot.Contract</span>
                                }
                                @if (slot.Description is { Length: > 0 })
                                {
                                    <p class="muted slot-description">@slot.Description</p>
                                }
                            </div>
                        </div>
                        @if (IsEnvironmentMultiSlot(slot, providers))
                        {
                            @* A run composes layers onto exactly ONE base, so the base is a choice
                               and the layers follow from it — never a flat list of checkboxes where
                               half are disabled and the user has to read why. *@
                            var bases = BasesOf(providers);
                            var chosenBase = SelectedBase() ?? bases.FirstOrDefault();
                            <div class="environment-slot">
                                <span class="label-micro">Base environment</span>
                                <div class="environment-bases provider-grid">
                                    @foreach (var baseName in bases)
                                    {
                                        <label class="provider-card @(chosenBase == baseName ? "selected" : null)">
                                            <input type="radio" name="@($"env-base-{slot.SlotName}")"
                                                   checked="@(chosenBase == baseName)"
                                                   @onchange="() => SelectBase(edit, baseName)"/>
                                            <span class="provider-name">@baseName</span>
                                            <span class="provider-category">
                                                @providers.Count(p => SupportsBase(p, baseName)) capabilit@(providers.Count(p => SupportsBase(p, baseName)) == 1 ? "y" : "ies")
                                            </span>
                                        </label>
                                    }
                                </div>
                                <span class="label-micro">Capabilities</span>
                                <div class="environment-layers">
                                    @foreach (var provider in providers.Where(p => chosenBase is { } b && SupportsBase(p, b)))
                                    {
                                        <label class="check-label" title="@provider.Description">
                                            <input type="checkbox"
                                                   checked="@edit.MultiProviders.Contains(provider.ProviderType)"
                                                   @onchange="e => ToggleLayer(edit, provider.ProviderType, e.Value is true)"/>
                                            @provider.ProviderType
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                        else if (providers.Count > 0)
                        {
                            <label>
                                Provider
                                <select value="@edit.Provider"
                                        @onchange="e => SetProvider(edit, e.Value?.ToString())">
                                    <option value="">@(slot.Optional ? "— leave unbound —" : "— pick a provider —")</option>
                                    @foreach (var provider in providers)
                                    {
                                        <option value="@provider.ProviderType">
                                            @provider.ProviderType@(provider.Description is { Length: > 0 } ? $" — {provider.Description}" : "")
                                        </option>
                                    }
                                </select>
                            </label>
                            @if (ProviderOf(edit.Provider) is { } selected)
                            {
                                var connectors = EligibleConnectors(selected);
                                @if (connectors.Count > 0)
                                {
                                    <label>
                                        Connector
                                        <select value="@edit.ConnectorId"
                                                @onchange="e => edit.ConnectorId = Str(e.Value)">
                                            <option value="">— no connector —</option>
                                            @foreach (var connector in connectors)
                                            {
                                                <option value="@connector.Id">@connector.Name (@connector.ProviderType)</option>
                                            }
                                        </select>
                                    </label>
                                }
                                @foreach (var descriptor in selected.Descriptors.Where(d => !d.Disabled))
                                {
                                    <label>
                                        @descriptor.Label@(descriptor.Required ? " *" : "")
                                        @if (descriptor.Choices is { Count: > 0 })
                                        {
                                            <select value="@SettingOf(edit, descriptor)"
                                                    @onchange="e => edit.Settings[descriptor.Key] = Str(e.Value)">
                                                <option value="">—</option>
                                                @foreach (var choice in descriptor.Choices)
                                                {
                                                    <option value="@choice">@choice</option>
                                                }
                                            </select>
                                        }
                                        else if (descriptor.Kind is "Boolean")
                                        {
                                            <input type="checkbox"
                                                   checked="@(SettingOf(edit, descriptor) == "true")"
                                                   @onchange="e => edit.Settings[descriptor.Key] = Bool(e.Value)"/>
                                        }
                                        else
                                        {
                                            <input type="@(descriptor.Kind is "Secret" ? "password" : "text")"
                                                   value="@SettingOf(edit, descriptor)"
                                                   @onchange="e => edit.Settings[descriptor.Key] = Str(e.Value)"/>
                                        }
                                        @if (descriptor.HelpText is { Length: > 0 })
                                        {
                                            <span class="field-hint">@descriptor.HelpText</span>
                                        }
                                    </label>
                                }
                            }
                        }
                        else
                        {
                            @* No catalog entry matches — the plain connector binding stays available. *@
                            <label>
                                Connector
                                <select value="@edit.ConnectorId"
                                        @onchange="e => edit.ConnectorId = Str(e.Value)">
                                    <option value="">@(slot.Optional ? "— leave unbound —" : "— pick a connector —")</option>
                                    @foreach (var connector in _connectors)
                                    {
                                        <option value="@connector.Id">@connector.Name (@connector.ProviderType)</option>
                                    }
                                </select>
                                @if (_connectors.Count == 0)
                                {
                                    <span class="field-hint">No connectors exist yet — create one on the Connectors page.</span>
                                }
                            </label>
                        }
                    </div>
                }
            </div>
        </section>

        @* ---- Inputs (rendered by declared kind, never by name) ---- *@
        @if (_schema.Inputs.Count > 0)
        {
            <section class="card">
                <div class="card-header">
                    <h2><span class="step-number">3</span> Inputs</h2>
                    <p class="card-subtitle">Values passed into every run of this configuration.</p>
                </div>
                <div class="card-body form-grid">
                    @foreach (var input in _schema.Inputs)
                    {
                        <label>
                            @input.Label@(input.Required ? " *" : " (optional)")
                            @if (input.Kind == InputKinds.Choice && input.Choices is { Count: > 0 })
                            {
                                <select value="@_inputs.GetValueOrDefault(input.Name, "")"
                                        @onchange="e => _inputs[input.Name] = Str(e.Value)">
                                    <option value="">—</option>
                                    @foreach (var choice in input.Choices)
                                    {
                                        <option value="@choice">@(input.ChoiceLabels?.GetValueOrDefault(choice) ?? choice)</option>
                                    }
                                </select>
                            }
                            else if (input.Kind == InputKinds.Boolean)
                            {
                                <input type="checkbox"
                                       checked="@(_inputs.GetValueOrDefault(input.Name) == "true")"
                                       @onchange="e => _inputs[input.Name] = Bool(e.Value)"/>
                            }
                            else if (input.Kind == InputKinds.Multiline)
                            {
                                <textarea value="@_inputs.GetValueOrDefault(input.Name, "")"
                                          @onchange="e => _inputs[input.Name] = Str(e.Value)"></textarea>
                            }
                            else if (input.Kind == InputKinds.Number)
                            {
                                <input type="number" value="@_inputs.GetValueOrDefault(input.Name, "")"
                                       @onchange="e => _inputs[input.Name] = Str(e.Value)"/>
                            }
                            else
                            {
                                <input value="@_inputs.GetValueOrDefault(input.Name, "")"
                                       @onchange="e => _inputs[input.Name] = Str(e.Value)"/>
                            }
                            @if (input.Description is { Length: > 0 })
                            {
                                <span class="field-hint">@input.Description</span>
                            }
                        </label>
                    }
                </div>
            </section>
        }

        @* ---- Plan: what a run of this configuration dispatches ---- *@
        <section class="card">
            <div class="card-header">
                <h2><span class="step-number">4</span> Plan</h2>
                <p class="card-subtitle">What a run of this configuration will dispatch.</p>
            </div>
            <div class="card-body">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Slot</th>
                        <th>Binding</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var slot in _schema.Slots)
                    {
                        <tr>
                            <td class="cell-strong">@slot.SlotName</td>
                            <td>@PlanOf(slot)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                @if (SelectedBase() is { } environmentBase)
                {
                    <p class="field-hint">Environment base: @environmentBase</p>
                }
            </div>
        </section>
    }

    <div class="button-row editor-actions">
        <button class="btn btn-primary" disabled="@(_busy || !CanSave)" @onclick="SaveAsync">
            @(IsEdit ? "Save changes" : "Create configuration")
        </button>
        <a class="btn btn-secondary" href="workflows">Cancel</a>
    </div>
    @if (IsEdit && _scopeLocked)
    {
        <p class="field-hint">
            Scope is fixed after creation — share this configuration from the Workflows list instead.
        </p>
    }
}

@code {

    [Parameter]
    public Guid? ConfigurationId { get; set; }

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private bool _notFound;
    private string? _error;

    private string _name = "";
    private string _selectedType = "";
    private bool _enabled = true;
    private string _scope = ResourceScope.Personal;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _canShareCompanyWide;

    private List<WorkflowTypeDto> _types = [];
    private List<Connector> _connectors = [];
    private List<ProviderCatalogEntry> _catalog = [];
    private WorkflowSchemaDto? _schema;

    /// <summary>Editing state of one slot: a provider + connector + settings, or (for
    /// multi-capability environment slots) a set of layer provider types.</summary>
    private sealed class SlotEdit
    {
        public string Provider = "";
        public string ConnectorId = "";
        public Dictionary<string, string> Settings { get; } = new(StringComparer.Ordinal);
        public HashSet<string> MultiProviders { get; } = new(StringComparer.Ordinal);
    }

    private readonly Dictionary<string, SlotEdit> _slotEdits = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _inputs = new(StringComparer.Ordinal);

    private readonly CancellationTokenSource _cts = new();

    private bool IsEdit => ConfigurationId is not null;

    /// <summary>The update contract carries no scope, so an existing configuration keeps its own.</summary>
    private bool _scopeLocked;

    private bool CanSave
        => !string.IsNullOrWhiteSpace(_name)
           && !string.IsNullOrWhiteSpace(_selectedType);

    private string SelectedType
    {
        get => _selectedType;
        set => _ = OnTypeChangedAsync(value);
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _canShareCompanyWide = ConsoleAuthenticationStateProvider.Can(
                (await AuthState).User, PermissionActions.WorkflowConfigurationManage);
        try
        {
            var types = await Core.ListWorkflowTypesAsync(new WorkflowTypeQuery(Take: 200), _cts.Token);
            _types = types.Items.ToList();
            var connectors = await Core.QueryConnectorsAsync(new ConnectorQuery(Take: 200), _cts.Token);
            _connectors = connectors.Items.ToList();
            var catalog = await Core.QueryProviderCatalogAsync(new ProviderCatalogQuery(Available: true, Take: 200), _cts.Token);
            _catalog = catalog.Items.ToList();

            if (ConfigurationId is { } id)
            {
                var configuration = await Core.GetConfigurationAsync(id, _cts.Token);
                if (configuration is null)
                    _notFound = true;
                else
                    await PrefillFromAsync(configuration);
            }
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    private async Task PrefillFromAsync(RunConfiguration configuration)
    {
        _name = configuration.Name;
        _selectedType = configuration.WorkflowType;
        _enabled = configuration.Enabled;
        _scope = configuration.Scope;
        _scopeLocked = true;
        foreach (var (key, value) in configuration.Context)
            _inputs[key] = value;
        await LoadSchemaAsync(configuration.WorkflowType);
        foreach (var group in configuration.SlotBindings.GroupBy(b => b.SlotName, StringComparer.Ordinal))
        {
            var edit = EditOf(group.Key);
            var slot = _schema?.Slots.FirstOrDefault(s => s.SlotName == group.Key);
            if (slot?.AllowMultiple == true || group.Count() > 1)
            {
                foreach (var binding in group)
                {
                    if (binding.ProviderType is { Length: > 0 } provider)
                        edit.MultiProviders.Add(provider);
                }
                continue;
            }
            var single = group.First();
            edit.Provider = single.ProviderType ?? "";
            edit.ConnectorId = single.ConnectorId?.ToString() ?? "";
            foreach (var (key, value) in single.Settings ?? new Dictionary<string, string>())
                edit.Settings[key] = value;
        }
    }

    private async Task OnTypeChangedAsync(string workflowType)
    {
        _selectedType = workflowType;
        _slotEdits.Clear();
        _inputs.Clear();
        if (string.IsNullOrWhiteSpace(workflowType))
        {
            _schema = null;
            return;
        }
        await LoadSchemaAsync(workflowType);
        StateHasChanged();
    }

    private async Task LoadSchemaAsync(string workflowType)
    {
        try
        {
            _schema = await Core.GetWorkflowSchemaAsync(workflowType, _cts.Token);
            if (_schema is not null)
            {
                foreach (var input in _schema.Inputs)
                    _inputs.TryAdd(input.Name, input.DefaultValue ?? "");
            }
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
            _schema = null;
        }
    }

    private static string Str(object? value) => value?.ToString() ?? "";

    private static string Bool(object? value) => value is true ? "true" : "false";

    private SlotEdit EditOf(string slotName)
    {
        if (!_slotEdits.TryGetValue(slotName, out var edit))
            _slotEdits[slotName] = edit = new SlotEdit();
        return edit;
    }

    // --- Provider narrowing ---

    /// <summary>Available catalog providers admitted by the slot's declared narrowing and contract.</summary>
    private List<ProviderCatalogEntry> EligibleProviders(WorkflowSlotDto slot)
        => _catalog
            .Where(p => slot.ProviderTypes is null || slot.ProviderTypes.Contains(p.ProviderType))
            .Where(p => slot.Contract is null or "" || p.Contracts.Contains(slot.Contract))
            .OrderBy(p => p.ProviderType, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private ProviderCatalogEntry? ProviderOf(string providerType)
        => providerType is { Length: > 0 }
            ? _catalog.FirstOrDefault(p => p.ProviderType == providerType)
            : null;

    /// <summary>
    /// Connectors that can credential the selected provider: its own instances, plus (when it
    /// declares a required credential contract) connectors of any provider serving that contract.
    /// </summary>
    private List<Connector> EligibleConnectors(ProviderCatalogEntry provider)
    {
        var credentialProviders = provider.RequiredCredentialContract is { Length: > 0 } contract
            ? _catalog.Where(p => p.Contracts.Contains(contract)).Select(p => p.ProviderType).ToHashSet(StringComparer.Ordinal)
            : null;
        return _connectors
            .Where(c => c.ProviderType == provider.ProviderType || credentialProviders?.Contains(c.ProviderType) == true)
            .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void SetProvider(SlotEdit edit, string? providerType)
    {
        edit.Provider = providerType ?? "";
        edit.ConnectorId = "";
        edit.Settings.Clear();
        // Seed the provider's declared defaults so the plan reflects what will dispatch.
        if (ProviderOf(edit.Provider) is { } provider)
        {
            foreach (var descriptor in provider.Descriptors.Where(d => !d.Disabled && d.DefaultValue is { Length: > 0 }))
                edit.Settings[descriptor.Key] = descriptor.DefaultValue!;
        }
    }

    private static string SettingOf(SlotEdit edit, ProviderSettingDescriptor descriptor)
        => edit.Settings.GetValueOrDefault(descriptor.Key) ?? descriptor.DefaultValue ?? "";

    // --- Environment slots (multi-capability, one base per run) ---

    private static bool IsEnvironmentMultiSlot(WorkflowSlotDto slot, List<ProviderCatalogEntry> providers)
        => slot.AllowMultiple && providers.Count > 0 && providers.All(p => p.ComposesEnvironment);

    /// <summary>The bases a layer can compose on; an undeclared set reads as linux-only.</summary>
    private static IReadOnlyList<string> BasesOf(ProviderCatalogEntry provider)
        => provider.EnvironmentBases is { Count: > 0 } refs
            ? refs.Select(r => r.Name).ToList()
            : [EnvironmentBases.Linux];

    private static bool SupportsBase(ProviderCatalogEntry provider, string baseName)
        => BasesOf(provider).Contains(baseName, StringComparer.OrdinalIgnoreCase);

    private static List<string> BasesOf(IEnumerable<ProviderCatalogEntry> providers)
        => providers.SelectMany(BasesOf).Distinct(StringComparer.Ordinal).OrderBy(b => b, StringComparer.Ordinal).ToList();

    /// <summary>Switching base drops the layers that cannot compose on it; multi-base layers stay.</summary>
    private void SelectBase(SlotEdit edit, string environmentBase)
    {
        foreach (var providerType in edit.MultiProviders.ToList())
        {
            if (ProviderOf(providerType) is { } provider && !SupportsBase(provider, environmentBase))
                edit.MultiProviders.Remove(providerType);
        }
        _pinnedBase = environmentBase;
    }

    /// <summary>The base the operator picked, remembered while no layer is selected yet.</summary>
    private string? _pinnedBase;

    /// <summary>
    /// The base the current selection composes on: the intersection of every selected layer's
    /// base set — preferring the operator's pick when it is still viable.
    /// </summary>
    private string? SelectedBase()
    {
        HashSet<string>? shared = null;
        foreach (var edit in _slotEdits.Values)
        {
            foreach (var providerType in edit.MultiProviders)
            {
                if (ProviderOf(providerType) is not { } provider)
                    continue;
                var bases = BasesOf(provider).ToHashSet(StringComparer.OrdinalIgnoreCase);
                if (shared is null)
                    shared = bases;
                else
                    shared.IntersectWith(bases);
            }
        }
        if (shared is null)
            return _pinnedBase;
        if (_pinnedBase is { } pinned && shared.Contains(pinned))
            return pinned;
        return shared.OrderBy(b => b, StringComparer.Ordinal).FirstOrDefault() ?? _pinnedBase;
    }

    private void ToggleLayer(SlotEdit edit, string providerType, bool selected)
    {
        if (selected)
            edit.MultiProviders.Add(providerType);
        else
            edit.MultiProviders.Remove(providerType);
    }

    // --- Plan ---

    private string PlanOf(WorkflowSlotDto slot)
    {
        var edit = EditOf(slot.SlotName);
        if (edit.MultiProviders.Count > 0)
            return string.Join(", ", edit.MultiProviders.OrderBy(p => p, StringComparer.OrdinalIgnoreCase));
        var parts = new List<string>();
        if (edit.Provider is { Length: > 0 })
            parts.Add(edit.Provider);
        if (Guid.TryParse(edit.ConnectorId, out var connectorId)
            && _connectors.FirstOrDefault(c => c.Id == connectorId) is { } connector)
            parts.Add($"via {connector.Name}");
        var settings = edit.Settings.Where(s => !string.IsNullOrWhiteSpace(s.Value)).Select(s => s.Key).ToList();
        if (settings.Count > 0)
            parts.Add($"({string.Join(", ", settings)})");
        return parts.Count > 0 ? string.Join(" ", parts) : slot.Optional ? "unbound" : "⚠ unbound (required)";
    }

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var slotBindings = new List<SlotBinding>();
            foreach (var (slotName, edit) in _slotEdits)
            {
                foreach (var layer in edit.MultiProviders.OrderBy(p => p, StringComparer.OrdinalIgnoreCase))
                    slotBindings.Add(new SlotBinding(slotName, ProviderType: layer));
                if (edit.MultiProviders.Count > 0)
                    continue;
                var settings = edit.Settings
                    .Where(s => !string.IsNullOrWhiteSpace(s.Value))
                    .ToDictionary(s => s.Key, s => s.Value, StringComparer.Ordinal);
                var connectorId = Guid.TryParse(edit.ConnectorId, out var parsed) ? parsed : (Guid?)null;
                if (edit.Provider is { Length: > 0 } || connectorId is not null || settings.Count > 0)
                {
                    slotBindings.Add(new SlotBinding(
                        slotName,
                        ProviderType: edit.Provider is { Length: > 0 } ? edit.Provider : null,
                        ConnectorId: connectorId,
                        Settings: settings.Count > 0 ? settings : null));
                }
            }

            var context = _inputs
                .Where(i => !string.IsNullOrWhiteSpace(i.Value))
                .ToDictionary(i => i.Key, i => i.Value, StringComparer.Ordinal);

            // Editing UPDATES the configuration in place — every run, trigger, and shared link that
            // points at this id keeps pointing at it. Only the "new" route creates.
            if (ConfigurationId is { } id)
            {
                await Core.UpdateConfigurationAsync(id, new UpdateRunConfiguration(
                    Name: _name.Trim(),
                    Context: context,
                    SlotBindings: slotBindings,
                    Enabled: _enabled), _cts.Token);
            }
            else
            {
                await Core.CreateConfigurationAsync(new CreateRunConfiguration(
                    Name: _name.Trim(),
                    WorkflowType: _selectedType.Trim(),
                    Context: context.Count == 0 ? null : context,
                    SlotBindings: slotBindings.Count == 0 ? null : slotBindings,
                    Enabled: _enabled,
                    Scope: _scope), _cts.Token);
            }
            Navigation.NavigateTo("workflows");
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}
