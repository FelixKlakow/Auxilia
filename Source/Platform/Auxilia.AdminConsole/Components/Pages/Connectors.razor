@page "/connectors"
@attribute [Authorize]
@implements IDisposable
@inject ICoreClient Core
@inject NavigationManager Navigation
@inject StepUpFlow StepUp

<PageTitle>Connectors — Auxilia</PageTitle>

<PageHeader Title="Connectors"
            Subtitle="Credential-bearing provider accounts Auxilia can act as. Secrets are encrypted at rest in the Core and never shown back."/>

@if (!_loaded)
{
    <LoadingState Rows="5"/>
}
else if (_denied)
{
    <div class="panel denied">Access denied: @_error</div>
}
else
{
    @if (_error is { Length: > 0 })
    {
        <div class="panel denied">@_error</div>
    }
    <NoticePanel Message="@_notice" OnDismiss="() => _notice = null"/>

    <StepUpPrompt Flow="StepUp" Busy="_busy" OnConfirm="ConfirmStepUpAsync"
                  Reason="Changing a stored credential is privileged — re-enter YOUR credential (password or API key)."/>

    <form class="toolbar" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
        <label>
            Provider type
            <input @bind="_providerFilter" @bind:event="oninput" placeholder="e.g. azure-devops"/>
        </label>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-secondary">Apply</button>
            @if (_providerFilter.Length > 0)
            {
                <button type="button" class="btn btn-secondary" @onclick="ClearFiltersAsync">Clear filters</button>
            }
            <button type="button" class="btn btn-secondary" @onclick="RefreshAsync">Refresh</button>
            <button type="button" class="btn btn-primary" @onclick="StartCreate">New connector</button>
        </div>
    </form>

    @if (_connectors.Count == 0)
    {
        @if (_providerFilter.Length > 0)
        {
            <EmptyState Title="No connectors match this provider"
                        Description="No connector on this platform uses that provider type.">
                <div class="empty-actions">
                    <button class="btn btn-secondary" @onclick="ClearFiltersAsync">Clear filters</button>
                </div>
            </EmptyState>
        }
        else
        {
            <EmptyState Title="No connectors"
                        Description="Create a connector to give a workflow a provider credential to act as.">
                <div class="empty-actions">
                    <button class="btn btn-primary" @onclick="StartCreate">Create your first connector</button>
                </div>
            </EmptyState>
        }
    }
    else
    {
        <div class="connector-grid">
            @foreach (var connector in _connectors)
            {
                <article class="connector-card">
                    <span class="connector-icon">
                        <ConnectorIcon ProviderType="@connector.ProviderType"/>
                    </span>
                    <div class="connector-main">
                        <span class="connector-name">@connector.Name</span>
                        <span class="connector-provider">@connector.ProviderType</span>
                        <span class="connector-badges">
                            <span class="badge badge-scope">@connector.Scope</span>
                            <span class="muted">updated @TimeText.Relative(connector.UpdatedUtc)</span>
                        </span>
                        <span class="connector-settings">
                            @(connector.SettingKeys.Count == 0
                                ? "no stored settings"
                                : string.Join(", ", connector.SettingKeys))
                        </span>
                        <div class="connector-actions">
                            <button class="btn btn-secondary btn-sm"
                                    @onclick="() => ShowDetailAsync(connector.Id)">Details</button>
                            @if (connector.Scope == ResourceScope.Personal)
                            {
                                <button class="btn btn-secondary btn-sm"
                                        @onclick="() => StartSharing(connector)">Sharing</button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
        @if (_connectors.Count < _total)
        {
            <div class="table-more">
                <button class="btn btn-secondary" disabled="@_loadingMore" @onclick="ShowMoreAsync">
                    @(_loadingMore ? "Loading…" : $"Show more ({_connectors.Count} of {_total})")
                </button>
            </div>
        }
    }

    <Drawer Open="_detail is not null" Title="@(_detail?.Name ?? "Connector")"
            Subtitle="What the Core stores for this connector. Secret values are never returned."
            OnClose="() => _detail = null">
        @if (_detail is { } detail)
        {
            <dl class="meta-grid">
                <div><dt>Provider</dt><dd>@detail.ProviderType</dd></div>
                <div><dt>Scope</dt><dd>@detail.Scope</dd></div>
                <div>
                    <dt>Stored setting keys</dt>
                    <dd class="cell-mono">@(detail.SettingKeys.Count == 0 ? "— (no settings)" : string.Join(", ", detail.SettingKeys))</dd>
                </div>
                @if (detail.Grants is { Count: > 0 } grants)
                {
                    <div>
                        <dt>Shared with</dt>
                        <dd>@string.Join(", ", grants.Select(g => $"{g.Kind}:{g.Id}"))</dd>
                    </div>
                }
            </dl>
        }
    </Drawer>

    <Drawer Open="_draft is not null" Title="New connector"
            Subtitle="The credential is encrypted at rest and never returned by any read."
            OnClose="() => _draft = null">
        <ChildContent>
        <p class="field-hint">
            Guided OAuth sign-in flows are a follow-up: for now paste or enter the token/secret
            directly — it is written once, encrypted, and only its setting keys are ever read back.
        </p>
        @if (_draft is { } draft)
        {
            <div class="form-grid">
                <label>
                    Name
                    <input @bind="draft.Name" placeholder="e.g. Team Azure DevOps"/>
                </label>
                <label>
                    Provider type
                    <input @bind="draft.ProviderType" list="provider-types" placeholder="e.g. azure-devops"
                           @bind:after="SeedFromCatalog"/>
                    <datalist id="provider-types">
                        @foreach (var provider in _catalog)
                        {
                            <option value="@provider.ProviderType"></option>
                        }
                    </datalist>
                </label>
                <label>
                    Scope
                    <select @bind="draft.Scope">
                        <option value="@ResourceScope.Personal">Personal — you and principals you share with</option>
                        @if (_canShareCompanyWide)
                        {
                            <option value="@ResourceScope.Company">Company — any authenticated principal</option>
                        }
                    </select>
                </label>
            </div>

            <div class="setting-grid form-grid">
                @foreach (var field in draft.Fields)
                {
                    <label>
                        @(field.Label is { Length: > 0 } ? field.Label : field.Key)
                        @if (field.Secret)
                        {
                            <span class="badge badge-secret">secret</span>
                            <input type="password" @bind="field.Value" placeholder="@(field.Required ? "required" : "")"/>
                        }
                        else
                        {
                            <input @bind="field.Value" placeholder="@(field.Required ? "required" : "")"/>
                        }
                        @if (field.Help is { Length: > 0 })
                        {
                            <span class="field-hint">@field.Help</span>
                        }
                    </label>
                }
            </div>
            <div class="button-row detail-actions">
                <button class="btn btn-secondary btn-sm" @onclick="AddField">Add setting</button>
            </div>
        }
        </ChildContent>
        <Footer>
            <button class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync">Create connector</button>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _draft = null">Cancel</button>
        </Footer>
    </Drawer>

    <Drawer Open="_sharing is not null" Title="@($"Sharing — {_sharing?.ConnectorName}")"
            Subtitle="Who besides the owner may see and use this personal connector."
            OnClose="() => _sharing = null">
        <ChildContent>
            @if (_sharing is { } panel)
            {
                <SharingEditor Rows="panel.Grants"
                               Hint="A personal connector is yours alone until you share it. Adding a subject lets that principal or group bind this credential in their own workflows."
                               OpenLabel="Not shared — only you can use this connector."/>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveSharingAsync">Save sharing</button>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _sharing = null">Cancel</button>
        </Footer>
    </Drawer>
}

@code {

    private const int PageSize = 50;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _canShareCompanyWide;

    private bool _loaded;
    private bool _denied;
    private bool _busy;
    private bool _loadingMore;
    private string? _error;
    private string? _notice;

    private string _providerFilter = "";

    private int _total;
    private List<Connector> _connectors = [];
    private List<ProviderCatalogEntry> _catalog = [];

    private Connector? _detail;
    private ConnectorDraft? _draft;
    private SharingDraft? _sharing;

    private readonly CancellationTokenSource _cts = new();

    private sealed class ConnectorDraft
    {
        public string Name = "";
        public string ProviderType = "";
        public string Scope = ResourceScope.Personal;
        public List<SettingField> Fields = [];
    }

    private sealed class SettingField
    {
        public string Key = "";
        public string Label = "";
        public bool Secret;
        public bool Required;
        public string? Help;
        public string Value = "";
    }

    private sealed class SharingDraft
    {
        public Guid ConnectorId;
        public string ConnectorName = "";
        public List<GrantRow> Grants = [];
    }

    protected override async Task OnInitializedAsync()
    {
        _providerFilter = PageFilters.Read(Navigation, "provider");
        if (AuthState is not null)
            _canShareCompanyWide = ConsoleAuthenticationStateProvider.Can(
                (await AuthState).User, PermissionActions.SlotConfigWrite);
        await LoadCatalogAsync();
        await LoadAsync(reset: true);
    }

    private Task ApplyAsync()
    {
        PageFilters.Apply(Navigation, new Dictionary<string, string?> { ["provider"] = _providerFilter });
        return LoadAsync(reset: true);
    }

    private Task ClearFiltersAsync()
    {
        _providerFilter = "";
        return ApplyAsync();
    }

    private Task RefreshAsync() => LoadAsync(reset: true);

    private async Task ShowMoreAsync()
    {
        _loadingMore = true;
        try
        {
            await LoadAsync(reset: false);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task LoadAsync(bool reset)
    {
        if (reset)
            _connectors = [];

        var query = new ConnectorQuery(
            ProviderType: string.IsNullOrWhiteSpace(_providerFilter) ? null : _providerFilter.Trim(),
            Skip: _connectors.Count,
            Take: PageSize);

        try
        {
            var page = await Core.QueryConnectorsAsync(query, _cts.Token);
            _denied = false;
            _error = null;
            _total = page.Total;
            _connectors.AddRange(page.Items);
        }
        catch (CoreApiException ex)
        {
            _denied = ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized;
            _error = ex.ErrorDetail ?? ex.Message;
        }

        _loaded = true;
    }

    /// <summary>Best-effort: the create form is descriptor-driven when the catalog is readable.</summary>
    private async Task LoadCatalogAsync()
    {
        try
        {
            var page = await Core.QueryProviderCatalogAsync(new ProviderCatalogQuery(Take: 200), _cts.Token);
            _catalog = page.Items.ToList();
        }
        catch (CoreApiException)
        {
            _catalog = [];
        }
    }

    private async Task ShowDetailAsync(Guid id)
    {
        _error = null;
        _draft = null;
        _sharing = null;
        try
        {
            _detail = await Core.GetConnectorAsync(id, _cts.Token);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
    }

    private void StartCreate()
    {
        _error = _notice = null;
        _detail = null;
        _sharing = null;
        _draft = new ConnectorDraft();
    }

    /// <summary>Prefill the settings from the catalog descriptor when the typed provider is known.</summary>
    private void SeedFromCatalog()
    {
        if (_draft is null)
            return;
        var entry = _catalog.FirstOrDefault(p =>
            string.Equals(p.ProviderType, _draft.ProviderType, StringComparison.OrdinalIgnoreCase));
        if (entry is null)
            return;
        _draft.Fields = entry.Descriptors
            .Where(d => !d.Disabled)
            .Select(d => new SettingField
            {
                Key = d.Key,
                Label = d.Label,
                Secret = string.Equals(d.Kind, "Secret", StringComparison.OrdinalIgnoreCase),
                Required = d.Required,
                Help = d.HelpText,
                Value = d.DefaultValue ?? ""
            })
            .ToList();
    }

    private void AddField() => _draft?.Fields.Add(new SettingField { Secret = true });

    private async Task CreateAsync()
    {
        if (_draft is not { } draft)
            return;
        _error = _notice = null;
        _busy = true;
        try
        {
            var settings = draft.Fields
                .Where(f => f.Key.Length > 0)
                .ToDictionary(f => f.Key, f => f.Value, StringComparer.Ordinal);
            var created = await Core.CreateConnectorAsync(
                new CreateConnector(draft.Name, draft.ProviderType, settings, draft.Scope), _cts.Token);
            _notice = $"Connector \"{created.Name}\" created.";
            _draft = null;
            await LoadAsync(reset: true);
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartSharing(Connector connector)
    {
        _error = _notice = null;
        _detail = null;
        _draft = null;
        _sharing = new SharingDraft
        {
            ConnectorId = connector.Id,
            ConnectorName = connector.Name,
            Grants = GrantRows.From(connector.Grants)
        };
    }

    private async Task SaveSharingAsync()
    {
        if (_sharing is not { } panel)
            return;
        _error = _notice = null;
        _busy = true;
        try
        {
            var grants = GrantRows.ToGrants(panel.Grants);
            if (await StepUp.RunAsync(() =>
                    Core.SetConnectorGrantsAsync(panel.ConnectorId, new SetConnectorGrants(grants), _cts.Token)))
            {
                _notice = $"Sharing for \"{panel.ConnectorName}\" saved.";
                _sharing = null;
                await LoadAsync(reset: true);
            }
        }
        catch (CoreApiException ex)
        {
            _error = ex.ErrorDetail ?? ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Retries the mutation the Core rejected, once the operator has re-authenticated.</summary>
    private async Task ConfirmStepUpAsync()
    {
        _busy = true;
        try
        {
            if (await StepUp.ConfirmAsync())
            {
                _sharing = null;
                await LoadAsync(reset: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}
