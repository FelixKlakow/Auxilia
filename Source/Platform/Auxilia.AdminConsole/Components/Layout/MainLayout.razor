@inherits LayoutComponentBase
@using System.Security.Claims
@using Auxilia.AdminConsole.Auth
@using Auxilia.Core.Contracts

<div class="app-shell">
    <aside class="sidebar">
        <a class="sidebar-brand" href="">
            <span class="brand-mark">A</span>
            <span>Auxilia</span>
        </a>

        @* Navigation is permission-gated: an item appears only when the signed-in principal's
           Core-computed effective permissions cover the page's API surface. *@
        <nav class="sidebar-nav">
            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="nav-group">
                        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 12l9-9 9 9"/><path d="M5 10v10h14V10"/><rect x="9" y="14" width="6" height="6"/>
                            </svg>
                            <span>Home</span>
                        </NavLink>

                        @if (Can(auth.User, PermissionActions.WorkflowConfigurationManage))
                        {
                            <NavLink class="nav-item" href="workflows">
                                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4v5a4 4 0 0 1-4 4H6"/><line x1="6" y1="9" x2="6" y2="15"/>
                                </svg>
                                <span>Workflows</span>
                            </NavLink>
                        }
                        @if (Can(auth.User, PermissionActions.RunObserve))
                        {
                            <NavLink class="nav-item" href="dashboard">
                                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/>
                                </svg>
                                <span>Dashboard</span>
                            </NavLink>
                            <NavLink class="nav-item" href="runs">
                                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="13 2 13 9 20 9"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="9 13 11 15 15 11"/>
                                </svg>
                                <span>Runs</span>
                            </NavLink>
                        }
                        <NavLink class="nav-item" href="connectors">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>
                            </svg>
                            <span>Connectors</span>
                        </NavLink>
                    </div>

                    @if (Can(auth.User, PermissionActions.PrincipalAdminister)
                         || Can(auth.User, PermissionActions.IdentitySourceManage)
                         || Can(auth.User, PermissionActions.ProviderCatalogManage)
                         || Can(auth.User, PermissionActions.AuditRead))
                    {
                        <div class="nav-group">
                            <span class="nav-group-label">Administration</span>
                            @if (Can(auth.User, PermissionActions.PrincipalAdminister))
                            {
                                <NavLink class="nav-item" href="admin" Match="NavLinkMatch.All">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                    <span>Principals</span>
                                </NavLink>
                            }
                            @if (Can(auth.User, PermissionActions.IdentitySourceManage))
                            {
                                <NavLink class="nav-item" href="admin/identity-sources">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/>
                                    </svg>
                                    <span>Identity sources</span>
                                </NavLink>
                            }
                            @if (Can(auth.User, PermissionActions.ProviderCatalogManage))
                            {
                                <NavLink class="nav-item" href="admin/provider-catalog">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                                    </svg>
                                    <span>Provider catalog</span>
                                </NavLink>
                            }
                            @if (Can(auth.User, PermissionActions.AuditRead))
                            {
                                <NavLink class="nav-item" href="audit">
                                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                        <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                                    </svg>
                                    <span>Audit</span>
                                </NavLink>
                            }
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="sidebar-footer">
            <AuthorizeView>
                <Authorized>
                    <div class="session-user">
                        <span class="avatar">@InitialOf(context.User)</span>
                        <span class="session-meta">
                            <span class="session-name">@context.User.Identity?.Name</span>
                            @if (RolesOf(context.User) is { Length: > 0 } roles)
                            {
                                <span class="session-role">@roles</span>
                            }
                        </span>
                    </div>
                    @* Sign-out is a Core concern (same-origin): POST /auth/logout clears the shared session. *@
                    <form method="post" action="auth/logout" class="inline-form">
                        <button type="submit" class="logout-button">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            <span>Log out</span>
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-item" href="auth/login?returnUrl=/">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                            <polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                        </svg>
                        <span>Sign in</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@code {

    private static string InitialOf(ClaimsPrincipal user)
        => user.Identity?.Name is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "?";

    private static string RolesOf(ClaimsPrincipal user)
        => string.Join(", ", user.FindAll(ClaimTypes.Role).Select(c => c.Value));

    private static bool Can(ClaimsPrincipal user, string action)
        => ConsoleAuthenticationStateProvider.Can(user, action);

}
