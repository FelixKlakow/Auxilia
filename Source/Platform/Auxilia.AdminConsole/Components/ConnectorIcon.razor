@* Presentational glyph for a connector's provider. All vendor knowledge in the console is
   confined to this one component: callers pass a provider type and get a glyph, and anything
   unrecognised falls back to a generic plug. *@

<svg class="connector-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (GlyphKey)
    {
        case "anthropic-claude":
            <path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/>
            <path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/>
            break;
        case "github":
            <circle cx="6" cy="6" r="2.5"/>
            <circle cx="6" cy="18" r="2.5"/>
            <circle cx="18" cy="9" r="2.5"/>
            <path d="M6 8.5v7"/>
            <path d="M15.7 10.6C13.2 12 10 12.5 6 12.5"/>
            break;
        case "microsoft":
            <rect x="4" y="4" width="7" height="7"/>
            <rect x="13" y="4" width="7" height="7"/>
            <rect x="4" y="13" width="7" height="7"/>
            <rect x="13" y="13" width="7" height="7"/>
            break;
        default:
            <path d="M9 7V2"/>
            <path d="M15 7V2"/>
            <path d="M6 7h12v3a6 6 0 0 1-6 6 6 6 0 0 1-6-6z"/>
            <path d="M12 16v6"/>
            break;
    }
</svg>

@code {

    /// <summary>Explicit glyph key; when unset it is derived from <see cref="ProviderType"/>.</summary>
    [Parameter]
    public string? FlowKey { get; set; }

    [Parameter]
    public string? ProviderType { get; set; }

    private string GlyphKey => FlowKey is { Length: > 0 } key ? key : KeyFor(ProviderType);

    private static string KeyFor(string? providerType)
    {
        if (providerType is not { Length: > 0 })
            return "";
        var name = providerType.ToLowerInvariant();
        if (name.Contains("claude") || name.Contains("anthropic"))
            return "anthropic-claude";
        if (name.Contains("github"))
            return "github";
        if (name.Contains("microsoft") || name.Contains("entra") || name.Contains("azure"))
            return "microsoft";
        return "";
    }

}
