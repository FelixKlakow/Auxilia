@inherits LayoutComponentBase

<div class="page">
    <header class="topbar">
        <span class="brand">Auxilia</span>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="runs">Runs</NavLink>
            <NavLink href="trigger">Trigger</NavLink>
            <span class="nav-section">Operator</span>
            <NavLink href="operator/slots">Slots</NavLink>
            <NavLink href="operator/schedules">Schedules</NavLink>
            <NavLink href="operator/artifact-triggers">Chaining</NavLink>
            <span class="nav-section">Admin</span>
            <NavLink href="admin">Principals</NavLink>
            <NavLink href="admin/bundles">Bundles</NavLink>
            <NavLink href="audit">Audit</NavLink>
        </nav>
        <div class="session">
            <AuthorizeView>
                <Authorized>
                    <span class="user">@context.User.Identity?.Name</span>
                    <form method="post" action="auth/logout-form" class="inline-form">
                        <button type="submit" class="link-button">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="content">
        @Body
    </main>
</div>
