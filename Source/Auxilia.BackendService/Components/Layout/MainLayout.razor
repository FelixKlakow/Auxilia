@inherits LayoutComponentBase
@using System.Security.Claims

<div class="app-shell">
    <aside class="sidebar">
        <a class="sidebar-brand" href="">
            <span class="brand-mark">A</span>
            <span>Auxilia</span>
        </a>

        <nav class="sidebar-nav">
            <div class="nav-group">
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/>
                        <rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
                    </svg>
                    <span>Dashboard</span>
                </NavLink>
                <NavLink class="nav-item" href="runs">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="3 12 7 12 10 5 14 19 17 12 21 12"/>
                    </svg>
                    <span>Runs</span>
                </NavLink>
            </div>

            <div class="nav-group">
                <span class="nav-group-label">Operator</span>
                <NavLink class="nav-item" href="operator/slots">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/>
                    </svg>
                    <span>Slots</span>
                </NavLink>
                <NavLink class="nav-item" href="operator/schedules">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/>
                    </svg>
                    <span>Schedules</span>
                </NavLink>
                <NavLink class="nav-item" href="operator/artifact-triggers">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </svg>
                    <span>Chaining</span>
                </NavLink>
            </div>

            <div class="nav-group">
                <span class="nav-group-label">Administration</span>
                <NavLink class="nav-item" href="admin" Match="NavLinkMatch.All">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    <span>Principals</span>
                </NavLink>
                <NavLink class="nav-item" href="admin/bundles">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.7 12.3L21 2"/><path d="M16 7l3 3"/><path d="M13 10l2 2"/>
                    </svg>
                    <span>Account bundles</span>
                </NavLink>
                <NavLink class="nav-item" href="audit">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                    <span>Audit</span>
                </NavLink>
                <NavLink class="nav-item" href="trigger">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                    </svg>
                    <span>Trigger</span>
                </NavLink>
            </div>
        </nav>

        <div class="sidebar-footer">
            <AuthorizeView>
                <Authorized>
                    <div class="session-user">
                        <span class="avatar">@InitialOf(context.User)</span>
                        <span class="session-meta">
                            <span class="session-name">@context.User.Identity?.Name</span>
                            @if (RolesOf(context.User) is { Length: > 0 } roles)
                            {
                                <span class="session-role">@roles</span>
                            }
                        </span>
                    </div>
                    <form method="post" action="auth/logout-form" class="inline-form">
                        <button type="submit" class="logout-button">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            <span>Log out</span>
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-item" href="login">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                            <polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                        </svg>
                        <span>Login</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@code {

    private static string InitialOf(ClaimsPrincipal user)
        => user.Identity?.Name is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "?";

    private static string RolesOf(ClaimsPrincipal user)
        => string.Join(", ", user.FindAll(ClaimTypes.Role).Select(c => c.Value));

}
