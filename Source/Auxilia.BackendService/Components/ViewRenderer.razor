@using System.Text.Json
@using Auxilia.Workflows.Views

@* Renders the body of one workflow view; the host page provides the surrounding card
   (title, type chip, pin actions). *@

@if (Items.Count == 0)
{
    <p class="muted view-empty">No data yet.</p>
}
else
{
    switch (Descriptor.Rendering)
    {
        case ViewRendering.Stream:
        case ViewRendering.Log:
            <div class="log-view">
                @foreach (var item in Items)
                {
                    var row = ParseLogRow(item);
                    @if (row.Fields is null)
                    {
                        <div class="log-raw">@row.Raw</div>
                    }
                    else
                    {
                        <div class="log-row">
                            <span class="log-time">@row.Time</span>
                            <span class="log-fields">
                                @foreach (var field in row.Fields)
                                {
                                    <span class="log-field">
                                        <span class="log-label">@field.Key</span>
                                        <span class="log-value">@field.Value</span>
                                    </span>
                                }
                            </span>
                        </div>
                    }
                }
            </div>
            break;

        case ViewRendering.Table:
            var rows = Items
                .Select(i => TryParse(i.PayloadJson))
                .Where(e => e is { ValueKind: JsonValueKind.Object })
                .Select(e => e!.Value)
                .ToList();
            var columns = rows
                .SelectMany(r => r.EnumerateObject().Select(p => p.Name))
                .Distinct()
                .ToList();
            <table class="data-table">
                <thead>
                <tr>
                    @foreach (var column in columns)
                    {
                        <th>@column</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        @foreach (var column in columns)
                        {
                            <td>@CellText(row, column)</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
            break;

        case ViewRendering.Markdown:
            <pre class="view-markdown">@string.Join("\n", Items.Select(i => MarkdownText(i.PayloadJson)))</pre>
            break;

        case ViewRendering.Custom when Registry.Resolve(Descriptor.RendererKey) is { } rendererType:
            <DynamicComponent Type="rendererType" Parameters="RendererParameters()"/>
            break;

        case ViewRendering.Custom:
            <p class="muted custom-renderer-missing">
                Custom renderer '@(Descriptor.RendererKey ?? "(none)")' is not installed — showing raw items.
            </p>
            <div class="log-view">
                @foreach (var item in Items)
                {
                    <div class="log-raw">@item.PayloadJson</div>
                }
            </div>
            break;

        default:
            <div class="view-placeholder">
                '@Descriptor.Rendering' rendering is not supported yet — @Items.Count item(s) recorded.
            </div>
            break;
    }
}

@code {

    private static readonly string[] TimePropertyNames = ["timestamp", "timestamputc", "time", "at"];

    [Inject]
    public required ViewRendererRegistry Registry { get; set; }

    [Parameter, EditorRequired]
    public required ViewDescriptor Descriptor { get; set; }

    [Parameter]
    public IReadOnlyList<ViewDataRecord> Items { get; set; } = [];

    [Parameter]
    public bool IsLive { get; set; }

    /// <summary>The custom-renderer component contract: ordered raw items plus liveness.</summary>
    private Dictionary<string, object?> RendererParameters()
        => new() { ["Items"] = Items, ["IsLive"] = IsLive };

    private sealed record LogRow(string Time, IReadOnlyList<KeyValuePair<string, string>>? Fields, string Raw);

    /// <summary>Structured log line: time column plus label/value fields; non-object payloads stay raw.</summary>
    private static LogRow ParseLogRow(ViewDataRecord item)
    {
        var element = TryParse(item.PayloadJson);
        if (element is not { ValueKind: JsonValueKind.Object })
            return new LogRow("", null, item.PayloadJson);

        var time = "";
        var fields = new List<KeyValuePair<string, string>>();
        foreach (var property in element.Value.EnumerateObject())
        {
            if (time.Length == 0 && TimeOf(property) is { } formatted)
            {
                time = formatted;
                continue;
            }

            fields.Add(new KeyValuePair<string, string>(property.Name, CellValue(property.Value)));
        }

        if (time.Length == 0)
            time = item.TimestampUtc.ToString("HH:mm:ss");
        return new LogRow(time, fields, item.PayloadJson);
    }

    private static string? TimeOf(JsonProperty property)
    {
        if (!TimePropertyNames.Contains(property.Name.ToLowerInvariant()))
            return null;
        if (property.Value.ValueKind != JsonValueKind.String ||
            !DateTimeOffset.TryParse(property.Value.GetString(), out var timestamp))
            return null;
        return timestamp.ToUniversalTime().ToString("HH:mm:ss");
    }

    private static string CellValue(JsonElement value)
        => value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : value.GetRawText();

    private static JsonElement? TryParse(string payloadJson)
    {
        try
        {
            return JsonSerializer.Deserialize<JsonElement>(payloadJson);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static string CellText(JsonElement row, string column)
        => row.TryGetProperty(column, out var value) ? CellValue(value) : "";

    /// <summary>Concatenates the payload's top-level string properties (or a bare JSON string).</summary>
    private static string MarkdownText(string payloadJson)
    {
        var element = TryParse(payloadJson);
        return element?.ValueKind switch
        {
            JsonValueKind.String => element.Value.GetString() ?? "",
            JsonValueKind.Object => string.Join("\n", element.Value.EnumerateObject()
                .Where(p => p.Value.ValueKind == JsonValueKind.String)
                .Select(p => p.Value.GetString())),
            _ => payloadJson
        };
    }

}
