@using System.Text.Json
@using Auxilia.Workflows.Views
@using BlazorAgentView.Components
@using BlazorAgentView.Models

@* Reference custom view renderer (key "agent-chat"): renders AgentChatEntry items as a
   live left/right chat conversation via the BlazorAgentView package. *@

<div class="agent-chat-host" style="height: 480px;">
    <AgentChatView Messages="_messages" Options="ChatOptions"/>
</div>

@code {

    private static readonly AgentChatOptions ChatOptions = new()
    {
        ShowTimestamps = true,
        EnableMarkdown = true,
        AutoScroll = true,
        ToolCallDisplay = ToolCallDisplayMode.Collapsible
    };

    private List<ChatMessage> _messages = [];

    [Parameter, EditorRequired]
    public required IReadOnlyList<ViewDataRecord> Items { get; set; }

    [Parameter]
    public bool IsLive { get; set; }

    protected override void OnParametersSet()
    {
        // A tool's start (input) and result (output) arrive as two correlated entries; the
        // conversation shows them as ONE card — input and output in their own sections.
        var messages = new List<ChatMessage>();
        var openToolCards = new Dictionary<string, ToolCall>(StringComparer.Ordinal);
        foreach (var item in Items)
        {
            var entry = Deserialize(item);
            if (entry is null)
                continue;

            if (entry.Role == AgentChatRole.Tool
                && entry.ToolUseId is { Length: > 0 } useId
                && openToolCards.Remove(useId, out var started))
            {
                started.Output = entry.Content;
                started.State = ToolStateOf(entry.ToolState);
                continue;
            }

            var message = ToChatMessage(item, entry);
            if (entry.Role == AgentChatRole.Tool && entry.ToolUseId is { Length: > 0 } startedId
                && ToolStateOf(entry.ToolState) == ToolState.Running)
                openToolCards[startedId] = message.ToolCalls[0];
            messages.Add(message);
        }

        _messages = messages;
    }

    private static AgentChatEntry? Deserialize(ViewDataRecord item)
    {
        try
        {
            return JsonSerializer.Deserialize<AgentChatEntry>(item.PayloadJson);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static ChatMessage ToChatMessage(ViewDataRecord item, AgentChatEntry entry)
    {
        var message = new ChatMessage
        {
            Id = item.Sequence.ToString(),
            Role = RoleOf(entry.Role),
            Content = entry.Role == AgentChatRole.Tool ? "" : entry.Content,
            Timestamp = entry.TimestampUtc,
            // A tool entry's label belongs on the tool card (subtitle), not on the row
            // header — otherwise "TOOL" is replaced by e.g. the shell command.
            RoleLabel = entry.Role == AgentChatRole.Tool ? null : entry.Label
        };
        if (entry.Role == AgentChatRole.Tool)
        {
            // A running tool's content is its INPUT; a finished standalone entry
            // (legacy, or a result whose start was never seen) carries the output.
            var running = ToolStateOf(entry.ToolState) == ToolState.Running;
            message.ToolCalls.Add(new ToolCall
            {
                Id = item.Sequence.ToString(),
                ToolName = entry.ToolName ?? "tool",
                Subtitle = entry.Label ?? "",
                Input = running ? entry.Content : "",
                Output = running ? "" : entry.Content,
                State = ToolStateOf(entry.ToolState)
            });
        }

        return message;
    }

    private static MessageRole RoleOf(AgentChatRole role) => role switch
    {
        AgentChatRole.User => MessageRole.User,
        AgentChatRole.System => MessageRole.System,
        AgentChatRole.Tool => MessageRole.Tool,
        _ => MessageRole.Assistant
    };

    private static ToolState ToolStateOf(string? state) => state?.ToLowerInvariant() switch
    {
        "running" => ToolState.Running,
        "success" => ToolState.Success,
        "error" or "failed" => ToolState.Failed,
        "cancelled" => ToolState.Cancelled,
        _ => ToolState.Pending
    };

}
