@using Auxilia.Workflows.Messaging.Messages
@implements IDisposable
@inject IDataAccess<WorkflowInstanceRecord> Instances
@inject LiveViewBroker Broker

@* Compact live-now counter for the sidebar (#21): pulsing dot + count while runs are active. *@
@if (_count > 0)
{
    <span class="nav-live-badge" title="@_count active run(s) right now">
        <span class="live-dot" aria-hidden="true"></span>@_count
    </span>
}

@code {

    private readonly CancellationTokenSource _cts = new();
    private readonly HashSet<Guid> _active = [];
    private IDisposable? _subscription;
    private PeriodicTimer? _timer;
    private int _count;

    protected override async Task OnInitializedAsync()
    {
        await ReconcileAsync();
        // Live path: lifecycle events keep the count fresh without any per-event I/O.
        _subscription = Broker.Subscribe(onStatus: OnStatus);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _timer is not null)
            return;
        // Degraded-mode fallback: a slow reconcile in case a status push was missed.
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = PollAsync();
    }

    private void OnStatus(WorkflowStatusEvent statusEvent)
    {
        bool changed;
        lock (_active)
        {
            changed = LiveNow.IsActive(statusEvent.State)
                ? _active.Add(statusEvent.WorkflowInstanceId)
                : _active.Remove(statusEvent.WorkflowInstanceId);
            _count = _active.Count;
        }

        if (changed)
            _ = InvokeAsync(StateHasChanged);
    }

    private async Task ReconcileAsync()
    {
        var activeRuns = LiveNow.ActiveOf(await Instances.ReadAsync(_cts.Token));
        lock (_active)
        {
            _active.Clear();
            foreach (var run in activeRuns)
                _active.Add(run.Id);
            _count = _active.Count;
        }
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await ReconcileAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed — polling ends.
        }
    }

    public void Dispose()
    {
        _subscription?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }

}
