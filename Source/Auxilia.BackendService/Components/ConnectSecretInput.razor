@using Auxilia.BackendService.Dashboard.Connect
@using Auxilia.Workflows
@inject ConnectFlowRegistry Connects
@inject ConnectorService ConnectorStore

@* One secret setting's input. When its descriptor names a connect flow, picking an already
   connected account (a connector) is the primary path, a fresh sign-in the second, and
   manual token entry the tucked-away fallback. The value lands in the draft's settings —
   write-only from there on. *@

@if (Connects.Find(Descriptor.ConnectFlow) is not { } flow)
{
    <input type="password" autocomplete="new-password"
           @bind="Settings[Descriptor.Key]"
           placeholder="@(StoredSet ? "set — leave empty to keep unchanged" : "")"/>
}
else
{
    <div class="connect-box">
        @if (_connectors.Count > 0 && _start is null)
        {
            <select @onchange="OnConnectorPicked">
                <option value="" selected="@(SelectedConnectorId is null)">(pick a connected account, or sign in below)</option>
                @foreach (var connector in _connectors)
                {
                    <option value="@connector.Id" selected="@(SelectedConnectorId == connector.Id)">
                        @connector.DisplayName (@(connector.Scope == "Company" ? "company" : "yours"))
                    </option>
                }
            </select>
        }
        @if (_start is null)
        {
            <div class="connect-idle">
                @if (PickedConnector is { } picked)
                {
                    <span class="badge badge-state badge-valid">Using @picked.DisplayName — save to apply</span>
                }
                else if (Connected)
                {
                    <span class="badge badge-state badge-valid">
                        @flow.DisplayName connected@(PendingSave ? " — save to store it" : "")
                    </span>
                    <button type="button" class="link-button" disabled="@_busy" @onclick="BeginAsync">
                        Reconnect
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="BeginAsync">
                        Connect @flow.DisplayName
                    </button>
                }
                <button type="button" class="link-button" @onclick="() => _manual = !_manual">
                    @(_manual ? "Hide manual entry" : "Enter a token manually")
                </button>
            </div>
            @if (_manual)
            {
                <input type="password" autocomplete="new-password"
                       @bind="Settings[Descriptor.Key]"
                       placeholder="@(StoredSet ? "set — leave empty to keep unchanged" : "")"/>
            }
        }
        else
        {
            <div class="connect-steps">
                <p class="field-hint">@flow.Instructions</p>
                @if (_start.UserCode is { Length: > 0 } userCode)
                {
                    <div class="connect-user-code" title="Enter this code on the sign-in page">@userCode</div>
                }
                <div class="button-row">
                    <a class="btn btn-secondary btn-sm" href="@_start.AuthorizeUrl" target="_blank" rel="noopener">
                        Open the sign-in page ↗
                    </a>
                </div>
                @if (_start.PasteRequired)
                {
                    <input @bind="_pastedCode" placeholder="Paste the code shown after approving"/>
                }
                <div class="button-row">
                    <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="CompleteAsync">
                        @(_busy ? "Finishing…" : "I signed in — finish")
                    </button>
                    <button type="button" class="link-button" disabled="@_busy" @onclick="Reset">Cancel</button>
                </div>
            </div>
        }

        @if (_notice is not null)
        {
            <p class="field-hint">@_notice</p>
        }
        @if (_error is not null)
        {
            <p class="field-hint denied-hint">@_error</p>
        }
    </div>
}

@code {

    [Parameter, EditorRequired]
    public SettingDescriptor Descriptor { get; set; } = null!;

    [Parameter, EditorRequired]
    public Dictionary<string, string> Settings { get; set; } = null!;

    /// <summary>Whether a stored (write-only) value already exists for this key.</summary>
    [Parameter]
    public bool StoredSet { get; set; }

    /// <summary>When set, connectors accessible to this principal are offered for picking.</summary>
    [Parameter]
    public Guid? PrincipalId { get; set; }

    private IReadOnlyList<ConnectorOverview> _connectors = [];

    private ConnectStart? _start;
    private string _pastedCode = "";
    private string? _error;
    private string? _notice;
    private bool _busy;
    private bool _manual;

    private bool PendingSave => Settings.GetValueOrDefault(Descriptor.Key) is { Length: > 0 };
    private bool Connected => PendingSave || StoredSet;

    private Guid? SelectedConnectorId
        => ConnectorService.ReferencedId(Settings.GetValueOrDefault(Descriptor.Key));

    private ConnectorOverview? PickedConnector
        => _connectors.FirstOrDefault(c => c.Id == SelectedConnectorId);

    protected override async Task OnInitializedAsync()
    {
        if (PrincipalId is { } principalId && Descriptor.ConnectFlow is { Length: > 0 } flowKey)
            _connectors = await ConnectorStore.AccessibleAsync(principalId, flowKey);
    }

    private void OnConnectorPicked(ChangeEventArgs e)
        => Settings[Descriptor.Key] = e.Value is string value && Guid.TryParse(value, out var id)
            ? ConnectorService.ReferenceFor(id)
            : "";

    private async Task BeginAsync()
    {
        _error = null;
        _notice = null;
        _pastedCode = "";
        _manual = false;
        _busy = true;
        try
        {
            _start = await Connects.Find(Descriptor.ConnectFlow)!.BeginAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CompleteAsync()
    {
        if (_start is null)
            return;
        _error = null;
        _notice = null;
        _busy = true;
        try
        {
            var flow = Connects.Find(Descriptor.ConnectFlow)!;
            var token = await flow.CompleteAsync(_start.State, _pastedCode);
            if (PrincipalId is { } principalId)
            {
                // A sign-in is never slot-local: it becomes a personal connector so the
                // account stays visible on the connectors page and reusable across
                // workflows; the slot keeps only the reference.
                var name = await ConnectorStore.SaveAsync(
                    principalId.ToString("D"), principalId, existingName: null,
                    flow.DisplayName, flow.Key, token,
                    Auxilia.PlatformData.Entities.SlotInstanceScope.Personal);
                _connectors = await ConnectorStore.AccessibleAsync(principalId, Descriptor.ConnectFlow);
                Settings[Descriptor.Key] = ConnectorService.ReferenceFor(
                    Auxilia.PlatformData.Entities.ConnectorRecord.IdFor(name));
            }
            else
            {
                Settings[Descriptor.Key] = token;
            }

            Reset();
        }
        catch (ConnectPendingException ex)
        {
            _notice = ex.Message; // the attempt stays valid — finishing is retried
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _start = null;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Reset()
    {
        _start = null;
        _pastedCode = "";
        _notice = null;
    }

}
