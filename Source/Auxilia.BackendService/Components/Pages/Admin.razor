@page "/admin"
@attribute [Authorize]
@inject IDataAccess<PrincipalRecord> Principals
@inject IDataAccess<RoleAssignmentRecord> RoleAssignments
@inject PrincipalDirectory Directory
@inject IPolicyEngine PolicyEngine

<PageTitle>Admin — Auxilia</PageTitle>

<PageHeader Title="Principals"
            Subtitle="Everyone — and everything — that can act on this platform: people, services, and AI agents."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (!_allowed)
{
    <div class="panel denied">Access denied: @_denyReason</div>
}
else
{
    @if (_error is not null)
    {
        <div class="panel denied">@_error</div>
    }
    @if (_createdApiKey is not null)
    {
        <div class="panel success">
            API key for the new principal — shown once, copy it now:
            <code class="api-key">@_createdApiKey</code>
        </div>
    }

    <section class="card">
        <div class="card-header">
            <h2>Principals</h2>
        </div>
        <table class="data-table">
            <thead>
            <tr>
                <th>Name</th>
                <th>Kind</th>
                <th>Status</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var principal in _principals)
            {
                var roles = RolesOf(principal.Id);
                <tr>
                    <td class="cell-strong">@principal.DisplayName</td>
                    <td>@principal.Kind</td>
                    <td>
                        <span class="badge badge-state @(principal.Status == "Active" ? "badge-success" : "badge-cancelled")">
                            @principal.Status
                        </span>
                    </td>
                    <td>
                        @foreach (var role in roles)
                        {
                            <span class="badge badge-role">
                                @role
                                <button class="chip-x" title="Revoke role"
                                        @onclick="() => RevokeRoleAsync(principal.Id, role)">✕</button>
                            </span>
                        }
                    </td>
                    <td>
                        <div class="cell-actions">
                            <select class="select-inline" @bind="_roleSelections[principal.Id]">
                                @foreach (var role in BuiltInRoles.AllRoleNames.Except(roles))
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                            <button class="btn btn-secondary btn-sm" @onclick="() => AssignRoleAsync(principal.Id)" disabled="@_busy">Assign</button>
                            @if (principal.Status == "Active")
                            {
                                <button class="btn btn-danger btn-sm" @onclick="() => DisableAsync(principal.Id)" disabled="@_busy">Disable</button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>

    <div class="card-row">
        <section class="card">
            <div class="card-header">
                <h2>Create human principal</h2>
                <p class="card-subtitle">A person who signs in to this dashboard with username and password.</p>
            </div>
            <div class="card-body form-grid">
                <label>Display name <input @bind="_humanDisplayName"/></label>
                <label>Username <input @bind="_humanUsername"/></label>
                <label>Password <input type="password" @bind="_humanPassword"/></label>
                <div class="button-row">
                    <button class="btn btn-primary" @onclick="CreateHumanAsync" disabled="@_busy">Create human</button>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-header">
                <h2>Create AI principal</h2>
                <p class="card-subtitle">
                    A service or AI agent that authenticates with an API key — the key is shown once after creation.
                </p>
            </div>
            <div class="card-body form-grid">
                <label>Display name <input @bind="_aiDisplayName"/></label>
                <div class="button-row">
                    <button class="btn btn-primary" @onclick="CreateAiAsync" disabled="@_busy">Create AI principal</button>
                </div>
            </div>
        </section>
    </div>
}

@code {

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    private bool _loaded;
    private bool _allowed;
    private bool _busy;
    private string _denyReason = "";
    private string? _error;
    private string? _createdApiKey;

    private string _humanDisplayName = "";
    private string _humanUsername = "";
    private string _humanPassword = "";
    private string _aiDisplayName = "";

    private IReadOnlyList<PrincipalRecord> _principals = [];
    private IReadOnlyList<RoleAssignmentRecord> _assignments = [];
    private readonly Dictionary<Guid, string> _roleSelections = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        var principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(principalId.Value, PermissionActions.PrincipalAdminister, "principals"));
            _allowed = decision.Allowed;
            _denyReason = decision.Reason;
        }
        else
        {
            _denyReason = "no platform principal in session";
        }

        if (_allowed)
            await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        var principals = await Principals.ReadAsync();
        _principals = principals.OrderBy(p => p.DisplayName).ToList();
        var assignments = await RoleAssignments.ReadAsync();
        _assignments = assignments.ToList();
        foreach (var principal in _principals)
            _roleSelections.TryAdd(principal.Id, BuiltInRoles.AllRoleNames.First());
    }

    private IReadOnlyList<string> RolesOf(Guid principalId)
        => _assignments.Where(a => a.PrincipalId == principalId).Select(a => a.RoleName).OrderBy(r => r).ToList();

    private async Task CreateHumanAsync()
    {
        if (string.IsNullOrWhiteSpace(_humanDisplayName) ||
            string.IsNullOrWhiteSpace(_humanUsername) ||
            string.IsNullOrWhiteSpace(_humanPassword))
        {
            _error = "Display name, username, and password are required.";
            return;
        }

        await RunAsync(async () =>
        {
            await Directory.CreateHumanAsync(_humanDisplayName.Trim(), _humanUsername.Trim(), _humanPassword);
            _humanDisplayName = _humanUsername = _humanPassword = "";
        });
    }

    private async Task CreateAiAsync()
    {
        if (string.IsNullOrWhiteSpace(_aiDisplayName))
        {
            _error = "Display name is required.";
            return;
        }

        await RunAsync(async () =>
        {
            var (_, apiKey) = await Directory.CreateApiKeyPrincipalAsync(_aiDisplayName.Trim(), "AiAgent");
            _createdApiKey = apiKey;
            _aiDisplayName = "";
        });
    }

    private Task AssignRoleAsync(Guid principalId)
        => RunAsync(async () =>
        {
            if (_roleSelections.TryGetValue(principalId, out var role) && !string.IsNullOrEmpty(role))
                await Directory.AssignRoleAsync(principalId, role);
        });

    private Task RevokeRoleAsync(Guid principalId, string role)
        => RunAsync(() => Directory.RevokeRoleAsync(principalId, role));

    private Task DisableAsync(Guid principalId)
        => RunAsync(() => Directory.DisableAsync(principalId));

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

}
