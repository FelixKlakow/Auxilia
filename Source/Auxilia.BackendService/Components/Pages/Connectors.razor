@page "/connectors"
@attribute [Authorize]
@using Auxilia.BackendService.Dashboard.Connect
@using Auxilia.PlatformData.Entities
@inject ConnectorService ConnectorStore
@inject ConnectFlowRegistry Flows
@inject IDataAccess<PrincipalRecord> Principals
@inject IPolicyEngine PolicyEngine

<PageTitle>Connectors — Auxilia</PageTitle>

<PageHeader Title="Connectors"
            Subtitle="The signed-in accounts Auxilia can act as — Claude, GitHub, … Connect once here, then pick the account wherever a slot needs that credential."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (_principalId is null)
{
    <div class="panel denied">Access denied: no platform principal in session.</div>
}
else
{
    @if (_error is not null)
    {
        <div class="panel denied">@_error</div>
    }
    @if (_saved is not null)
    {
        <div class="panel success">Connector "@_saved" saved.</div>
    }

    <section class="card">
        <div class="card-header">
            <h2>Your connectors</h2>
            <div class="card-actions">
                <button class="btn btn-primary" disabled="@_busy" @onclick="StartCreate">
                    Connect an account
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (PersonalConnectors.Count == 0)
            {
                <p class="muted">
                    No personal account connected yet — sign in once and every slot that needs
                    this account can simply pick it.
                </p>
            }
            else
            {
                <div class="connector-grid">
                    @foreach (var connector in PersonalConnectors)
                    {
                        @ConnectorCard(connector)
                    }
                </div>
            }
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Company connectors</h2>
            @if (!_canManage)
            {
                <p class="card-subtitle">Shared by administrators — anyone configuring slots may pick them.</p>
            }
        </div>
        <div class="card-body">
            @if (CompanyConnectors.Count == 0)
            {
                <p class="muted">
                    No company account connected yet@(_canManage
                        ? " — connect one and pick the Company scope to share it."
                        : " — administrators connect and share them here.")
                </p>
            }
            else
            {
                <div class="connector-grid">
                    @foreach (var connector in CompanyConnectors)
                    {
                        @ConnectorCard(connector)
                    }
                </div>
            }
        </div>
    </section>

    @if (_draft is not null)
    {
        <section class="card">
            <div class="card-header">
                <h2>@(_draft.ExistingName is null ? "Connect an account" : $"Edit \"{_draft.DisplayName}\"")</h2>
                <p class="card-subtitle">Pick the account type and sign in — the credential is encrypted at rest and never shown back.</p>
            </div>
            <div class="card-body">
                <div class="provider-grid">
                    @foreach (var flow in Flows.All)
                    {
                        <label class="provider-card @(_draft.FlowKey == flow.Key ? "selected" : null)">
                            <input type="radio" name="connector-flow" disabled="@(_draft.ExistingName is not null)"
                                   checked="@(_draft.FlowKey == flow.Key)"
                                   @onchange="() => SelectFlow(flow)"/>
                            <span class="provider-card-head">
                                <span class="connector-icon"><ConnectorIcon FlowKey="@flow.Key"/></span>
                                <span class="provider-name">@flow.DisplayName</span>
                            </span>
                        </label>
                    }
                </div>

                @if (_draft.FlowKey.Length > 0)
                {
                    <div class="form-grid setting-grid">
                        <label>
                            Sign-in
                            <ConnectSecretInput Descriptor="SignInDescriptor" Settings="_draft.Settings"
                                                StoredSet="_draft.ExistingName is not null"/>
                            <span class="field-hint">
                                @(_draft.ExistingName is null
                                    ? "Complete the sign-in, then name and save the connector."
                                    : "Reconnect only to replace the stored credential; leaving it keeps the current one.")
                            </span>
                        </label>
                        <label>
                            Display name
                            <input @bind="_draft.DisplayName" placeholder="e.g. My Claude account"/>
                        </label>
                        @if (_canManage)
                        {
                            <label>
                                Scope
                                <select @bind="_draft.Scope">
                                    <option value="Company">Company — anyone configuring slots may pick it</option>
                                    <option value="Personal">Personal — only you</option>
                                </select>
                            </label>
                        }
                    </div>
                }

                <div class="button-row editor-actions">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
                        @(_draft.ExistingName is null ? "Save connector" : "Save changes")
                    </button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _draft = null">Cancel</button>
                </div>
            </div>
        </section>
    }
}

@code {

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Editing model: the obtained token rides in Settings under this key until save.</summary>
    private sealed class ConnectorDraft
    {
        public string? ExistingName { get; set; }
        public string DisplayName { get; set; } = "";
        public string FlowKey { get; set; } = "";
        public string Scope { get; set; } = SlotInstanceScope.Personal;
        public Dictionary<string, string> Settings { get; } = new(StringComparer.Ordinal) { ["token"] = "" };
    }

    private bool _loaded;
    private bool _busy;
    private bool _canManage;
    private string? _error;
    private string? _saved;
    private Guid? _principalId;
    private Guid? _deleteCandidate;
    private ConnectorDraft? _draft;

    private IReadOnlyList<ConnectorOverview> _all = [];
    private IReadOnlyList<PrincipalRecord> _principals = [];

    /// <summary>Own personal connectors; administrators additionally see everyone's.</summary>
    private IReadOnlyList<ConnectorOverview> PersonalConnectors
        => _all
            .Where(c => c.Scope == SlotInstanceScope.Personal
                        && (_canManage || c.OwnerPrincipalId == _principalId))
            .ToList();

    private IReadOnlyList<ConnectorOverview> CompanyConnectors
        => _all.Where(c => c.Scope == SlotInstanceScope.Company).ToList();

    /// <summary>The connect UI is the existing secret input; this descriptor points it at the picked flow.</summary>
    private Auxilia.Workflows.SettingDescriptor SignInDescriptor
        => new("token", Flows.Find(_draft!.FlowKey)?.DisplayName ?? _draft.FlowKey,
                Auxilia.Workflows.SettingKind.Secret)
            { ConnectFlow = _draft.FlowKey };

    private bool CanEdit(ConnectorOverview connector)
        => _canManage || connector.OwnerPrincipalId == _principalId;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        _principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (_principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(_principalId.Value, PermissionActions.SlotConfigWrite, "slot-configurations"));
            _canManage = decision.Allowed;
            _principals = (await Principals.ReadAsync()).ToList()
                .OrderBy(p => p.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
            await LoadAsync();
        }

        _loaded = true;
    }

    private async Task LoadAsync()
        => _all = await ConnectorStore.ListAsync();

    private string PrincipalName(Guid? id)
        => _principals.FirstOrDefault(p => p.Id == id)?.DisplayName ?? "(unknown)";

    private void StartCreate()
    {
        _error = null;
        _saved = null;
        _draft = new ConnectorDraft();
        if (Flows.All.Count == 1)
            _draft.FlowKey = Flows.All[0].Key;
    }

    private void StartEdit(ConnectorOverview connector)
    {
        _error = null;
        _saved = null;
        _draft = new ConnectorDraft
        {
            ExistingName = connector.Name,
            DisplayName = connector.DisplayName,
            FlowKey = connector.FlowKey,
            Scope = connector.Scope
        };
    }

    private void SelectFlow(IConnectFlow flow)
    {
        _draft!.FlowKey = flow.Key;
        _draft.Settings["token"] = "";
    }

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            // Non-administrators self-service personal connectors only; administrators
            // choose the scope (their personal connectors stay owned by them).
            var scope = _canManage ? _draft!.Scope : SlotInstanceScope.Personal;
            _saved = await ConnectorStore.SaveAsync(
                _principalId!.Value.ToString("D"), _principalId, _draft!.ExistingName,
                _draft.DisplayName, _draft.FlowKey, _draft.Settings["token"], scope);
            _draft = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(ConnectorOverview connector)
    {
        _error = null;
        _saved = null;
        _busy = true;
        try
        {
            await ConnectorStore.DeleteAsync(_principalId!.Value.ToString("D"), connector.Id);
            _deleteCandidate = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>One connector tile: account glyph, identity, scope badge, and actions.</summary>
    private RenderFragment<ConnectorOverview> ConnectorCard => connector =>
        @<div class="connector-card">
            <span class="connector-icon"><ConnectorIcon FlowKey="@connector.FlowKey"/></span>
            <div class="connector-main">
                <span class="connector-name">@connector.DisplayName</span>
                <span class="connector-provider">@connector.FlowDisplayName</span>
                <span class="connector-badges">
                    @if (connector.Scope == SlotInstanceScope.Company)
                    {
                        <span class="badge badge-state badge-valid">company</span>
                    }
                    else if (connector.OwnerPrincipalId == _principalId)
                    {
                        <span class="badge badge-state badge-valid">yours</span>
                    }
                    else
                    {
                        <span class="badge badge-state">personal — @PrincipalName(connector.OwnerPrincipalId)</span>
                    }
                    <span class="badge badge-state badge-valid" title="A credential is stored — encrypted, never shown back.">connected</span>
                </span>
            </div>
            @if (CanEdit(connector))
            {
                <div class="connector-actions">
                    <button class="btn btn-secondary btn-sm" disabled="@_busy"
                            @onclick="() => StartEdit(connector)">Edit</button>
                    @if (_deleteCandidate == connector.Id)
                    {
                        <span class="confirm-inline">
                            Delete?
                            <button class="btn btn-danger btn-sm" disabled="@_busy"
                                    @onclick="() => DeleteAsync(connector)">Yes</button>
                            <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                    @onclick="() => _deleteCandidate = null">No</button>
                        </span>
                    }
                    else
                    {
                        <button class="btn btn-danger btn-sm" disabled="@_busy"
                                @onclick="() => _deleteCandidate = connector.Id">Delete</button>
                    }
                </div>
            }
        </div>;

}
