@page "/operator/artifact-triggers"
@attribute [Authorize]
@inject TriggerAdministration Triggers
@inject IDataAccess<PrincipalRecord> Principals
@inject IDataAccess<WorkflowConfigurationRecord> Configurations
@inject IPolicyEngine PolicyEngine

<PageTitle>Chaining — Auxilia</PageTitle>

<PageHeader Title="Chaining"
            Subtitle="Workflow chaining: when an artifact of the given type is persisted, the configured follow-up workflow is dispatched."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (!_allowed)
{
    <div class="panel denied">Access denied: @_denyReason</div>
}
else
{
    @if (_error is not null)
    {
        <div class="panel denied">@_error</div>
    }

    <section class="card">
        <div class="card-header">
            <h2>Chaining rules</h2>
        </div>
        @if (_triggers.Count == 0)
        {
            <div class="card-body">
                <p class="muted view-empty">No chaining rules configured yet — create one below.</p>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                <tr>
                    <th>Artifact type</th>
                    <th>Follow-up workflow</th>
                    <th>Enabled</th>
                    <th>Run as</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var trigger in _triggers)
                {
                    <tr>
                        <td class="cell-strong">@trigger.ArtifactType</td>
                        <td>
                            <span class="cell-strong">@WorkflowLabel(trigger)</span>
                            <span class="cell-sub">@trigger.WorkflowType</span>
                        </td>
                        <td>
                            <span class="badge badge-state @(trigger.Enabled ? "badge-success" : "badge-cancelled")">
                                @(trigger.Enabled ? "Enabled" : "Disabled")
                            </span>
                        </td>
                        <td>@PrincipalName(trigger.RunAsPrincipalId)</td>
                        <td>
                            <div class="cell-actions">
                                <button class="btn btn-secondary btn-sm" @onclick="() => ToggleAsync(trigger)" disabled="@_busy">
                                    @(trigger.Enabled ? "Disable" : "Enable")
                                </button>
                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(trigger.Id)" disabled="@_busy">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Create chaining rule</h2>
            <p class="card-subtitle">Example: every persisted code-review-report artifact starts a follow-up fix workflow.</p>
        </div>
        <div class="card-body form-grid">
            @if (_configurations.Count == 0)
            {
                <p class="muted">
                    No workflow configurations yet — chaining dispatches a configured workflow.
                    <a href="workflows/new">Configure one first</a>.
                </p>
            }
            else
            {
                <label>Artifact type <input @bind="_artifactType" placeholder="e.g. code-review-report"/></label>
                <label>
                    Follow-up workflow configuration
                    <select @bind="_configurationId">
                        <option value="" disabled>Pick a workflow configuration…</option>
                        @foreach (var configuration in _configurations)
                        {
                            <option value="@configuration.Id">@configuration.DisplayName (@configuration.WorkflowType)</option>
                        }
                    </select>
                    <span class="field-hint">Dispatched every time an artifact of the given type is persisted.</span>
                </label>
                <label>
                    Run as principal
                    <select @bind="_runAsPrincipalId">
                        <option value="">(none)</option>
                        @foreach (var principal in _principals)
                        {
                            <option value="@principal.Id">@principal.DisplayName</option>
                        }
                    </select>
                </label>
                <label class="check-label"><input type="checkbox" @bind="_enabled"/> Enabled</label>
                <div class="button-row">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">Save rule</button>
                </div>
            }
        </div>
    </section>
}

@code {

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    private bool _loaded;
    private bool _allowed;
    private bool _busy;
    private string _denyReason = "";
    private string? _error;
    private Guid? _principalId;

    private string _artifactType = "";
    private string _configurationId = "";
    private string _runAsPrincipalId = "";
    private bool _enabled = true;

    private IReadOnlyList<ArtifactTriggerRecord> _triggers = [];
    private IReadOnlyList<PrincipalRecord> _principals = [];
    private IReadOnlyList<WorkflowConfigurationRecord> _configurations = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        _principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (_principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(_principalId.Value, PermissionActions.TriggerConfigure, "artifact-triggers"));
            _allowed = decision.Allowed;
            _denyReason = decision.Reason;
        }
        else
        {
            _denyReason = "no platform principal in session";
        }

        if (_allowed)
            await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _triggers = await Triggers.ListArtifactAsync();
        var principals = await Principals.ReadAsync();
        _principals = principals.ToList().OrderBy(p => p.DisplayName).ToList();
        var configurations = await Configurations.ReadAsync();
        _configurations = configurations.OrderBy(c => c.DisplayName).ToList();
    }

    private string PrincipalName(Guid? id)
        => id is null ? "—" : _principals.FirstOrDefault(p => p.Id == id)?.DisplayName ?? id.Value.ToString();

    private string WorkflowLabel(ArtifactTriggerRecord trigger)
        => _configurations.FirstOrDefault(c => c.Id == trigger.WorkflowConfigurationId)?.DisplayName
           ?? trigger.WorkflowType;

    private Task SaveAsync()
        => RunAsync(async () =>
        {
            var configuration = Guid.TryParse(_configurationId, out var configurationId)
                ? _configurations.FirstOrDefault(c => c.Id == configurationId)
                : null;
            if (configuration is null)
                throw new InvalidOperationException("Pick the workflow configuration this rule dispatches.");

            await Triggers.SaveArtifactAsync(_principalId!.Value.ToString("D"), new ArtifactTriggerRecord
            {
                ArtifactType = _artifactType.Trim(),
                WorkflowType = configuration.WorkflowType,
                WorkflowPackageUri = configuration.PackageUri,
                WorkflowConfigurationId = configuration.Id,
                RunAsPrincipalId = Guid.TryParse(_runAsPrincipalId, out var runAs) ? runAs : null,
                Enabled = _enabled
            });
            _artifactType = _configurationId = _runAsPrincipalId = "";
            _enabled = true;
        });

    private Task ToggleAsync(ArtifactTriggerRecord trigger)
        => RunAsync(() => Triggers.SaveArtifactAsync(
            _principalId!.Value.ToString("D"), trigger with { Enabled = !trigger.Enabled }));

    private Task DeleteAsync(Guid id)
        => RunAsync(() => Triggers.DeleteArtifactAsync(_principalId!.Value.ToString("D"), id));

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

}
