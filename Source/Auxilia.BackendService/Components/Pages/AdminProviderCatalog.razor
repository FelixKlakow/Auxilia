@page "/admin/provider-catalog"
@attribute [Authorize]
@using Auxilia.Workflows
@inject ProviderCatalogService Catalog
@inject WorkflowConfigurationEditorService Editor
@inject IPolicyEngine PolicyEngine

<PageTitle>Provider catalog — Auxilia</PageTitle>

<PageHeader Title="Provider catalog"
            Subtitle="Which workflows may run on this platform and which slot providers may be configured for them. Provider availability is deny-by-default."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (!_allowed)
{
    <div class="panel denied">Access denied: @_denyReason</div>
}
else
{
    @if (_error is not null)
    {
        <div class="panel denied">@_error</div>
    }

    <section class="card">
        <div class="card-header">
            <h2>Registered workflows</h2>
            <p class="card-subtitle">A disabled workflow is not offered for new configurations and manual runs of it are rejected.</p>
        </div>
        @if (_workflows.Count == 0)
        {
            <div class="card-body"><p class="muted view-empty">No workflows registered yet.</p></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                <tr>
                    <th>Workflow</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var workflow in _workflows)
                {
                    <tr>
                        <td>
                            <span class="cell-strong">@workflow.DisplayName</span>
                            <span class="cell-sub">@workflow.WorkflowType@(workflow.Version.Length > 0 ? $" · v{workflow.Version}" : "")</span>
                        </td>
                        <td>
                            @if (workflow.Enabled)
                            {
                                <span class="badge badge-state badge-valid">enabled</span>
                            }
                            else
                            {
                                <span class="badge badge-state">disabled</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                    @onclick="() => ToggleWorkflowAsync(workflow)">
                                @(workflow.Enabled ? "Disable" : "Enable")
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Registered providers</h2>
            <p class="card-subtitle">A provider is offered in the editors only after it is made available here.</p>
        </div>
        @if (_entries.Count == 0)
        {
            <div class="card-body"><p class="muted view-empty">No slot-handler plugins registered.</p></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                <tr>
                    <th>Provider type</th>
                    <th>Category</th>
                    <th>Usable in workflows</th>
                    <th>Availability</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td>
                            <span class="cell-strong">@entry.ProviderType</span>
                            @if (entry.Description is { Length: > 0 })
                            {
                                <span class="cell-sub">@entry.Description</span>
                            }
                        </td>
                        <td>
                            @if (entry.Category.Length == 0)
                            {
                                <span class="muted">(uncategorized)</span>
                            }
                            else
                            {
                                <span class="type-chip">@entry.Category</span>
                            }
                        </td>
                        <td>
                            @{ var usable = UsableWorkflows(entry); }
                            @if (usable.Count == 0)
                            {
                                <span class="muted">no workflow can use this provider</span>
                            }
                            @foreach (var workflow in usable)
                            {
                                <span class="type-chip" title="@workflow.WorkflowType">@workflow.DisplayName</span>
                            }
                        </td>
                        <td>
                            @if (entry.Available)
                            {
                                <span class="badge badge-state badge-valid">available</span>
                            }
                            else
                            {
                                <span class="badge badge-state">hidden</span>
                            }
                        </td>
                        <td>
                            <div class="cell-actions">
                                <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                        @onclick="() => ToggleAvailabilityAsync(entry)">
                                    @(entry.Available ? "Make unavailable" : "Make available")
                                </button>
                                @if (entry.Descriptors.Count > 0)
                                {
                                    <button class="btn btn-secondary btn-sm"
                                            @onclick="() => _curatedProvider = _curatedProvider == entry.ProviderType ? null : entry.ProviderType">
                                        @(_curatedProvider == entry.ProviderType ? "Close settings" : "Curate settings")
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (_curatedProvider == entry.ProviderType)
                    {
                        <tr>
                            <td colspan="5">
                                <p class="field-hint">
                                    A disabled setting disappears from every editor and is no longer
                                    required — e.g. disable the external API key to only allow
                                    preassigned credentials. Stored values are kept.
                                </p>
                                <div class="cell-actions">
                                    @foreach (var descriptor in entry.Descriptors)
                                    {
                                        var disabled = entry.IsSettingDisabled(descriptor.Key);
                                        <span class="badge badge-secret" title="@descriptor.HelpText">
                                            @descriptor.Label (@descriptor.Kind)@(descriptor.Required ? " *" : "")
                                            @if (disabled)
                                            {
                                                <em> — disabled</em>
                                            }
                                        </span>
                                        <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                                @onclick="() => ToggleSettingAsync(entry, descriptor.Key, !disabled)">
                                            @(disabled ? "Enable" : "Disable")
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        }
    </section>
}

@code {

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    private bool _loaded;
    private bool _allowed;
    private bool _busy;
    private string _denyReason = "";
    private string? _error;
    private Guid? _principalId;
    private string? _curatedProvider;
    private IReadOnlyList<ProviderCatalogEntry> _entries = [];
    private IReadOnlyList<RegisteredWorkflow> _workflows = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        _principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (_principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(_principalId.Value, PermissionActions.ProviderCatalogManage, "provider-catalog"));
            _allowed = decision.Allowed;
            _denyReason = decision.Reason;
        }
        else
        {
            _denyReason = "no platform principal in session";
        }

        if (_allowed)
            await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _entries = await Catalog.ListAsync();
        _workflows = await Editor.RegisteredWorkflowsAsync();
    }

    /// <summary>Enabled workflows with a slot this provider can back (contract match).</summary>
    private IReadOnlyList<RegisteredWorkflow> UsableWorkflows(ProviderCatalogEntry entry)
        => _workflows
            .Where(w => w.Enabled && w.Slots.Any(s =>
                s.Contract is { Length: > 0 } contract && entry.Implements(contract)))
            .ToList();

    private async Task ToggleAvailabilityAsync(ProviderCatalogEntry entry)
        => await MutateAsync(() => Catalog.SetAvailabilityAsync(
            _principalId!.Value.ToString("D"), entry.ProviderType, !entry.Available));

    private async Task ToggleSettingAsync(ProviderCatalogEntry entry, string key, bool disabled)
        => await MutateAsync(() => Catalog.SetSettingDisabledAsync(
            _principalId!.Value.ToString("D"), entry.ProviderType, key, disabled));

    private async Task ToggleWorkflowAsync(RegisteredWorkflow workflow)
        => await MutateAsync(async () => await Editor.SetWorkflowEnabledAsync(
            _principalId!.Value.ToString("D"), workflow.WorkflowType, !workflow.Enabled));

    private async Task MutateAsync(Func<Task> action)
    {
        _error = null;
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

}
