@page "/admin/provider-catalog"
@attribute [Authorize]
@using Auxilia.Workflows
@inject ProviderCatalogService Catalog
@inject IPolicyEngine PolicyEngine

<PageTitle>Provider catalog — Auxilia</PageTitle>

<PageHeader Title="Provider catalog"
            Subtitle="Which registered slot providers may be picked when configuring slot instances and workflows. Availability is deny-by-default; everything else comes from the signed plugin manifest."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (!_allowed)
{
    <div class="panel denied">Access denied: @_denyReason</div>
}
else
{
    @if (_error is not null)
    {
        <div class="panel denied">@_error</div>
    }

    <section class="card">
        <div class="card-header">
            <h2>Registered providers</h2>
            <p class="card-subtitle">A provider is offered in the editors only after it is made available here.</p>
        </div>
        @if (_entries.Count == 0)
        {
            <div class="card-body"><p class="muted view-empty">No slot-handler plugins registered.</p></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                <tr>
                    <th>Provider type</th>
                    <th>Category</th>
                    <th>Contracts</th>
                    <th>Settings</th>
                    <th>Availability</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td>
                            <span class="cell-strong">@entry.ProviderType</span>
                            @if (entry.Description is { Length: > 0 })
                            {
                                <span class="cell-sub">@entry.Description</span>
                            }
                        </td>
                        <td>
                            @if (entry.Category.Length == 0)
                            {
                                <span class="muted">(uncategorized)</span>
                            }
                            else
                            {
                                <span class="type-chip">@entry.Category</span>
                            }
                        </td>
                        <td>
                            @if (entry.Contracts.Count == 0)
                            {
                                <span class="muted">(none declared)</span>
                            }
                            @foreach (var contract in entry.Contracts)
                            {
                                <span class="badge badge-secret" title="@contract">@ShortName(contract)</span>
                            }
                        </td>
                        <td>
                            @if (entry.Descriptors.Count == 0)
                            {
                                <span class="muted">(none declared)</span>
                            }
                            @foreach (var descriptor in entry.Descriptors)
                            {
                                <span class="badge badge-secret" title="@descriptor.Label">@descriptor.Key · @descriptor.Kind@(descriptor.Required ? " *" : "")</span>
                            }
                        </td>
                        <td>
                            @if (entry.Available)
                            {
                                <span class="badge badge-state badge-valid">available</span>
                            }
                            else
                            {
                                <span class="badge badge-state">hidden</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                    @onclick="() => ToggleAvailabilityAsync(entry)">
                                @(entry.Available ? "Make unavailable" : "Make available")
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}

@code {

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    private bool _loaded;
    private bool _allowed;
    private bool _busy;
    private string _denyReason = "";
    private string? _error;
    private Guid? _principalId;
    private IReadOnlyList<ProviderCatalogEntry> _entries = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        _principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (_principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(_principalId.Value, PermissionActions.ProviderCatalogManage, "provider-catalog"));
            _allowed = decision.Allowed;
            _denyReason = decision.Reason;
        }
        else
        {
            _denyReason = "no platform principal in session";
        }

        if (_allowed)
            _entries = await Catalog.ListAsync();
        _loaded = true;
    }

    private static string ShortName(string contract)
        => contract.LastIndexOf('.') is var dot and >= 0 ? contract[(dot + 1)..] : contract;

    private async Task ToggleAvailabilityAsync(ProviderCatalogEntry entry)
    {
        _error = null;
        _busy = true;
        try
        {
            await Catalog.SetAvailabilityAsync(
                _principalId!.Value.ToString("D"), entry.ProviderType, !entry.Available);
            _entries = await Catalog.ListAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

}
