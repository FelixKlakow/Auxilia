@page "/runs"
@attribute [Authorize]
@implements IDisposable
@inject IDataAccess<WorkflowInstanceRecord> Instances
@inject IDataAccess<WorkflowConfigurationRecord> Configurations
@inject WorkflowRerunService Rerun
@inject RunCancelService Cancel

<PageTitle>Runs — Auxilia</PageTitle>

<PageHeader Title="Runs" Subtitle="Every workflow execution on this platform — click a run to inspect its views."/>

@if (_error is not null)
{
    <div class="panel denied">@_error</div>
}
@if (_rerunNotice is not null)
{
    <div class="panel success">@_rerunNotice</div>
}

@if (Configuration is { } configurationFilter)
{
    @* Run-history mode (#21): a header card describing the filtered configuration. *@
    <section class="card history-card">
        <div class="card-header">
            <h2>
                @(_configuration?.DisplayName ?? ConfigurationDisplayName ?? configurationFilter.ToString("N")[..8])
                @if ((_configuration?.WorkflowType ?? _runs.FirstOrDefault()?.WorkflowType) is { } workflowType)
                {
                    <span class="type-chip">@workflowType</span>
                }
            </h2>
            <div class="card-actions">
                @if (_configuration is not null)
                {
                    <span class="badge badge-state @(_configuration.Enabled ? "badge-success" : "badge-cancelled")">
                        @(_configuration.Enabled ? "Enabled" : "Disabled")
                    </span>
                    <a class="btn btn-secondary btn-sm" href="workflows/@_configuration.Id/edit">Edit configuration</a>
                }
                <a class="btn btn-secondary btn-sm" href="runs">All runs</a>
            </div>
            <p class="card-subtitle">Run history of this workflow configuration — newest first.</p>
        </div>
    </section>
}

@if (_runs.Count == 0)
{
    @if (Configuration is null)
    {
        <EmptyState Title="No workflow runs yet"
                    Description="Runs appear here as soon as a task source, schedule, or trigger dispatches a workflow."/>
    }
    else
    {
        <EmptyState Title="No runs for this configuration yet"
                    Description="Runs appear here as soon as this configuration's trigger fires or it is run manually."/>
    }
}
else
{
    <div class="chip-bar" role="group" aria-label="Filter runs by state">
        @foreach (var state in StateOptions)
        {
            var count = CountOf(state);
            <button class="chip @(_stateFilter == state ? "active" : null)"
                    @onclick="() => _stateFilter = state">
                @state
                <span class="chip-count">@count</span>
            </button>
        }
    </div>

    <div class="card">
        <table class="data-table">
            <thead>
            <tr>
                <th>State</th>
                <th>Workflow</th>
                <th>Trigger origin</th>
                <th>Started</th>
                <th>Duration</th>
                <th>Error</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var run in FilteredRuns)
            {
                <tr>
                    <td><span class="badge badge-state badge-@run.State.ToLowerInvariant()">@run.State</span></td>
                    <td>
                        <a class="cell-strong" href="runs/@run.Id">@run.WorkflowType</a>
                        <span class="muted mono"> @ShortId(run.Id)</span>
                        @if (run.WorkflowConfigurationName is { Length: > 0 } configurationName)
                        {
                            <span class="cell-sub">@configurationName</span>
                        }
                    </td>
                    @{
                        var origin = OriginOf(run);
                    }
                    <td>
                        @if (origin.PredecessorInstanceId is { } predecessorId)
                        {
                            <a class="type-chip" href="runs/@predecessorId"
                               title="Open the run this one was rerun from">@origin.Label</a>
                        }
                        else
                        {
                            <span class="cell-truncate" title="@origin.Label">@origin.Label</span>
                        }
                    </td>
                    <td>
                        @TimeText.Relative(run.CreatedUtc)
                        <span class="cell-sub">@run.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                    </td>
                    <td>@TimeText.Duration(run.CreatedUtc, run.CompletedUtc)</td>
                    <td class="error-cell">@run.ErrorMessage</td>
                    <td>
                        @if (WorkflowRerunService.IsTerminal(run) && run.DispatchCommandJson is not null)
                        {
                            <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                    @onclick="() => RerunAsync(run.Id)">Rerun</button>
                        }
                        else if (!WorkflowRerunService.IsTerminal(run))
                        {
                            <button class="btn btn-danger btn-sm" disabled="@_busy"
                                    @onclick="() => CancelAsync(run.Id)">Cancel</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (!FilteredRuns.Any())
        {
            <div class="card-body"><p class="muted view-empty">No runs in this state.</p></div>
        }
    </div>
}

@code {

    private static readonly string[] StateOptions =
        ["All", "Running", "Success", "Failed", "Queued", "Cancelled", "PreFlightFailed"];

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Optional filter: show only runs dispatched from this workflow configuration.</summary>
    [SupplyParameterFromQuery(Name = "configuration")]
    public Guid? Configuration { get; set; }

    // Backplane-less v1: the component polls the data layer every 2 s instead of
    // subscribing to the SignalR fan-out hub from its own circuit.
    private IReadOnlyList<WorkflowInstanceRecord> _runs = [];
    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private string _stateFilter = "All";
    private string? _error;
    private string? _rerunNotice;
    private bool _busy;
    private WorkflowConfigurationRecord? _configuration;
    private Dictionary<Guid, TriggerOrigin> _origins = [];

    private string? ConfigurationDisplayName
        => _runs.FirstOrDefault(r => r.WorkflowConfigurationName is not null)?.WorkflowConfigurationName;

    private IEnumerable<WorkflowInstanceRecord> FilteredRuns
        => _stateFilter == "All" ? _runs : _runs.Where(r => r.State == _stateFilter);

    private int CountOf(string state)
        => state == "All" ? _runs.Count : _runs.Count(r => r.State == state);

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _timer is not null)
            return;
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed — polling ends.
        }
    }

    private async Task LoadAsync()
    {
        var all = await Instances.ReadAsync(_cts.Token);
        var query = all.OrderByDescending(r => r.CreatedUtc).AsEnumerable();
        if (Configuration is { } configurationId)
            query = query.Where(r => r.WorkflowConfigurationId == configurationId);
        _runs = query.Take(200).ToList();

        if (Configuration is { } id)
            _configuration = await Configurations.ReadAsync(id, _cts.Token);

        // Origins are derived from the stored dispatch command; cached per load so the
        // JSON is not re-parsed on every render of the 2 s poll.
        _origins = _runs.ToDictionary(r => r.Id, TriggerOrigin.Of);
    }

    private TriggerOrigin OriginOf(WorkflowInstanceRecord run)
        => _origins.TryGetValue(run.Id, out var origin) ? origin : TriggerOrigin.Of(run);

    private async Task CancelAsync(Guid instanceId)
    {
        _error = null;
        _busy = true;
        try
        {
            var user = (await AuthState!).User;
            if (DashboardAuthEndpoints.PrincipalIdOf(user) is not { } principalId)
            {
                _error = "No platform principal in session.";
                return;
            }

            await Cancel.RequestCancelAsync(principalId, instanceId, _cts.Token);
            _rerunNotice = $"Cancellation of {ShortId(instanceId)} requested — the state flips once the workflow acknowledges.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RerunAsync(Guid instanceId)
    {
        _error = null;
        _rerunNotice = null;
        _busy = true;
        try
        {
            var user = (await AuthState!).User;
            var principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
            if (principalId is null)
            {
                _error = "No platform principal in session.";
                return;
            }

            var commandId = await Rerun.RerunAsync(principalId.Value, instanceId, _cts.Token);
            _rerunNotice = $"Rerun of {ShortId(instanceId)} dispatched (command {commandId}). The new run appears below shortly.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }

}
