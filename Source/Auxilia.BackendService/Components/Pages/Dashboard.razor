@page "/"
@page "/dashboard"
@attribute [Authorize]
@using System.Text.Json
@using Auxilia.Workflows.Messaging.Messages
@using Auxilia.Workflows.Views
@implements IDisposable
@inject DashboardComposer Composer
@inject IDataAccess<WorkflowInstanceRecord> Instances
@inject IDataAccess<ViewDataRecord> ViewData
@inject IPolicyEngine PolicyEngine
@inject LiveViewBroker Broker
@inject DashboardStatsService Stats
@inject RunCancelService Cancel

<PageTitle>Dashboard — Auxilia</PageTitle>

<PageHeader Title="Dashboard" Subtitle="What is running right now, plus the views you pinned from workflow runs — updated live."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (_principalId is null)
{
    <div class="panel denied">Access denied: no platform principal in session.</div>
}
else
{
    @if (_error is not null)
    {
        <div class="panel denied">@_error</div>
    }

    @if (_stats is { SetupComplete: false } setup)
    {
        <section class="card getting-started">
            <div class="card-header">
                <h2>Getting started</h2>
                <p class="card-subtitle">
                    @setup.GettingStarted.Count(s => s.Done) of @setup.GettingStarted.Count steps done —
                    the platform runs on its own once all are checked.
                </p>
            </div>
            <ol class="setup-steps">
                @foreach (var step in setup.GettingStarted)
                {
                    <li class="setup-step @(step.Done ? "setup-step-done" : null)">
                        <span class="setup-step-mark">@(step.Done ? "✓" : "")</span>
                        <div>
                            <a class="cell-strong" href="@step.Href">@step.Title</a>
                            <span class="cell-sub">@step.Description</span>
                        </div>
                    </li>
                }
            </ol>
        </section>
    }

    @if (_stats is not null)
    {
        <div class="stat-grid">
            <div class="stat-tile">
                <span class="stat-value">@_stats.Runs24h</span>
                <span class="stat-label">runs (24 h)</span>
            </div>
            <div class="stat-tile @(_stats.SuccessRatePercent is < 100 ? "stat-warn" : null)">
                <span class="stat-value">@(_stats.SuccessRatePercent is { } rate ? $"{rate}%" : "—")</span>
                <span class="stat-label">success rate (24 h)</span>
            </div>
            <div class="stat-tile @(_stats.Failures24h > 0 ? "stat-bad" : null)">
                <span class="stat-value">@_stats.Failures24h</span>
                <span class="stat-label">failures (24 h)</span>
            </div>
            <div class="stat-tile">
                <span class="stat-value">@_stats.EnabledConfigurations</span>
                <span class="stat-label">enabled workflows</span>
            </div>
        </div>

        @if (_stats.Attention.Count > 0)
        {
            <section class="card attention-card">
                <div class="card-header"><h2>Needs attention</h2></div>
                <ul class="attention-list">
                    @foreach (var item in _stats.Attention)
                    {
                        <li><a href="@item.Href">@item.Text</a></li>
                    }
                </ul>
            </section>
        }
    }

    <section class="live-now-section">
        <h2 class="section-title">Live now</h2>
        @if (_liveNow.Count == 0)
        {
            <EmptyState Title="Nothing running right now"
                        Description="Runs appear here the moment a trigger fires."/>
        }
        else
        {
            <div class="card">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>State</th>
                        <th>Workflow</th>
                        <th>Started</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in _liveNow)
                    {
                        <tr>
                            <td><span class="badge badge-state badge-@run.State.ToLowerInvariant()">@run.State</span></td>
                            <td>
                                <a class="cell-strong" href="runs/@run.Id">@(run.WorkflowConfigurationName ?? run.WorkflowType)</a>
                                <span class="muted mono"> @run.Id.ToString("N")[..8]</span>
                                @if (run.WorkflowConfigurationName is not null)
                                {
                                    <span class="cell-sub">@run.WorkflowType</span>
                                }
                            </td>
                            <td>@TimeText.Relative(run.CreatedUtc)</td>
                            <td>
                                <button class="btn btn-danger btn-sm" disabled="@_busy"
                                        @onclick="() => CancelRunAsync(run.Id)">Cancel</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_stats is { RecentRuns.Count: > 0 })
    {
        <section class="recent-runs-section">
            <h2 class="section-title">Recent runs</h2>
            <div class="card">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>State</th>
                        <th>Workflow</th>
                        <th>Started</th>
                        <th>Duration</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in _stats.RecentRuns)
                    {
                        <tr>
                            <td><span class="badge badge-state badge-@run.State.ToLowerInvariant()">@run.State</span></td>
                            <td>
                                <a class="cell-strong" href="runs/@run.Id">@(run.WorkflowConfigurationName ?? run.WorkflowType)</a>
                                <span class="muted mono"> @run.Id.ToString("N")[..8]</span>
                            </td>
                            <td>@TimeText.Relative(run.CreatedUtc)</td>
                            <td>@TimeText.Duration(run.CreatedUtc, run.CompletedUtc)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <h2 class="section-title">Pinned views</h2>
    @if (_panels.Count == 0)
    {
        <EmptyState Title="Nothing pinned yet">
            <p class="empty-description">
                Open a <a href="runs">run</a> and pin one of its views — it will stay on this dashboard
                and update live while the workflow is running.
            </p>
        </EmptyState>
    }
    else
    {
        <div class="panel-grid">
            @foreach (var panel in _panels)
            {
                <section class="card dashboard-panel">
                    <div class="card-header">
                        <h2 class="view-title">
                            @panel.Pin.DisplayTitle
                            @if (panel.Run is not null)
                            {
                                <span class="badge badge-state badge-@panel.Run.State.ToLowerInvariant()">@panel.Run.State</span>
                            }
                        </h2>
                        <div class="card-actions">
                            <a class="btn btn-secondary btn-sm" href="runs/@panel.Pin.InstanceId">Open run</a>
                            <button class="btn btn-secondary btn-sm" @onclick="() => UnpinAsync(panel.Pin)">Unpin</button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (!panel.Allowed)
                        {
                            <div class="panel denied">Access denied: @panel.DenyReason</div>
                        }
                        else if (panel.Descriptor is null)
                        {
                            <div class="panel denied">View '@panel.Pin.ViewName' is no longer declared by this run.</div>
                        }
                        else
                        {
                            <ViewRenderer Descriptor="panel.Descriptor" Items="panel.Buffer.Items"
                                          IsLive="panel.Run?.CompletedUtc is null"/>
                        }
                    </div>
                </section>
            }
        </div>
    }
}

@code {

    private sealed class PinnedPanel
    {
        public required DashboardPin Pin { get; init; }
        public WorkflowInstanceRecord? Run { get; set; }
        public ViewDescriptor? Descriptor { get; set; }
        public bool Allowed { get; set; }
        public string DenyReason { get; set; } = "";
        public ViewItemBuffer Buffer { get; } = new();
    }

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private IDisposable? _liveSubscription;
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private Guid? _principalId;
    private List<PinnedPanel> _panels = [];
    private IReadOnlyList<WorkflowInstanceRecord> _liveNow = [];
    private DashboardStats? _stats;

    protected override async Task OnInitializedAsync()
    {
        var user = (await (AuthState ?? Task.FromResult(new AuthenticationState(new())))).User;
        _principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (_principalId is not null)
        {
            await LoadLiveNowAsync();
            await LoadStatsAsync();
            await LoadPanelsAsync();
            // Live path: in-process fan-out from the bus handlers (LiveViewBroker).
            _liveSubscription = Broker.Subscribe(OnLiveViewData, OnLiveStatus);
        }

        _loaded = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _timer is not null || _principalId is null)
            return;
        // Degraded-mode fallback: reconcile against the persisted store in case a push was missed.
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = PollAsync();
    }

    /// <summary>The Live now section: every currently active run, newest first (#21).</summary>
    private async Task LoadLiveNowAsync()
        => _liveNow = LiveNow.ActiveOf(await Instances.ReadAsync(_cts.Token));

    private async Task LoadStatsAsync()
        => _stats = await Stats.GetAsync(_cts.Token);

    private async Task CancelRunAsync(Guid instanceId)
    {
        _error = null;
        _busy = true;
        try
        {
            await Cancel.RequestCancelAsync(_principalId!.Value, instanceId, _cts.Token);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadPanelsAsync()
    {
        var pins = await Composer.GetPinsAsync(_principalId!.Value, _cts.Token);
        var panels = new List<PinnedPanel>();
        foreach (var pin in pins)
        {
            var existing = _panels.FirstOrDefault(p =>
                p.Pin.InstanceId == pin.InstanceId && p.Pin.ViewName == pin.ViewName);
            var panel = existing ?? new PinnedPanel { Pin = pin };
            panel.Run = await Instances.ReadAsync(pin.InstanceId, _cts.Token);
            if (panel.Run is null)
            {
                panel.Allowed = false;
                panel.DenyReason = "run no longer exists";
                panels.Add(panel);
                continue;
            }

            if (existing is null)
            {
                // Access to a pinned view follows the workflow it belongs to. Evaluated once
                // per panel and circuit (not on every poll) so reconciliation does not flood
                // the audit log — every evaluation is an audited policy decision.
                var decision = await PolicyEngine.EvaluateAsync(
                    new PolicyContext(_principalId.Value, PermissionActions.ViewSubscribe,
                        $"{pin.InstanceId}:{pin.ViewName}") { WorkflowType = panel.Run.WorkflowType },
                    _cts.Token);
                panel.Allowed = decision.Allowed;
                panel.DenyReason = decision.Reason;
            }

            panel.Descriptor = ParseDescriptors(panel.Run.ViewsJson)
                .FirstOrDefault(v => v.Name == pin.ViewName);
            panels.Add(panel);
        }

        var allItems = await ViewData.ReadAsync(_cts.Token);
        foreach (var panel in panels.Where(p => p.Allowed && p.Descriptor is not null))
        {
            panel.Buffer.Merge(allItems
                .Where(i => i.WorkflowInstanceId == panel.Pin.InstanceId && i.ViewName == panel.Pin.ViewName)
                .ToList());
        }

        _panels = panels;
    }

    private static IReadOnlyList<ViewDescriptor> ParseDescriptors(string? viewsJson)
    {
        if (string.IsNullOrWhiteSpace(viewsJson))
            return [];
        try
        {
            return JsonSerializer.Deserialize<List<ViewDescriptor>>(viewsJson) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private void OnLiveViewData(ViewDataMessage message)
    {
        _ = InvokeAsync(() =>
        {
            var panel = _panels.FirstOrDefault(p =>
                p.Allowed &&
                p.Pin.InstanceId == message.WorkflowInstanceId &&
                p.Pin.ViewName == message.ViewName);
            if (panel is null)
                return;

            var record = new ViewDataRecord
            {
                Id = ViewDataRecord.IdFor(message.WorkflowInstanceId, message.ViewName, message.Sequence),
                WorkflowInstanceId = message.WorkflowInstanceId,
                ViewName = message.ViewName,
                Sequence = message.Sequence,
                PayloadJson = message.PayloadJson,
                TimestampUtc = DateTimeOffset.UtcNow
            };
            if (panel.Buffer.Add(record))
                StateHasChanged();
        });
    }

    private void OnLiveStatus(WorkflowStatusEvent statusEvent)
    {
        _ = InvokeAsync(async () =>
        {
            // Every lifecycle event can change the Live now section; pinned panels only
            // need a refresh when the event belongs to one of them.
            await LoadLiveNowAsync();
            await LoadStatsAsync();
            foreach (var panel in _panels.Where(p => p.Pin.InstanceId == statusEvent.WorkflowInstanceId))
                panel.Run = await Instances.ReadAsync(panel.Pin.InstanceId, _cts.Token) ?? panel.Run;
            StateHasChanged();
        });
    }

    private async Task UnpinAsync(DashboardPin pin)
    {
        _error = null;
        try
        {
            await Composer.UnpinAsync(_principalId!.Value, _principalId.Value,
                pin.InstanceId, pin.ViewName, _cts.Token);
            await LoadPanelsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadLiveNowAsync();
                await LoadStatsAsync();
                await LoadPanelsAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed — polling ends.
        }
    }

    public void Dispose()
    {
        _liveSubscription?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }

}
