@page "/flows"
@attribute [Authorize]
@inject WorkflowConfigurationEditorService Editor
@inject IPolicyEngine PolicyEngine

<PageTitle>Flows — Auxilia</PageTitle>

<PageHeader Title="Flows"
            Subtitle="The whole pipeline at a glance: every workflow configuration and how artifacts chain them together. Open a workflow's own flow to wire new chains."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (!_allowed)
{
    <div class="panel denied">Access denied: @_denyReason</div>
}
else if (_flow is null || _flow.Nodes.Count == 0)
{
    <EmptyState Title="No workflow configurations yet"
                Description="Create one under Workflows — it appears here with its triggers and outputs."/>
}
else
{
    <div class="flow-canvas">
        <div class="flow-board" style="width:@(Px(_boardWidth)); height:@(Px(_boardHeight));">
            <svg class="flow-edges" width="@_boardWidth" height="@_boardHeight"
                 viewBox="0 0 @_boardWidth @_boardHeight" aria-hidden="true">
                @foreach (var edge in _edgePaths)
                {
                    <path d="@edge.Path" fill="none"/>
                    @* Razor reserves <text>, so the SVG label is emitted as encoded markup. *@
                    @((MarkupString)EdgeLabelMarkup(edge))
                }
            </svg>

            @foreach (var node in _flow.Nodes)
            {
                var box = _boxes[node.Id];
                <a class="flow-node flow-node-workflow flow-abs flow-node-link" style="@Style(box)"
                   href="workflows/@node.Id/flow" title="Open this workflow's flow">
                    @if (_hasIncoming.Contains(node.Id))
                    {
                        <span class="flow-port flow-port-in" style="top:@Px(box.H / 2)"></span>
                    }
                    @if (node.Outputs.Count > 0)
                    {
                        <span class="flow-port flow-port-out" style="top:@Px(box.H / 2)"></span>
                    }
                    <div class="flow-node-head">
                        <span class="flow-node-icon">@WorkflowIcon</span>
                        <div class="flow-node-head-text">
                            <span class="flow-node-kind">workflow</span>
                            <span class="flow-node-title">@node.DisplayName</span>
                        </div>
                    </div>
                    <span class="flow-node-subtitle">@node.WorkflowType</span>
                    <div class="flow-node-actions">
                        <span class="badge badge-state @(node.Enabled ? "badge-success" : "badge-cancelled")">
                            @(node.Enabled ? "Enabled" : "Disabled")
                        </span>
                        @if (node.Triggers.Count > 0)
                        {
                            var failing = node.Triggers.Any(t => t.Failing);
                            <span class="trigger-health @(failing ? "trigger-health-failing" : null)"
                                  title="@string.Join(" · ", node.Triggers.Select(t => t.Label))">
                                <span class="trigger-health-dot"></span>
                                @node.Triggers.Count trigger@(node.Triggers.Count == 1 ? "" : "s")
                            </span>
                        }
                    </div>
                </a>
            }
        </div>
    </div>
}

@code {

    private const double NodeWidth = 250;
    private const double NodeHeight = 150;
    private const double ColumnGap = 130;
    private const double RowGap = 30;

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    private bool _loaded;
    private bool _allowed;
    private string _denyReason = "";
    private WorkflowConfigurationEditorService.GlobalFlow? _flow;

    private sealed record Box(double X, double Y, double W, double H);

    private sealed record EdgePath(string Path, double LabelX, double LabelY, string Label);

    private Dictionary<Guid, Box> _boxes = [];
    private IReadOnlyList<EdgePath> _edgePaths = [];
    private HashSet<Guid> _hasIncoming = [];
    private double _boardWidth;
    private double _boardHeight;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        var principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(principalId.Value, PermissionActions.WorkflowConfigurationManage,
                    "workflow-configurations"));
            _allowed = decision.Allowed;
            _denyReason = decision.Reason;
        }
        else
        {
            _denyReason = "no platform principal in session";
        }

        if (_allowed)
        {
            _flow = await Editor.GlobalFlowAsync();
            ComputeLayout();
        }

        _loaded = true;
    }

    /// <summary>
    /// Layered layout: a node's column is the longest chain of edges leading to it, so
    /// producers stand left of their consumers; columns stack vertically centered.
    /// </summary>
    private void ComputeLayout()
    {
        var nodes = _flow!.Nodes;
        var edges = _flow.Edges;
        _hasIncoming = edges.Select(e => e.ConsumerId).ToHashSet();

        var depths = nodes.ToDictionary(n => n.Id, _ => 0);
        // Longest-path relaxation with a fixed bound: chains are short, cycles must not hang the page.
        for (var pass = 0; pass < nodes.Count; pass++)
        {
            var changed = false;
            foreach (var edge in edges)
            {
                var candidate = depths[edge.ProducerId] + 1;
                if (candidate <= depths[edge.ConsumerId] || candidate > nodes.Count)
                    continue;
                depths[edge.ConsumerId] = candidate;
                changed = true;
            }
            if (!changed)
                break;
        }

        var columns = nodes
            .GroupBy(n => depths[n.Id])
            .OrderBy(g => g.Key)
            .ToList();
        var maxDepth = columns.Count == 0 ? 0 : columns[^1].Key;
        var tallest = columns.Count == 0 ? 0 : columns.Max(c => c.Count());
        _boardWidth = (maxDepth + 1) * NodeWidth + maxDepth * ColumnGap;
        _boardHeight = tallest * NodeHeight + Math.Max(0, tallest - 1) * RowGap + 20;

        _boxes = [];
        foreach (var column in columns)
        {
            var entries = column.OrderBy(n => n.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
            var columnHeight = entries.Count * NodeHeight + (entries.Count - 1) * RowGap;
            var y = (_boardHeight - columnHeight) / 2;
            foreach (var node in entries)
            {
                _boxes[node.Id] = new Box(
                    column.Key * (NodeWidth + ColumnGap), y, NodeWidth, NodeHeight);
                y += NodeHeight + RowGap;
            }
        }

        _edgePaths = edges
            .Where(e => _boxes.ContainsKey(e.ProducerId) && _boxes.ContainsKey(e.ConsumerId))
            .Select(e =>
            {
                var from = _boxes[e.ProducerId];
                var to = _boxes[e.ConsumerId];
                var x1 = from.X + from.W;
                var y1 = from.Y + from.H / 2;
                var x2 = to.X;
                var y2 = to.Y + to.H / 2;
                var bend = (x2 - x1) / 2;
                return new EdgePath(
                    FormattableString.Invariant($"M {x1} {y1} C {x1 + bend} {y1}, {x2 - bend} {y2}, {x2} {y2}"),
                    (x1 + x2) / 2, (y1 + y2) / 2 - 8, e.ArtifactType);
            })
            .ToList();
    }

    private static string Px(double value) => FormattableString.Invariant($"{value}px");

    private static string EdgeLabelMarkup(EdgePath edge)
        => FormattableString.Invariant(
            $"""<text x="{edge.LabelX}" y="{edge.LabelY}" class="flow-edge-label" text-anchor="middle">""")
           + System.Net.WebUtility.HtmlEncode(edge.Label) + "</text>";

    private static string Style(Box box)
        => FormattableString.Invariant(
            $"left:{box.X}px; top:{box.Y}px; width:{box.W}px; min-height:{box.H}px;");

    private static readonly MarkupString WorkflowIcon = new(
        """<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/></svg>""");

}
