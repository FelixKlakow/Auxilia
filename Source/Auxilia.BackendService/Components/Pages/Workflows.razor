@page "/workflows"
@attribute [Authorize]
@implements IDisposable
@inject WorkflowConfigurationEditorService Editor
@inject IPolicyEngine PolicyEngine

<PageTitle>Workflows — Auxilia</PageTitle>

<PageHeader Title="Workflows"
            Subtitle="Every configured workflow on this platform: what it does, where its work comes from, and how its runs are triggered."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (!_allowed)
{
    <div class="panel denied">Access denied: @_denyReason</div>
}
else
{
    @if (_error is not null)
    {
        <div class="panel denied">@_error</div>
    }
    @if (_runNotice is not null)
    {
        <div class="panel success">@_runNotice</div>
    }
    @if (Saved)
    {
        <div class="panel success">Configuration saved — the Steering Instance is applying it; the card below updates automatically.</div>
    }

    <div class="toolbar">
        <a class="btn btn-primary" href="workflows/new">New workflow configuration</a>
    </div>

    @if (_configurations.Count == 0)
    {
        <EmptyState Title="No workflows configured yet"
                    Description="A workflow configuration binds a workflow's capability slots to providers (Jira, email, a repository …) and wires a trigger — all visually, no JSON.">
            <a class="btn btn-primary" href="workflows/new">Configure your first workflow</a>
        </EmptyState>
    }

    @foreach (var configuration in _configurations)
    {
        <section class="card workflow-card">
            <div class="card-header">
                <h2>@configuration.DisplayName <span class="type-chip">@configuration.WorkflowType</span></h2>
                <div class="card-actions">
                    <span class="badge badge-state @(configuration.Enabled ? "badge-success" : "badge-cancelled")">
                        @(configuration.Enabled ? "Enabled" : "Disabled")
                    </span>
                    <button class="btn btn-secondary btn-sm" disabled="@_busy"
                            @onclick="() => ToggleEnabledAsync(configuration)">
                        @(configuration.Enabled ? "Disable" : "Enable")
                    </button>
                </div>
            </div>
            <div class="card-body workflow-card-body">
                <div class="workflow-facts">
                    <div>
                        <h3 class="fact-label">Slots</h3>
                        @if (configuration.Bindings.Count == 0)
                        {
                            <p class="muted">No slot bindings.</p>
                        }
                        <ul class="binding-list">
                            @foreach (var (slotName, providerType) in configuration.Bindings)
                            {
                                <li><span class="cell-strong">@slotName</span> <span class="binding-arrow">→</span> @providerType</li>
                            }
                        </ul>
                    </div>
                    <div>
                        <h3 class="fact-label">@(configuration.TriggerSummaries.Count == 1 ? "Trigger" : "Triggers")</h3>
                        @foreach (var trigger in configuration.TriggerSummaries)
                        {
                            <p class="fact-line">
                                @trigger.Label
                                @if (trigger.Health is { Length: > 0 })
                                {
                                    <span class="trigger-health @(trigger.Failing ? "trigger-health-failing" : null)"
                                          title="@trigger.Health">
                                        <span class="trigger-health-dot"></span>@trigger.Health
                                    </span>
                                }
                            </p>
                        }
                        @if (configuration.TriggerSummaries.Count == 0)
                        {
                            <p class="muted">None — runs start via rerun or manual dispatch only.</p>
                        }
                    </div>
                    <div>
                        <h3 class="fact-label">Last run</h3>
                        @if (configuration.LastRun is { } run)
                        {
                            <p class="fact-line">
                                <span class="badge badge-state badge-@run.State.ToLowerInvariant()">@run.State</span>
                                <a href="runs/@run.Id">@TimeText.Relative(run.CreatedUtc)</a>
                            </p>
                        }
                        else
                        {
                            <p class="muted">No runs yet.</p>
                        }
                    </div>
                </div>
            </div>
            @if (_runCandidate == configuration.Id)
            {
                <div class="card-body run-now-form">
                    <label>
                        Instruction
                        <textarea rows="3" @bind="_runInstruction"
                                  placeholder="What should this run do? (becomes the run's input, like a triggering mail's body)"></textarea>
                        <span class="field-hint">
                            Every run needs input — for a coding session this is the task; for a review, the context.
                        </span>
                    </label>
                    <div class="button-row">
                        <button class="btn btn-primary btn-sm"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_runInstruction))"
                                @onclick="() => StartRunAsync(configuration)">Start run</button>
                        <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                @onclick="() => _runCandidate = null">Cancel</button>
                    </div>
                </div>
            }
            <div class="card-footer">
                <div class="cell-actions">
                    <button class="btn btn-primary btn-sm" disabled="@(_busy || !configuration.Enabled)"
                            title="@(configuration.Enabled ? "Start a run with an instruction" : "Enable the configuration first")"
                            @onclick="() => BeginRun(configuration.Id)">Run…</button>
                    <a class="btn btn-secondary btn-sm" href="workflows/@configuration.Id/flow">Flow</a>
                    <a class="btn btn-secondary btn-sm" href="workflows/@configuration.Id/edit">Edit</a>
                    <button class="btn btn-secondary btn-sm" disabled="@_busy"
                            @onclick="() => DuplicateAsync(configuration)">Duplicate</button>
                    <a class="btn btn-secondary btn-sm" href="runs?configuration=@configuration.Id">View runs</a>
                    @if (_deleteCandidate == configuration.Id)
                    {
                        <span class="confirm-inline">
                            Delete "@configuration.DisplayName"?
                            <button class="btn btn-danger btn-sm" disabled="@_busy"
                                    @onclick="() => DeleteAsync(configuration)">Delete</button>
                            <button class="btn btn-secondary btn-sm" disabled="@_busy"
                                    @onclick="() => _deleteCandidate = null">Cancel</button>
                        </span>
                    }
                    else
                    {
                        <button class="btn btn-danger btn-sm" disabled="@_busy"
                                @onclick="() => _deleteCandidate = configuration.Id">Delete</button>
                    }
                </div>
            </div>
        </section>
    }

}

@code {

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    public bool Saved { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private bool _loaded;
    private bool _allowed;
    private bool _busy;
    private string _denyReason = "";
    private string? _error;
    private Guid? _principalId;
    private Guid? _deleteCandidate;
    private Guid? _runCandidate;
    private string _runInstruction = "";
    private string? _runNotice;
    private IReadOnlyList<WorkflowConfigurationOverview> _configurations = [];

    private void BeginRun(Guid configurationId)
    {
        _error = null;
        _runNotice = null;
        _runInstruction = "";
        _runCandidate = configurationId;
    }

    private async Task StartRunAsync(WorkflowConfigurationOverview configuration)
    {
        _error = null;
        _runNotice = null;
        _busy = true;
        try
        {
            await Editor.RunNowAsync(
                _principalId!.Value.ToString("D"), _principalId, configuration.Id,
                title: $"Run of '{configuration.DisplayName}'", instruction: _runInstruction, _cts.Token);
            _runCandidate = null;
            _runNotice = "Run dispatched — it appears under Runs within a few seconds.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        _principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (_principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(_principalId.Value, PermissionActions.WorkflowConfigurationManage,
                    "workflow-configurations"));
            _allowed = decision.Allowed;
            _denyReason = decision.Reason;
        }
        else
        {
            _denyReason = "no platform principal in session";
        }

        if (_allowed)
            await LoadAsync();
        _loaded = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _timer is not null || !_allowed)
            return;
        // The Steering Instance applies bus-published changes asynchronously — poll so a
        // freshly saved configuration appears without a manual refresh.
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed — polling ends.
        }
    }

    private async Task LoadAsync() => _configurations = await Editor.ListAsync(_cts.Token);

    private Task ToggleEnabledAsync(WorkflowConfigurationOverview configuration)
        => RunAsync(() => Editor.SetEnabledAsync(Actor, configuration.Id, !configuration.Enabled));

    private Task DuplicateAsync(WorkflowConfigurationOverview configuration)
        => RunAsync(() => Editor.DuplicateAsync(Actor, configuration.Id));

    private Task DeleteAsync(WorkflowConfigurationOverview configuration)
        => RunAsync(async () =>
        {
            await Editor.DeleteAsync(Actor, configuration.Id);
            _deleteCandidate = null;
        });

    private string Actor => _principalId!.Value.ToString("D");

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }

}
