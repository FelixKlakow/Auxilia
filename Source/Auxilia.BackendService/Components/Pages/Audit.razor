@page "/audit"
@attribute [Authorize]
@inject IDataAccess<AuditRecord> AuditRecords
@inject IDataAccess<PrincipalRecord> Principals
@inject IPolicyEngine PolicyEngine

<PageTitle>Audit — Auxilia</PageTitle>

<PageHeader Title="Audit log"
            Subtitle="Every policy decision and administrative change, newest first. Entries are immutable."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (!_allowed)
{
    <div class="panel denied">Access denied: @_denyReason</div>
}
else
{
    <div class="toolbar audit-toolbar">
        <label>
            Filter (action / actor / subject)
            <input @bind="_filter" @bind:event="oninput" placeholder="e.g. policy.allowed"/>
        </label>
        <label>
            From
            <input type="date" @bind="_from"/>
        </label>
        <label>
            To
            <input type="date" @bind="_to"/>
        </label>
        <button class="btn btn-secondary" @onclick="ApplyAsync">Apply</button>
    </div>

    @if (_entries.Count == 0)
    {
        <EmptyState Title="No audit entries"
                    Description="Nothing matches the current filter."/>
    }
    else
    {
        <div class="card">
            <table class="data-table">
                <thead>
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Subject</th>
                    <th>Outcome</th>
                    <th>Details</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in _entries.Take(_visible))
                {
                    <tr>
                        <td class="cell-mono">@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="cell-truncate" title="@entry.Actor">@ActorName(entry.Actor)</span></td>
                        <td class="cell-strong">@entry.Action</td>
                        <td><span class="cell-mono cell-truncate" title="@entry.Subject">@entry.Subject</span></td>
                        <td>@entry.Outcome</td>
                        <td><span class="cell-mono cell-truncate" title="@entry.DetailJson">@entry.DetailJson</span></td>
                    </tr>
                }
                </tbody>
            </table>
            @if (_entries.Count > _visible)
            {
                <div class="card-body table-more">
                    <button class="btn btn-secondary" @onclick="() => _visible += PageSize">
                        Show more (@_visible of @_entries.Count)
                    </button>
                </div>
            }
        </div>
    }
}

@code {

    private const int MaxRows = 2000;
    private const int PageSize = 100;

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    private bool _loaded;
    private bool _allowed;
    private string _denyReason = "";
    private string _filter = "";
    private DateTime? _from;
    private DateTime? _to;
    private int _visible = PageSize;
    private IReadOnlyList<AuditRecord> _entries = [];
    private Dictionary<Guid, string> _principalNames = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        var principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(principalId.Value, PermissionActions.AuditRead, "audit-log"));
            _allowed = decision.Allowed;
            _denyReason = decision.Reason;
        }
        else
        {
            _denyReason = "no platform principal in session";
        }

        if (_allowed)
            await LoadAsync();
        _loaded = true;
    }

    private Task ApplyAsync()
    {
        _visible = PageSize;
        return LoadAsync();
    }

    /// <summary>GUID actors become the principal's display name; service actors stay as written.</summary>
    private string ActorName(string actor)
        => Guid.TryParse(actor, out var id) && _principalNames.TryGetValue(id, out var name)
            ? name
            : actor;

    private async Task LoadAsync()
    {
        _principalNames = (await Principals.ReadAsync()).ToList()
            .ToDictionary(p => p.Id, p => p.DisplayName);

        var all = await AuditRecords.ReadAsync();
        var query = all.OrderByDescending(a => a.TimestampUtc).AsEnumerable();
        if (_from is { } from)
            query = query.Where(a => a.TimestampUtc >= new DateTimeOffset(from, TimeSpan.Zero));
        if (_to is { } to)
            query = query.Where(a => a.TimestampUtc < new DateTimeOffset(to.AddDays(1), TimeSpan.Zero));
        if (!string.IsNullOrWhiteSpace(_filter))
        {
            var needle = _filter.Trim();
            query = query.Where(a =>
                a.Action.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                a.Actor.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                ActorName(a.Actor).Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                a.Subject.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }

        _entries = query.Take(MaxRows).ToList();
    }

}
