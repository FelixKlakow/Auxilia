@page "/workflows/new"
@page "/workflows/{ConfigurationId:guid}/edit"
@attribute [Authorize]
@using Auxilia.Workflows
@using Auxilia.BackendService.Dashboard.Triggers
@inject WorkflowConfigurationEditorService Editor
@inject ProviderCatalogService Catalog
@inject SlotInstanceService Instances
@inject IPolicyEngine PolicyEngine
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Edit workflow" : "New workflow") — Auxilia</PageTitle>

<div class="page-back"><a href="workflows">← All workflows</a></div>

<PageHeader Title="@(IsEdit ? $"Edit \"{_draft.DisplayName}\"" : "New workflow configuration")"
            Subtitle="Three steps: pick a workflow, fill its capability slots with providers, and wire a trigger. No JSON required."/>

@if (!_loaded)
{
    <p class="muted">Loading…</p>
}
else if (!_allowed)
{
    <div class="panel denied">Access denied: @_denyReason</div>
}
else if (_notFound)
{
    <div class="panel denied">Workflow configuration not found.</div>
}
else
{
    @if (_errors.Count > 0)
    {
        <div class="panel denied">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </div>
    }

    <section class="card">
        <div class="card-header">
            <h2><span class="step-number">1</span> Basics</h2>
            <p class="card-subtitle">What is this configuration called and which workflow does it run?</p>
        </div>
        <div class="card-body form-grid">
            <label>
                Display name
                <input @bind="_draft.DisplayName" placeholder="e.g. Code review for team mailbox"/>
                <span class="field-hint">Shown on the workflows page and in run history.</span>
            </label>
            <label>
                Workflow
                <select id="workflow-select" @bind="SelectedWorkflowType">
                    <option value="">Pick a workflow…</option>
                    @foreach (var workflow in _registered.Where(w => w.Enabled || w.WorkflowType == _draft.WorkflowType))
                    {
                        <option value="@workflow.WorkflowType">
                            @workflow.DisplayName (@workflow.WorkflowType)@(workflow.Version.Length > 0 ? $" · v{workflow.Version}" : "")@(workflow.Enabled ? "" : " · disabled by admin")
                        </option>
                    }
                    @if (UnregisteredLegacySelection)
                    {
                        <option value="@_draft.WorkflowType">@_draft.WorkflowType (not in registry)</option>
                    }
                </select>
                <span class="field-hint">
                    Only signed workflow packages registered on this platform are offered — the
                    platform knows where each package lives.
                </span>
            </label>
            @if (_registered.Count == 0 && !UnregisteredLegacySelection)
            {
                <p class="muted">
                    No workflows are registered yet. A workflow appears here when its package is
                    registered at deployment or after its first run.
                </p>
            }
            @if (UnregisteredLegacySelection)
            {
                <p class="field-hint">
                    This configuration references <span class="cell-strong">@_draft.WorkflowType</span>
                    (<span class="cell-mono">@_draft.PackageUri</span>), which is not in the workflow
                    registry — it keeps working; pick a registered workflow to change it.
                </p>
            }
            <label class="check-label">
                <input type="checkbox" @bind="_draft.Enabled"/> Enabled
                <span class="field-hint">
                    When disabled, every dispatch of this configuration is rejected — its triggers
                    pause and manual runs fail pre-flight.
                </span>
            </label>
        </div>
    </section>

    @if (!WorkflowChosen)
    {
        <section class="card">
            <div class="card-body">
                <p class="muted view-empty">
                    Pick a workflow above first — its capability slots and the triggers it
                    supports appear here.
                </p>
            </div>
        </section>
    }
    else
    {
    <section class="card">
        <div class="card-header">
            <h2><span class="step-number">2</span> Slots &amp; providers</h2>
            <p class="card-subtitle">
                @(SelectedWorkflow?.SchemaKnown == true
                    ? "These are the capability slots the workflow declares. Every required slot needs a provider."
                    : "Each capability slot of the workflow is filled by one provider.")
            </p>
        </div>
        <div class="card-body">
            @if (SelectedWorkflow is { SchemaKnown: true } selected)
            {
                @foreach (var slot in selected.Slots)
                {
                    var binding = BindingOf(slot.SlotName);
                    <div class="slot-binding">
                        <div class="slot-binding-header">
                            <div>
                                <span class="cell-strong">@slot.SlotName</span>
                                <span class="type-chip">@(slot.Optional ? "optional" : "required")</span>
                                @if (slot.Description is { Length: > 0 })
                                {
                                    <p class="muted slot-description">@slot.Description</p>
                                }
                            </div>
                            @if (slot.Optional)
                            {
                                @if (binding is null)
                                {
                                    <button class="btn btn-secondary btn-sm" @onclick="() => BindSlot(slot.SlotName)">
                                        Bind this slot
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-danger btn-sm" @onclick="() => _draft.Bindings.Remove(binding)">
                                        Leave unbound
                                    </button>
                                }
                            }
                        </div>

                        @if (binding is null)
                        {
                            <p class="muted">Not bound — the workflow runs without this capability.</p>
                        }
                        else
                        {
                            @RenderBindingChoice(binding, slot)
                        }
                    </div>
                }
                @if (LeftoverBindings(selected).Any())
                {
                    <div class="slot-binding">
                        <p class="field-hint">
                            Bindings not declared by this workflow's schema (kept for compatibility):
                        </p>
                        @foreach (var binding in LeftoverBindings(selected))
                        {
                            <div class="slot-binding-header">
                                <span class="cell-strong">@binding.SlotName</span>
                                <button class="btn btn-danger btn-sm" @onclick="() => _draft.Bindings.Remove(binding)">
                                    Remove
                                </button>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                @if (SelectedWorkflowType.Length > 0)
                {
                    <p class="field-hint">
                        The platform has not seen this workflow's schema yet — slot names are
                        free-form until its first run announces them.
                    </p>
                }
                @if (_draft.Bindings.Count == 0)
                {
                    <p class="muted">No slots bound yet — add one below.</p>
                }
                @foreach (var binding in _draft.Bindings)
                {
                    <div class="slot-binding">
                        <div class="slot-binding-header">
                            <label class="slot-name-label">
                                Slot
                                <input class="input-inline slot-name-input" @bind="binding.SlotName"
                                       list="known-slot-names" placeholder="e.g. work-items"/>
                            </label>
                            <button class="btn btn-danger btn-sm" @onclick="() => _draft.Bindings.Remove(binding)">
                                Remove slot
                            </button>
                        </div>
                        @RenderProviderChoice(binding, AllAvailableProviders)
                    </div>
                }

                <datalist id="known-slot-names">
                    @foreach (var slot in KnownSlotNames)
                    {
                        <option value="@slot"></option>
                    }
                </datalist>

                <div class="button-row slot-add-row">
                    @foreach (var suggestion in SuggestedSlots)
                    {
                        <button class="btn btn-secondary btn-sm" @onclick="() => AddSlot(suggestion)">
                            + Add slot "@suggestion"
                        </button>
                    }
                    <button class="btn btn-secondary btn-sm" @onclick='() => AddSlot("")'>+ Add another slot</button>
                </div>
            }
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h2><span class="step-number">3</span> Triggers</h2>
            <p class="card-subtitle">How this workflow's runs start. Only trigger kinds the workflow itself supports can be wired.</p>
        </div>
        <div class="card-body">
            @if (SupportsManual)
            {
                <div class="slot-binding manual-trigger">
                    <div class="slot-binding-header">
                        <div>
                            <span class="cell-strong">Manual</span>
                            <span class="type-chip">always available</span>
                        </div>
                    </div>
                    <p class="muted">
                        @(DeclaredDescriptionOf(TriggerDeclaration.Manual)
                          ?? "Run it any time from the workflows page or the dashboard — every manual run asks for an instruction.")
                    </p>
                </div>
            }
            @if (_draft.Triggers.Count == 0 && !SupportsManual)
            {
                <p class="muted">No triggers — runs start via rerun only.</p>
            }
            @foreach (var trigger in _draft.Triggers)
            {
                var descriptor = Editor.TriggerKinds.Find(trigger.Kind);
                <div class="slot-binding">
                    <div class="slot-binding-header">
                        <span class="cell-strong">@(descriptor?.Label ?? trigger.Kind)</span>
                        <button class="btn btn-danger btn-sm" @onclick="() => _draft.Triggers.Remove(trigger)">
                            Remove trigger
                        </button>
                    </div>
                    @if (descriptor is not null)
                    {
                        <div class="form-grid setting-grid">
                            @foreach (var setting in descriptor.Settings)
                            {
                                <label>
                                    @setting.Label@(setting.Required ? " *" : "")
                                    @switch (setting.Kind)
                                    {
                                        case SettingKind.Number:
                                            <input type="number" @bind="trigger.Settings[setting.Key]"/>
                                            break;
                                        case SettingKind.Boolean:
                                            <select @bind="trigger.Settings[setting.Key]">
                                                <option value="">(default)</option>
                                                <option value="true">Yes</option>
                                                <option value="false">No</option>
                                            </select>
                                            break;
                                        case SettingKind.Choice:
                                            <select @bind="trigger.Settings[setting.Key]">
                                                <option value="">(choose)</option>
                                                @foreach (var choice in setting.Choices ?? [])
                                                {
                                                    <option value="@choice">@choice</option>
                                                }
                                            </select>
                                            break;
                                        case SettingKind.SlotInstance:
                                            <select @bind="trigger.Settings[setting.Key]">
                                                <option value="">Pick a slot instance…</option>
                                                @foreach (var instance in InstancesOfCategory(setting.InstanceCategory))
                                                {
                                                    <option value="@instance.Id">@instance.DisplayName (@instance.ProviderType)</option>
                                                }
                                            </select>
                                            break;
                                        default:
                                            <input @bind="trigger.Settings[setting.Key]"
                                                   list="@(SuggestionsFor(setting.Key) is not null ? $"suggest-{setting.Key}" : null)"/>
                                            break;
                                    }
                                    @if (SettingHint(trigger, setting) is { Length: > 0 } hint)
                                    {
                                        <span class="field-hint">@hint</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                </div>
            }

            @if (OfferedTriggerKinds.Count > 0)
            {
                <div class="button-row slot-add-row">
                    @foreach (var kind in OfferedTriggerKinds)
                    {
                        <button class="btn btn-secondary btn-sm" @onclick="() => AddTrigger(kind)">
                            + @kind.Label
                        </button>
                    }
                </div>
            }
            else if (!SupportsManual && _draft.Triggers.Count == 0)
            {
                <p class="field-hint">This workflow declares no wireable trigger kinds.</p>
            }
            @if (_draft.Triggers.Count > 0)
            {
                <p class="field-hint">Triggered runs are dispatched on your behalf and pass the same policy checks as manual ones.</p>
            }
            @foreach (var (key, suggestions) in SettingSuggestions)
            {
                <datalist id="suggest-@key">
                    @foreach (var suggestion in suggestions)
                    {
                        <option value="@suggestion"></option>
                    }
                </datalist>
            }
        </div>
    </section>
    }

    <div class="button-row editor-actions">
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">
            @(IsEdit ? "Save changes" : "Create workflow")
        </button>
        <a class="btn btn-secondary" href="workflows">Cancel</a>
    </div>
}

@code {

    [Parameter]
    public Guid? ConfigurationId { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    private bool _loaded;
    private bool _allowed;
    private bool _busy;
    private bool _notFound;
    private string _denyReason = "";
    private Guid? _principalId;
    private IReadOnlyList<string> _errors = [];

    private WorkflowConfigurationDraft _draft = new();
    private IReadOnlyList<RegisteredWorkflow> _registered = [];
    private IReadOnlyList<SlotInstanceOverview> _instances = [];
    private KnownWorkflowValues _known = new([], [], new Dictionary<string, IReadOnlyList<string>>());
    private IReadOnlyDictionary<string, IReadOnlyList<ProviderCatalogEntry>> _availableByCategory =
        new Dictionary<string, IReadOnlyList<ProviderCatalogEntry>>();
    private IReadOnlyList<ProviderCatalogEntry> _allProviders = [];
    private IReadOnlyList<string> _knownArtifactTypes = [];

    private bool IsEdit => ConfigurationId is not null;

    private string SelectedWorkflowType
    {
        get => _draft.WorkflowType;
        set => ApplyWorkflowSelection(value);
    }

    private RegisteredWorkflow? SelectedWorkflow
        => _registered.FirstOrDefault(w => w.WorkflowType == _draft.WorkflowType);

    private bool UnregisteredLegacySelection
        => _draft.WorkflowType.Length > 0 && SelectedWorkflow is null;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        _principalId = DashboardAuthEndpoints.PrincipalIdOf(user);
        if (_principalId is not null)
        {
            var decision = await PolicyEngine.EvaluateAsync(
                new PolicyContext(_principalId.Value, PermissionActions.WorkflowConfigurationManage,
                    "workflow-configurations"));
            _allowed = decision.Allowed;
            _denyReason = decision.Reason;
        }
        else
        {
            _denyReason = "no platform principal in session";
        }

        if (_allowed)
        {
            _registered = await Editor.RegisteredWorkflowsAsync();
            _known = await Editor.KnownValuesAsync();
            _knownArtifactTypes = await Editor.KnownArtifactTypesAsync();
            _availableByCategory = await Catalog.ListAvailableByCategoryAsync();
            _allProviders = await Catalog.ListAsync();
            _instances = await Instances.AccessibleAsync(_principalId!.Value);

            if (ConfigurationId is { } id)
            {
                var draft = await Editor.LoadDraftAsync(id);
                if (draft is null)
                    _notFound = true;
                else
                {
                    _draft = draft;
                    EnsureSchemaSlotBindings();
                    foreach (var binding in _draft.Bindings)
                        EnsureSettingKeys(binding);
                    foreach (var trigger in _draft.Triggers)
                        EnsureTriggerSettingKeys(trigger);
                }
            }
        }

        _loaded = true;
    }

    /// <summary>Selecting a workflow resolves its package coordinates and lays out its declared slots.</summary>
    private void ApplyWorkflowSelection(string workflowType)
    {
        _draft.WorkflowType = workflowType;
        if (_registered.FirstOrDefault(w => w.WorkflowType == workflowType) is not { } workflow)
            return;

        _draft.PackageUri = workflow.PackageUri;
        if (workflow.SchemaKnown)
        {
            // Bindings for slots the new workflow doesn't declare would only fail validation.
            var declared = workflow.Slots.Select(s => s.SlotName).ToHashSet(StringComparer.Ordinal);
            _draft.Bindings.RemoveAll(b => !declared.Contains(b.SlotName.Trim()));
        }
        EnsureSchemaSlotBindings();
    }

    /// <summary>Every required schema slot gets a binding row up front; optional ones stay unbound.</summary>
    private void EnsureSchemaSlotBindings()
    {
        if (SelectedWorkflow is not { SchemaKnown: true } workflow)
            return;
        foreach (var slot in workflow.Slots.Where(s => !s.Optional))
        {
            if (BindingOf(slot.SlotName) is null)
                _draft.Bindings.Add(new SlotBindingDraft { SlotName = slot.SlotName });
        }
    }

    private SlotBindingDraft? BindingOf(string slotName)
        => _draft.Bindings.FirstOrDefault(b => b.SlotName.Trim() == slotName);

    private void BindSlot(string slotName)
        => _draft.Bindings.Add(new SlotBindingDraft { SlotName = slotName });

    private IEnumerable<SlotBindingDraft> LeftoverBindings(RegisteredWorkflow workflow)
    {
        var declared = workflow.Slots.Select(s => s.SlotName).ToHashSet(StringComparer.Ordinal);
        return _draft.Bindings.Where(b => !declared.Contains(b.SlotName.Trim())).ToList();
    }

    private IReadOnlyList<ProviderCatalogEntry> AllAvailableProviders
        => _availableByCategory.Values.SelectMany(e => e).ToList();

    /// <summary>
    /// Providers offered for a slot: contract-matching ones when the slot declares a contract
    /// and at least one provider implements it; otherwise all available providers.
    /// </summary>
    private IReadOnlyList<ProviderCatalogEntry> ProvidersFor(RegisteredWorkflowSlot slot)
    {
        var available = AllAvailableProviders;
        if (slot.Contract is not { Length: > 0 } contract)
            return available;
        var matching = available.Where(p => p.Implements(contract)).ToList();
        return matching.Count > 0 ? matching : available;
    }

    /// <summary>Accessible slot instances whose provider declares the slot's contract (all when unconstrained).</summary>
    private IReadOnlyList<SlotInstanceOverview> InstancesFor(RegisteredWorkflowSlot slot)
    {
        if (slot.Contract is not { Length: > 0 } contract)
            return _instances;
        var matching = _instances
            .Where(i => _allProviders.FirstOrDefault(p => p.ProviderType == i.ProviderType)?.Implements(contract) == true)
            .ToList();
        return matching;
    }

    private void SelectInstance(SlotBindingDraft binding, SlotInstanceOverview instance)
    {
        binding.SlotInstanceId = instance.Id;
        binding.ProviderType = "";
        binding.Settings.Clear();
    }

    // ------------------------------------------------------------------ inline instance creation

    /// <summary>Per-slot drafts of the "create a reusable instance right here" form.</summary>
    private readonly Dictionary<string, SlotInstanceDraft> _newInstanceDrafts = new(StringComparer.Ordinal);
    private string? _inlineInstanceError;

    private static void SelectNewInstanceProvider(SlotInstanceDraft draft, ProviderCatalogEntry entry)
    {
        draft.ProviderType = entry.ProviderType;
        foreach (var descriptor in entry.Descriptors)
        {
            if (!draft.Settings.ContainsKey(descriptor.Key))
                draft.Settings[descriptor.Key] = descriptor.Kind == SettingKind.Secret
                    ? ""
                    : descriptor.DefaultValue ?? "";
        }
    }

    private RenderFragment RenderInstanceSettings(SlotInstanceDraft draft) => __builder =>
    {
        var descriptors = _allProviders
            .FirstOrDefault(p => p.ProviderType == draft.ProviderType)?.EnabledDescriptors ?? [];
        @if (descriptors.Count > 0)
        {
            <div class="form-grid setting-grid">
                @foreach (var descriptor in descriptors)
                {
                    <label>
                        @descriptor.Label@(descriptor.Required ? " *" : "")
                        @switch (descriptor.Kind)
                        {
                            case SettingKind.Secret:
                                <ConnectSecretInput Descriptor="descriptor" Settings="draft.Settings"/>
                                break;
                            case SettingKind.Number:
                                <input type="number" @bind="draft.Settings[descriptor.Key]"/>
                                break;
                            case SettingKind.Boolean:
                                <select @bind="draft.Settings[descriptor.Key]">
                                    <option value="">(default)</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                                break;
                            case SettingKind.Choice:
                                <select @bind="draft.Settings[descriptor.Key]">
                                    <option value="">(choose)</option>
                                    @foreach (var choice in descriptor.Choices ?? [])
                                    {
                                        <option value="@choice">@choice</option>
                                    }
                                </select>
                                break;
                            default:
                                <input @bind="draft.Settings[descriptor.Key]"/>
                                break;
                        }
                        @if (descriptor.HelpText is { Length: > 0 } help)
                        {
                            <span class="field-hint">@help</span>
                        }
                    </label>
                }
            </div>
        }
    };

    /// <summary>Saves the draft as a reusable instance and binds it to the slot — no page hop.</summary>
    private async Task CreateAndBindInstanceAsync(SlotBindingDraft binding, RegisteredWorkflowSlot slot)
    {
        if (!_newInstanceDrafts.TryGetValue(slot.SlotName, out var draft))
            return;
        _inlineInstanceError = null;
        _busy = true;
        try
        {
            var name = await Instances.SaveAsync(_principalId!.Value.ToString("D"), _principalId, draft);
            // The Steering Instance applies the bus-published upsert asynchronously.
            await Task.Delay(500);
            _instances = await Instances.AccessibleAsync(_principalId!.Value);
            if (_instances.FirstOrDefault(i => i.Name == name) is { } created)
            {
                SelectInstance(binding, created);
                _newInstanceDrafts.Remove(slot.SlotName);
            }
            else
            {
                _inlineInstanceError =
                    "The instance was published but is not visible yet — pick it from the list in a moment.";
            }
        }
        catch (Exception ex)
        {
            _inlineInstanceError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// A slot is filled either with a reusable slot instance (default) or with inline provider
    /// settings (advanced) — picking one clears the other.
    /// </summary>
    private RenderFragment RenderBindingChoice(
        SlotBindingDraft binding, RegisteredWorkflowSlot slot) => __builder =>
    {
        var instances = InstancesFor(slot);
        @if (instances.Count > 0)
        {
            <div class="provider-grid">
                @foreach (var instance in instances)
                {
                    <label class="provider-card @(binding.SlotInstanceId == instance.Id ? "selected" : null)">
                        <input type="radio" name="binding-@_draft.Bindings.IndexOf(binding)"
                               checked="@(binding.SlotInstanceId == instance.Id)"
                               @onchange="() => SelectInstance(binding, instance)"/>
                        <span class="provider-name">@instance.DisplayName</span>
                        <span class="provider-category">
                            @instance.ProviderType · @(instance.Scope == "Company" ? "company" : "personal")
                        </span>
                    </label>
                }
            </div>
        }
        else
        {
            <p class="muted">
                No slot instance matches this slot yet — create one right here.
            </p>
        }

        @if (_newInstanceDrafts.TryGetValue(slot.SlotName, out var newInstance))
        {
            <div class="inline-instance-form">
                <h4 class="table-caption">New reusable instance</h4>
                @{ var creatable = ProvidersFor(slot); }
                <div class="provider-grid">
                    @foreach (var entry in creatable)
                    {
                        <label class="provider-card @(newInstance.ProviderType == entry.ProviderType ? "selected" : null)">
                            <input type="radio" name="new-instance-@slot.SlotName"
                                   checked="@(newInstance.ProviderType == entry.ProviderType)"
                                   @onchange="() => SelectNewInstanceProvider(newInstance, entry)"/>
                            <span class="provider-name">@entry.ProviderType</span>
                            <span class="provider-category">@(entry.Category.Length == 0 ? "uncategorized" : entry.Category)</span>
                            @if (entry.Description is { Length: > 0 })
                            {
                                <span class="provider-description">@entry.Description</span>
                            }
                        </label>
                    }
                </div>

                @if (newInstance.ProviderType.Length > 0)
                {
                    <div class="form-grid setting-grid">
                        <label>
                            Display name
                            <input @bind="newInstance.DisplayName" placeholder="e.g. Team mailbox"/>
                            <span class="field-hint">Saved as a reusable instance — bindable from any workflow.</span>
                        </label>
                        <label>
                            Scope
                            <select @bind="newInstance.Scope">
                                <option value="Company">Company — anyone configuring workflows may bind it</option>
                                <option value="Personal">Personal — only you</option>
                            </select>
                        </label>
                    </div>
                    @RenderInstanceSettings(newInstance)
                }

                @if (_inlineInstanceError is not null)
                {
                    <div class="panel denied">@_inlineInstanceError</div>
                }
                <div class="button-row">
                    <button class="btn btn-primary btn-sm" disabled="@_busy"
                            @onclick="() => CreateAndBindInstanceAsync(binding, slot)">Create &amp; bind</button>
                    <button class="btn btn-secondary btn-sm" disabled="@_busy"
                            @onclick="() => _newInstanceDrafts.Remove(slot.SlotName)">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <div class="button-row">
                <button class="btn btn-secondary btn-sm"
                        @onclick="() => _newInstanceDrafts[slot.SlotName] = new SlotInstanceDraft()">
                    + New reusable instance
                </button>
            </div>
        }

        @* Legacy inline-configured bindings stay editable, but the inline path is no longer
           offered for new bindings — instances are the one way to configure a slot. *@
        @if (binding.SlotInstanceId is null && binding.ProviderType.Length > 0)
        {
            <details class="advanced-section" open>
                <summary>Configured inline (legacy)</summary>
                <div class="advanced-body">
                    <p class="field-hint">
                        This binding carries its own settings. Prefer creating a slot instance —
                        it is reusable and editable outside the workflow.
                    </p>
                    @RenderProviderChoice(binding, ProvidersFor(slot))
                </div>
            </details>
        }
    };

    private RenderFragment RenderProviderChoice(
        SlotBindingDraft binding, IReadOnlyList<ProviderCatalogEntry> providers) => __builder =>
    {
        @if (providers.Count == 0)
        {
            <p class="muted">No providers are available yet — an administrator curates them in the provider catalog.</p>
        }
        else
        {
            <div class="provider-grid">
                @foreach (var entry in providers)
                {
                    <label class="provider-card @(binding.ProviderType == entry.ProviderType ? "selected" : null)">
                        <input type="radio" name="provider-@_draft.Bindings.IndexOf(binding)"
                               checked="@(binding.ProviderType == entry.ProviderType)"
                               @onchange="() => SelectProvider(binding, entry)"/>
                        <span class="provider-name">@entry.ProviderType</span>
                        <span class="provider-category">@(entry.Category.Length == 0 ? "uncategorized" : entry.Category)</span>
                        @if (entry.Description is { Length: > 0 })
                        {
                            <span class="provider-description">@entry.Description</span>
                        }
                    </label>
                }
            </div>
        }
        @if (binding.ProviderType.Length > 0 && !IsAvailable(binding.ProviderType))
        {
            <p class="field-hint">
                Currently bound to <span class="cell-strong">@binding.ProviderType</span>, which an
                administrator has hidden from the catalog — it keeps working, but to change it pick
                one of the providers above.
            </p>
        }

        @if (binding.ProviderType.Length > 0 && DescriptorsOf(binding.ProviderType) is { Count: > 0 } descriptors)
        {
            <div class="form-grid setting-grid">
                @foreach (var descriptor in descriptors)
                {
                    <label>
                        @descriptor.Label@(descriptor.Required ? " *" : "")
                        @switch (descriptor.Kind)
                        {
                            case SettingKind.Secret:
                                <ConnectSecretInput Descriptor="descriptor" Settings="binding.Settings"
                                                    StoredSet="binding.StoredSecretKeys.Contains(descriptor.Key)"/>
                                break;
                            case SettingKind.Number:
                                <input type="number" @bind="binding.Settings[descriptor.Key]"/>
                                break;
                            case SettingKind.Boolean:
                                <select @bind="binding.Settings[descriptor.Key]">
                                    <option value="">(default)</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                                break;
                            case SettingKind.Choice:
                                <select @bind="binding.Settings[descriptor.Key]">
                                    <option value="">(choose)</option>
                                    @foreach (var choice in descriptor.Choices ?? [])
                                    {
                                        <option value="@choice">@choice</option>
                                    }
                                </select>
                                break;
                            default:
                                <input @bind="binding.Settings[descriptor.Key]"/>
                                break;
                        }
                        @if (descriptor.HelpText is { Length: > 0 } help)
                        {
                            <span class="field-hint">@help</span>
                        }
                    </label>
                }
            </div>
        }
    };

    private IReadOnlyList<string> KnownSlotNames
        => _known.SlotNamesByWorkflowType.GetValueOrDefault(_draft.WorkflowType.Trim()) ?? [];

    private IEnumerable<string> SuggestedSlots
        => KnownSlotNames.Where(slot => _draft.Bindings.All(b => b.SlotName.Trim() != slot));

    private void AddSlot(string slotName)
        => _draft.Bindings.Add(new SlotBindingDraft { SlotName = slotName });

    // ------------------------------------------------------------------ triggers

    private bool WorkflowChosen => _draft.WorkflowType.Trim().Length > 0;

    /// <summary>The trigger kinds the selected workflow declares; empty = undeclared (legacy schema).</summary>
    private IReadOnlyList<TriggerDeclaration> DeclaredTriggers
        => SelectedWorkflow?.DeclaredTriggers ?? [];

    /// <summary>Manual runs are offered unless the workflow declares triggers and leaves manual out.</summary>
    private bool SupportsManual
        => DeclaredTriggers.Count == 0
           || DeclaredTriggers.Any(t => t.Kind == TriggerDeclaration.Manual);

    private string? DeclaredDescriptionOf(string kind)
        => DeclaredTriggers.FirstOrDefault(t => t.Kind == kind)?.Description;

    /// <summary>
    /// Wireable kinds from the runtime catalog, restricted to what the workflow declares —
    /// a workflow can only be triggered in ways it supports.
    /// </summary>
    private IReadOnlyList<TriggerKindDescriptor> OfferedTriggerKinds
        => Editor.TriggerKinds.All
            .Where(d => d.Wireable)
            .Where(d => DeclaredTriggers.Count == 0
                        || DeclaredTriggers.Any(t => t.Kind == d.Kind))
            .ToList();

    private void AddTrigger(TriggerKindDescriptor descriptor)
    {
        var trigger = new TriggerDraft { Kind = descriptor.Kind };
        foreach (var setting in descriptor.Settings)
            trigger.Settings[setting.Key] = setting.DefaultValue ?? "";
        _draft.Triggers.Add(trigger);
    }

    /// <summary>Every descriptor key needs a dictionary entry for @bind; defaults pre-fill missing ones.</summary>
    private void EnsureTriggerSettingKeys(TriggerDraft trigger)
    {
        foreach (var setting in Editor.TriggerKinds.Find(trigger.Kind)?.Settings ?? [])
        {
            if (!trigger.Settings.ContainsKey(setting.Key))
                trigger.Settings[setting.Key] = setting.DefaultValue ?? "";
        }
    }

    /// <summary>Accessible slot instances whose provider sits in the given catalog category.</summary>
    private IReadOnlyList<SlotInstanceOverview> InstancesOfCategory(string? category)
        => category is not { Length: > 0 }
            ? _instances
            : _instances
                .Where(i => _allProviders.FirstOrDefault(p => p.ProviderType == i.ProviderType)?.Category == category)
                .ToList();

    /// <summary>Free-text suggestions per trigger-setting key (rendered as datalists).</summary>
    private IReadOnlyDictionary<string, IReadOnlyList<string>> SettingSuggestions
        => _knownArtifactTypes.Count == 0
            ? new Dictionary<string, IReadOnlyList<string>>()
            : new Dictionary<string, IReadOnlyList<string>> { ["ArtifactType"] = _knownArtifactTypes };

    private IReadOnlyList<string>? SuggestionsFor(string key)
        => SettingSuggestions.GetValueOrDefault(key);

    /// <summary>The descriptor's help text, plus a live "= every X" hint for second intervals.</summary>
    private static string? SettingHint(TriggerDraft trigger, SettingDescriptor setting)
    {
        if (setting.Kind == SettingKind.Number && setting.Key.EndsWith("Seconds", StringComparison.Ordinal)
            && int.TryParse(trigger.Settings.GetValueOrDefault(setting.Key), out var seconds) && seconds > 0)
        {
            var interval = $"= every {TimeText.Interval(seconds)}";
            return setting.HelpText is { Length: > 0 } help ? $"{help} {interval}" : interval;
        }
        return setting.HelpText;
    }

    private bool IsAvailable(string providerType)
        => _availableByCategory.Values.Any(entries => entries.Any(e => e.ProviderType == providerType));

    private IReadOnlyList<SettingDescriptor> DescriptorsOf(string providerType)
        => _allProviders.FirstOrDefault(e => e.ProviderType == providerType)?.EnabledDescriptors ?? [];

    private void SelectProvider(SlotBindingDraft binding, ProviderCatalogEntry entry)
    {
        binding.SlotInstanceId = null; // inline configuration replaces an instance reference
        binding.ProviderType = entry.ProviderType;
        EnsureSettingKeys(binding);
    }

    /// <summary>Every descriptor key needs a dictionary entry for @bind; defaults pre-fill empty fields.</summary>
    private void EnsureSettingKeys(SlotBindingDraft binding)
    {
        foreach (var descriptor in DescriptorsOf(binding.ProviderType))
        {
            if (!binding.Settings.ContainsKey(descriptor.Key))
                binding.Settings[descriptor.Key] = descriptor.Kind == SettingKind.Secret
                    ? ""
                    : descriptor.DefaultValue ?? "";
        }
    }

    private async Task SaveAsync()
    {
        _errors = [];
        _busy = true;
        try
        {
            await Editor.SaveAsync(_principalId!.Value.ToString("D"), _principalId, _draft);
            Navigation.NavigateTo("workflows?saved=true");
        }
        catch (ArgumentException ex)
        {
            _errors = ex.Message.Split('\n');
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        finally
        {
            _busy = false;
        }
    }

}
