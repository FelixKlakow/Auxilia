<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Label="Packaging">
        <PackageId>Auxilia.Core.Contracts</PackageId>
        <Version>0.1.0</Version>
        <Authors>Felix Klakow</Authors>
        <Description>Wire contracts (DTOs) of the Auxilia Core API — runs, configurations, connectors, artifacts, workflow types, identity, audit. Shared by the server and every client so the contract cannot drift.</Description>
        <RepositoryUrl>https://github.com/FelixKlakow/Auxilia</RepositoryUrl>
        <PackageProjectUrl>https://github.com/FelixKlakow/Auxilia</PackageProjectUrl>
        <!-- BUSL-1.1 is not an OSI-approved SPDX expression, so the license ships as a file. -->
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageTags>auxilia;workflow;contracts</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>

</Project>
