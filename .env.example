# Copy to .env (never committed) and fill in the three required values.

# --- Required ---------------------------------------------------------------------------------
# The broker password (the account is the runner's administrator on RabbitMQ).
AUXILIA_BROKER_PASSWORD=
# 32 random bytes, base64 (openssl rand -base64 32) — protects every secret the Core stores.
AUXILIA_PROTECTION_KEY=
# An administrator API key for the first steps (Setup-Platform.ps1, creating principals).
AUXILIA_BOOTSTRAP_API_KEY=

# --- Images -----------------------------------------------------------------------------------
# A published release (docker compose pull) — or any tag for images built from this tree
# (docker compose build).
AUXILIA_VERSION=dev
# AUXILIA_REGISTRY=ghcr.io/felixklakow

# --- Optional ---------------------------------------------------------------------------------
# A separate key for the runner's own store (defaults to AUXILIA_PROTECTION_KEY).
# AUXILIA_RUNNER_PROTECTION_KEY=
# A human administrator for password sign-in (POST /auth/login).
# AUXILIA_ADMIN_USERNAME=
# AUXILIA_ADMIN_PASSWORD=
# Where the Core listens on the host (loopback by default).
# AUXILIA_CORE_BIND=127.0.0.1
# AUXILIA_CORE_PORT=8080
# AUXILIA_BROKER_USER=auxilia
# The network every run's egress gateway joins, and the run-roots volume. Change both to run a
# second stack on the same host.
# AUXILIA_NETWORK=auxilia
# AUXILIA_RUN_ROOTS_VOLUME=auxilia-run-roots
# Only if the daemon keeps its volumes elsewhere (custom data-root, rootless Docker): the
# run-roots volume's path on the daemon.
# AUXILIA_RUN_ROOT=/var/lib/docker/volumes/auxilia-run-roots/_data
# AUXILIA_DOCKER_SOCKET=/var/run/docker.sock
