<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Auxilia.Slots.CodingSession.slothandler</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="*.slothandler.manifest.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
  </ItemGroup>

  <!-- References limited to assemblies baked into the coding-session workflow image, so the
       shipped .slothandler.dll's types all resolve when the plugin loader scans it. -->
  <ItemGroup>
    <ProjectReference Include="..\Auxilia.Workflows\Auxilia.Workflows.csproj" />
    <ProjectReference Include="..\Source\Auxilia.Workflows.SourceControl\Auxilia.Workflows.SourceControl.csproj" />
    <ProjectReference Include="..\Source\Auxilia.Workflows.TaskSource\Auxilia.Workflows.TaskSource.csproj" />
  </ItemGroup>

</Project>
